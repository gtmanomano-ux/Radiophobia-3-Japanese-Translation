                                       ]
                    },
                    {
                        "key":  "PMA_escape_script_text:PMA_escape_5#1",
                        "source_table":  "PMA_escape_script_text",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\PMA_escape_script_text.xml",
                        "source_xml_line":  18,
                        "string_id":  "PMA_escape_5",
                        "occurrence":  1,
                        "EN":  "Good for you, Marked One! Keep on like that and you gonna make plenty of new friends. Drop at my place, there\u0027s some business to talk over.",
                        "JA_current":  "Good for you, Marked One! Keep on like that and you gonna make plenty of new friends. Drop at my place, there\u0027s some business to talk over.",
                        "JA_new":  "よくやった、マークドワン！その調子なら、新しい仲間がどんどんできるぞ。寄っていけ、話がある。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
