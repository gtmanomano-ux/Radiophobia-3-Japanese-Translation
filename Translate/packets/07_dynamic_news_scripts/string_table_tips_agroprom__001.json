    {
      "key": "string_table_tips_agroprom:ghost_tips#1",
      "source_table": "string_table_tips_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_tips_agroprom.xml",
      "source_xml_line": null,
      "string_id": "ghost_tips",
      "occurrence": 1,
      "EN": "Strelok, I have sad news. Fang died. Too bad you went to the center on your own. It was your choice though. I know where to search for you, and whom to ask. Ghost.",
      "JA_current": "ストレロク、悲しい知らせだ。ファングが死んだ。お前が一人で中心部へ向かったのは残念だが、自分で決めたことだな。お前をどこで探し、誰に聞けばいいかは分かっている。ゴースト。",
      "JA_new": "ストレロク、悲しい知らせだ。ファングが死んだ。お前が一人で中心部へ向かったのは残念だが、自分で決めたことだな。お前をどこで探し、誰に聞けばいいかは分かっている。ゴースト。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
