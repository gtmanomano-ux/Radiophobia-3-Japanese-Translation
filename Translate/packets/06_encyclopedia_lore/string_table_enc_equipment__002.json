                                       ]
                    },
                    {
                        "key":  "string_table_enc_equipment:zapiska_m1_l#1",
                        "source_table":  "string_table_enc_equipment",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_enc_equipment.xml",
                        "source_xml_line":  505,
                        "string_id":  "zapiska_m1_l",
                        "occurrence":  1,
                        "EN":  "A sloppily-written note which reads:\\n\n\t\t\"Alright, I agree to establish a truce... Anything for a deal like THAT. We must take care of this marked bastard.\\n\n\t\tP.S. C\u0027mon, dude, it\u0027s the 21st century! Cut it out with these crappy paper notes!\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\n\t\t",
                        "JA_current":  "A sloppily-written note which reads:\\n\n\t\t\"Alright, I agree to establish a truce... Anything for a deal like THAT. We must take care of this marked bastard.\\n\n\t\tP.S. C\u0027mon, dude, it\u0027s the 21st century! Cut it out with these crappy paper notes!\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\n\t\t",
                        "JA_new":  "走り書きのメモ：\\n\n\t\t「よし、休戦を結ぶことに同意する……あんな取引を持ちかけられたら断れない。あの印付きの野郎は始末しなきゃならん。\\n\n\t\t追伸：おい、今は21世紀だぞ！こんなひどい紙のメモを書くのはもうやめてくれ！」\\n \\n\n\t\t%c[0,255,255,255]諸元：\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]クエストアイテム\\n \\n\n\t\t",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [

                                       ]
                    },
                    {
                        "key":  "string_table_enc_equipment:zapiska_m2_l#1",
                        "source_table":  "string_table_enc_equipment",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_enc_equipment.xml",
                        "source_xml_line":  513,
                        "string_id":  "zapiska_m2_l",
                        "occurrence":  1,
                        "EN":  "Someone has written:\\n\n\t\t\"Glad you\u0027ve decided to see reason on the matter. Let your guys muddle our \"friend\u0027s\" brain when they get the chance. They\u0027re great tricksters.\\n\n\t\tP.S. Do not underestimate the advantages of hard-copies. Too much digital intrusion nowadays. - V\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\n\t\t",
                        "JA_current":  "Someone has written:\\n\n\t\t\"Glad you\u0027ve decided to see reason on the matter. Let your guys muddle our \"friend\u0027s\" brain when they get the chance. They\u0027re great tricksters.\\n\n\t\tP.S. Do not underestimate the advantages of hard-copies. Too much digital intrusion nowadays. - V\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\n\t\t",
                        "JA_new":  "誰かがこう書き残している：\\n\n\t\t「話が分かってくれて何よりだ。機会があれば、お前の連中にこっちの『友人』の頭を混乱させてもらおう。あいつらは人を惑わすのがうまい。\\n\n\t\t追伸：紙の記録の利点を侮るな。今はデジタルに踏み込まれすぎる。―V」\\n \\n\n\t\t%c[0,255,255,255]諸元：\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]クエストアイテム\\n \\n\n\t\t",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [

                                       ]
                    },
