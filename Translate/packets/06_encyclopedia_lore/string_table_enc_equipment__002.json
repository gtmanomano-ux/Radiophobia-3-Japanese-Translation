                        "string_id":  "zapiska_l",
                        "occurrence":  1,
                        "EN":  "A scrap of paper with a note which reads:\\n\n\t\t\"Next time he enters the Arena, arrange for him to bite the dust. - V\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\t\t\n\t\t",
                        "JA_current":  "A scrap of paper with a note which reads:\\n\n\t\t\"Next time he enters the Arena, arrange for him to bite the dust. - V\"\\n \\n\n\t\t%c[0,255,255,255]PROPERTIES:\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]Quest Item\\n \\n\t\t\n\t\t",
                        "JA_new":  "メモの書かれた紙切れ：\\n\n\t\t「次にあいつがアリーナに出る時は、必ず始末しろ。―V」\\n \\n\n\t\t%c[0,255,255,255]諸元：\\n\n\t\t%c[0,255,255,255] • %c[0,255,140,0]クエストアイテム\\n \\n\t\t\n\t\t",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
