    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher1_111#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 156,
      "string_id": "agr_stalker_talk_about_ratcatcher1_111",
      "occurrence": 1,
      "EN": "We have a local hero around here called Ratcatcher. He lives in the marshes. The man bred so many rats in the collectors that no doubt they'll soon straight up eat those army bastards.",
      "JA_current": "この辺の腕っこきで「Ratcatcher」って奴がいるんだ。奴は沼地に住んでいる。そいつはそのうち軍隊のクソどもを食わせるために Collectors の中で沢山のネズミを飼ってるんだ。",
      "JA_new": "この辺には、ラットキャッチャーと呼ばれる地元の英雄がいる。沼地に住んでて、下水道でネズミを繁殖させてるんだ。そのうち軍のクソ野郎どもも、ネズミに食われちまうかもな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher1",
          "phrase_id": "111",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher1_121#1",
