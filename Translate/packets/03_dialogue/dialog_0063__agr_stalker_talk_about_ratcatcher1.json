      "source_xml_line": 168,
      "string_id": "agr_stalker_talk_about_ratcatcher1_111211",
      "occurrence": 1,
      "EN": "Great. See you and take care of yourself.",
      "JA_current": "スゲェな。アンタも気を付けろよ。じゃあな。",
      "JA_new": "よし、じゃあな。気をつけろよ。",
