    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher1_11121#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 165,
      "string_id": "agr_stalker_talk_about_ratcatcher1_11121",
      "occurrence": 1,
      "EN": "Collectors are your standard shit-stinking sewers that take waste from the Institute and dump it in the nearest water reservoir. ",
      "JA_current": "Collectors ってのはお馴染みの糞の臭いが立ち込めた下水のことさ。研究所の廃棄物を、近くの貯水池へ流し込むんだ。",
      "JA_new": "研究所の排水を集めて、いちばん近い貯水池に流す、どこにでもある臭い下水道さ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher1",
          "phrase_id": "11121",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
