      "source_xml_line": 162,
      "string_id": "agr_stalker_talk_about_ratcatcher1_1112",
      "occurrence": 1,
      "EN": "Tell me more about the collectors.",
      "JA_current": "その Collectors について、もっと教えてくれ。",
      "JA_new": "下水道について、もっと聞かせてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher1",
