    {
      "key": "stable_dialogs_military:mil_cook_common4_403#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 203,
      "string_id": "mil_cook_common4_403",
      "occurrence": 1,
      "EN": "Eh?",
      "JA_current": "あぁ？",
      "JA_new": "えっ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
