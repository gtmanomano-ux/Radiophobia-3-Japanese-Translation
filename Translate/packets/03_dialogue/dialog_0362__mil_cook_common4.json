      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_404#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 206,
      "string_id": "mil_cook_common4_404",
      "occurrence": 1,
      "EN": "A village.",
      "JA_current": "村だ。",
      "JA_new": "村だよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "404",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_405#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 209,
      "string_id": "mil_cook_common4_405",
      "occurrence": 1,
      "EN": "Ahh... There is something. Some food there... condensed milk for one...",
      "JA_current": "あぁ… 何かあるさ。奥に食べ物がいくらかある… 誰かのコンデンスミルク…。",
      "JA_new": "ああ……何かあるな。食べ物もある……コンデンスミルクとか……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "405",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_406#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 212,
      "string_id": "mil_cook_common4_406",
      "occurrence": 1,
      "EN": "How do I get there?",
      "JA_current": "どうやって行けばいい？",
      "JA_new": "どう行けばいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "406",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_407#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 215,
      "string_id": "mil_cook_common4_407",
      "occurrence": 1,
      "EN": "Eh? Wait. Let me think... Nah, look, do you really need all that? Relax... Sit... Let's sit and have a smoke, OK?",
      "JA_current": "ん？ 待て。考えさせろ… だめだ、いいか、本当にそれが必要なのか？ 落ち着けって… 座れよ… 座って一服しようぜ、なあ？",
      "JA_new": "え？待てよ。考えさせて……いや、そこまで必要か？落ち着けよ……座って、一服しようぜ。な？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "407",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_408#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 218,
      "string_id": "mil_cook_common4_408",
      "occurrence": 1,
      "EN": "I need to get to the village.",
      "JA_current": "村に行かなきゃならんのだ。",
      "JA_new": "村に行きたいんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "408",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_409#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 221,
      "string_id": "mil_cook_common4_409",
      "occurrence": 1,
      "EN": "Alright... we just sit here, have a smoke.. Then we go... I'll take you there. No problem.",
      "JA_current": "わかったよ… まぁ座って一服しようぜ。それから行こう。俺がそこへ連れてってやるよ。それで満足だろ？",
      "JA_new": "分かった……ここに座って一服して、それから行こう……連れてってやるよ。問題ない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "409",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_410#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 224,
      "string_id": "mil_cook_common4_410",
      "occurrence": 1,
      "EN": "Don't go to all that trouble. Just tell me how to get there.",
      "JA_current": "足手まといはゴメンだぜ。行き方を教えてくれりゃいい。",
      "JA_new": "そこまでしなくていい。行き方だけ教えてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "410",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common4_411#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 227,
      "string_id": "mil_cook_common4_411",
      "occurrence": 1,
      "EN": "Sure... Hey, you're really challenging me here! We'll go there together in just a sec. First we just sit down, OK, and...",
      "JA_current": "わかったよ… オイ、あんたさっきからマジで挑発的だな。あんたと俺ですぐに着くぜ？ まぁいいから座れよ。",
      "JA_new": "もちろん……おい、ずいぶん急かすな！すぐ一緒に行くからさ。まずは座って、それから……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common4",
          "phrase_id": "411",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    }
