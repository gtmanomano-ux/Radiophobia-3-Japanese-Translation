    },
    {
      "key": "stable_dialogs_bar:shaman_dialog_4_navodka#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3233,
      "string_id": "shaman_dialog_4_navodka",
      "occurrence": 1,
      "EN": "You're a real artifact hunter, it's a pleasure to deal with you! Why don't you go to the Army Warehouses, there's a bus stop right by the road. From there is a path to the abandoned village, the one where a bunch of nasty shit is roaming about so make sure you don't stray too close... Well, next to that path on the way to the village will be a fallen tree, look under it.",
      "JA_current": "You're a real artifact hunter, it's a pleasure to deal with you! Why don't you go to the Army Warehouses, there's a bus stop right by the road. From there is a path to the abandoned village, the one where a bunch of nasty shit is roaming about so make sure you don't stray too close... Well, next to that path on the way to the village will be a fallen tree, look under it.",
      "JA_new": "あんたは本物のアーティファクト・ハンターだな。取引できて嬉しいよ！軍事倉庫へ行ってみな。道沿いにバス停がある。そこから廃村へ続く道があるんだ。たちの悪い何かがうろついてるから、近づきすぎるなよ……村へ向かう道のそばに倒木がある。その下を探せ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron4_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "dialogs_bar_gameplay_text:dialogs_bar_67#1",
      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 204,
      "string_id": "dialogs_bar_67",
      "occurrence": 1,
      "EN": "I could dig through the whole village if I had to.",
      "JA_current": "I could dig through the whole village if I had to.",
      "JA_new": "必要なら村中を掘り返してやるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron4_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
