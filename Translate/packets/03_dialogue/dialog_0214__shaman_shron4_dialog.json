          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "dialogs_bar_gameplay_text:dialogs_bar_64#1",
      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 195,
      "string_id": "dialogs_bar_64",
      "occurrence": 1,
      "EN": "I don't think so. I'm always in the habit of saving the tastiest things for last, so bring me Mamma's Beads.",
      "JA_current": "I don't think so. I'm always in the habit of saving the tastiest things for last, so bring me Mamma's Beads.",
      "JA_new": "まだあるさ。うまい物は最後まで取っておくたちでね。ママズ・ビーズを持ってきな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron4_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
