      "string_id": "dialogs_bar_66",
      "occurrence": 1,
      "EN": "I'll see what I can do.",
      "JA_current": "I'll see what I can do.",
      "JA_new": "何とかしてみるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
