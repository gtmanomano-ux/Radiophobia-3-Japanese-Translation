      "source_xml_line": 192,
      "string_id": "dialogs_bar_63",
      "occurrence": 1,
      "EN": "I guess you've already sold off all your hidden possessions to me, haven't you?",
      "JA_current": "I guess you've already sold off all your hidden possessions to me, haven't you?",
      "JA_new": "隠し物はもう全部あんたに売ったんじゃないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron4_dialog",
