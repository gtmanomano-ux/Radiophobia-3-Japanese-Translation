      "source_xml_line": 198,
      "string_id": "dialogs_bar_65",
      "occurrence": 1,
      "EN": "Here's the Beads for you.",
      "JA_current": "Here's the Beads for you.",
      "JA_new": "ビーズを持ってきた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
