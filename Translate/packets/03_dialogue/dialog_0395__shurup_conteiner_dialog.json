                    {
                        "key":  "stable_dialogs_military:shurup_conteiner_dialog_phrase_3#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2081,
                        "string_id":  "shurup_conteiner_dialog_phrase_3",
                        "occurrence":  1,
                        "EN":  "I found some locked box, and I have no idea how to open it. I need access. Would you be able to crack it open?",
                        "JA_current":  "I found some locked box, and I have no idea how to open it. I need access. Would you be able to crack it open?",
                        "JA_new":  "鍵のかかった箱を見つけたんだが、開け方が分からない。中身を取り出したい。開けられるか？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
