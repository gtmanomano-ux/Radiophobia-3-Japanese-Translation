      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_repair_dialogs.xml",
      "source_xml_line": 37,
      "string_id": "escape_trader_repair_7",
      "occurrence": 1,
      "EN": "Yeah... Marked One, you've been battered indeed...\\nWell... I had some armor plates somewhere here... aha, here they are... Now, it goes this way... Uph... Here it is! Brand new, he-he.",
      "JA_current": "Yeah... Marked One, you've been battered indeed...\\nWell... I had some armor plates somewhere here... aha, here they are... Now, it goes this way... Uph... Here it is! Brand new, he-he.",
      "JA_new": "ああ……マークド・ワン、ずいぶんボロボロだな……\\nそうだ……この辺に装甲板があったはずだ……あったぞ。よし、こうして……ふんっ……ほら、新品同様だ。へへっ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
