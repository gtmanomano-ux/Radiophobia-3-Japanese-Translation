      "string_id": "cit_doctor_escape_dialog_1",
      "occurrence": 1,
      "EN": "Ask away, I'll try to help.",
      "JA_current": "言ってみな。何か答えられるかもしれない。",
      "JA_new": "何でも聞いてくれ。分かる範囲で答える。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
