    },
    {
      "key": "stable_dialogs_deadcity:cit_doctor_escape_dialog_11#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 9,
      "string_id": "cit_doctor_escape_dialog_11",
      "occurrence": 1,
      "EN": "Where are my things?",
      "JA_current": "俺の探し物は何処にある？",
      "JA_new": "俺の荷物はどこだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
