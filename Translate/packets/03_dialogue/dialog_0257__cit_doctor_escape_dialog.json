    },
    {
      "key": "stable_dialogs_deadcity:cit_doctor_escape_dialog_15#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 42,
      "string_id": "cit_doctor_escape_dialog_15",
      "occurrence": 1,
      "EN": "What do you know about this place?",
      "JA_current": "この場所について何を知りたいんだ？",
      "JA_new": "この場所について何か知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "cit_doctor_escape_dialog",
