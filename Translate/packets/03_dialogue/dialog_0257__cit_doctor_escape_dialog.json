    {
      "key": "stable_dialogs_deadcity:cit_doctor_escape_dialog_14#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 27,
      "string_id": "cit_doctor_escape_dialog_14",
      "occurrence": 1,
      "EN": "Who captured us?",
      "JA_current": "誰が俺たちを捕らえたんだ？",
      "JA_new": "俺たちを捕まえたのは誰だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
