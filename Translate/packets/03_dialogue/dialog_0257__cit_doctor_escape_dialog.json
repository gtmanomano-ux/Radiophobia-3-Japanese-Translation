    },
    {
      "key": "stable_dialogs_deadcity:cit_doctor_escape_dialog_12#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 18,
      "string_id": "cit_doctor_escape_dialog_12",
      "occurrence": 1,
      "EN": "How can I get out of here?",
      "JA_current": "どうすればここから脱出できる？",
      "JA_new": "ここからどうやって出る？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
