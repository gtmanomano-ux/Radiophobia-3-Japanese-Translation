      "source_xml_line": 521,
      "string_id": "mil_dolg_soldier_dialog_1",
      "occurrence": 1,
      "EN": "I don't think so.",
      "JA_current": "そうは思わない。",
      "JA_new": "そうは思わない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
