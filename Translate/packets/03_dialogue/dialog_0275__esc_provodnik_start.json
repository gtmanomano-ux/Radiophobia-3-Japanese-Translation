    },
    {
      "key": "stable_dialogs_escape:esc_provodnik_start_13#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 776,
      "string_id": "esc_provodnik_start_13",
      "occurrence": 1,
      "EN": "Well, look at that. How do you know about Doctor?",
      "JA_current": "まあ、待て。どうやって Doctor のことを知った？",
      "JA_new": "ほう、ドクターのことをどこで知った？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "esc_provodnik_start",
          "phrase_id": "13",
