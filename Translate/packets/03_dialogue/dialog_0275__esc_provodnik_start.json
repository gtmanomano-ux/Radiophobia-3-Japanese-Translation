      "string_id": "esc_provodnik_start_12",
      "occurrence": 1,
      "EN": "Guide, I need to see Doctor.",
      "JA_current": "Guide、俺は Doctor に会いたい。",
      "JA_new": "ガイド、ドクターに会いたい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "esc_provodnik_start",
