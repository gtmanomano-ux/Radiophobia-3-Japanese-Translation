      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 779,
      "string_id": "esc_provodnik_start_14",
      "occurrence": 1,
      "EN": "Ghost sent me. Help me get in touch with Doctor. It's urgent.",
      "JA_current": "Ghost が俺を導いた。Doctor に接触する手助けをしてくれ。急を要する。",
      "JA_new": "ゴーストに聞いた。ドクターに会わせてくれ。急いでるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "esc_provodnik_start",
          "phrase_id": "14",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
