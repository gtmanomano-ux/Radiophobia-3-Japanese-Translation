    {
      "key": "stable_dialogs_bar:bar_bar_visitors_10_start_711#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1034,
      "string_id": "bar_bar_visitors_10_start_711",
      "occurrence": 1,
      "EN": "Can you tell me anything that would be useful to a rookie?",
      "JA_current": "何か、新米に役立つ話は ないか？",
      "JA_new": "新米に何か役立つ話はないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_10_start",
          "phrase_id": "711",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_visitors_10_start_7111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1037,
      "string_id": "bar_bar_visitors_10_start_7111",
      "occurrence": 1,
      "EN": "Useful to a rookie? Well, listen up. To the North, not far from the Brain Scorcher, Freedom have set up their HQ in an old military base. They're notorious nihilists, anarchists and criminals - freedom fighters, freaking guerrillas all of them. All they do is sabotage research groups, attack army units and constantly skirmish with Duty. These skirmishes are now spilling over into a small-scale war for survival. Let me give you some advice: never get involved with them. They'll only accept you if you're totally crazy and there's a reward on your head. Ha-ha-ha. Can you believe that?",
      "JA_current": "役立つ話だって？ よし、聞け。Brain Scorcher から北のそう遠くない古い軍基地に Freedom の司令部がある。ヤツら Freedom の兵隊どもは、悪名高い暴力主義者で、無政府主義者、全員がとんでもない犯罪者で、イカれたゲリラどもだ。ヤツらは意図して研究者達を襲い、軍隊のヤツらにケンカを売り、四六時中 Duty のヤツらと小競り合いを繰り返していやがる。お陰で、生き延びるための小競り合いが至る処で行われていやがるというわけだ。俺からの忠告は「ヤツらと関わるな」だ。もしお前さんがイカレちまったら、手みやげの1つでも持って行ってみろよ。アイツらの仲間に入れてもらえるかもしれないぜ、ハハハ。･･･信じるなよ？",
      "JA_new": "新米に役立つ話か？ よし、聞け。北の方、ブレイン・スコーチャーからそう遠くない古い軍事基地に、フリーダムが本部を置いてる。あいつらはニヒリストにアナーキスト、犯罪者の集まりだ。自由の戦士だのゲリラだの名乗ってな。研究グループを妨害し、軍を襲い、デューティーとしょっちゅう小競り合いをしてる。その争いも、今じゃ生き残りをかけた小規模な戦争に発展しつつある。忠告しとく。あいつらには関わるな。よほど頭がおかしいか、首に懸賞金がかかってる奴でもなきゃ受け入れてもらえないぞ。ハハッ、信じられるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_10_start",
          "phrase_id": "7111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_visitors_10_start_71111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1040,
      "string_id": "bar_bar_visitors_10_start_71111",
      "occurrence": 1,
      "EN": "Thanks for your advice.",
      "JA_current": "アドバイスをありがとう。",
      "JA_new": "忠告ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
