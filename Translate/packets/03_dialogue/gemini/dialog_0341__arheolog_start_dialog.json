      "source_xml_line": 268,
      "string_id": "arheolog_start_dialog_phrase_4",
      "occurrence": 1,
      "EN": "What do you mean?",
      "JA_current": "取引だと？ どういうことだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
