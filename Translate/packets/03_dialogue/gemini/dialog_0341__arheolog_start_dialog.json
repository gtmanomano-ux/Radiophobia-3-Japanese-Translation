      "string_id": "arheolog_start_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Can we make a deal?",
      "JA_current": "た、頼む、取引しないか！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
