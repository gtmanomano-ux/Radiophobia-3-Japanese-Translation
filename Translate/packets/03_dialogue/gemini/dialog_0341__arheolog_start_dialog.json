      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_5#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 271,
      "string_id": "arheolog_start_dialog_phrase_5",
      "occurrence": 1,
      "EN": "If you don't hurt me, I'll pay you back. I'll give you the coordinates of my best cache of old military weapons: There are rifles of various calibers, pistols and ammunition there. You won't find this kind of stuff at the dealers.",
      "JA_current": "命さえ助けてくれるなら、相応の礼をする！ 俺が隠した極上の旧軍用武器の隠し場所を教えてやるよ。色んな口径のライフルに拳銃、弾薬もたっぷりある。商人どもからじゃ絶対手に入らないようなお宝だ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_6#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 274,
      "string_id": "arheolog_start_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Yeah, and there's a centimeter thick layer of rust all over it too, right?",
      "JA_current": "どうせ1センチも錆びがこびりついたガラクタなんだろ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_7#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 277,
      "string_id": "arheolog_start_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Not at all, I personally restore, lubricate, and check every gun I find... Stalker, don't do anything stupid. Why do you need all this squabbling between factions? If you kill me, it won't change anything, believe me. And this way you'll also get a profit.",
      "JA_current": "とんでもない！ 見つけた銃は全部、俺自身の手でレストアして、注油も作動確認も完璧にやってある！ ……なあストーカー、馬鹿な真似はやめろ。派閥同士のくだらない抗争に加担して何になる？ 俺を殺したって何も変わりはしない、本当だ！ 俺を見逃せば、あんたもしっかり儲かるんだぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_8#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 280,
      "string_id": "arheolog_start_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Stop trying to talk me out of it. Die, you bastard!",
      "JA_current": "くだらない命乞いは聞き飽きた。くたばれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_9#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 283,
      "string_id": "arheolog_start_dialog_phrase_9",
      "occurrence": 1,
      "EN": "Fuck it, tell me where your hiding place is.",
      "JA_current": "……ちっ、分かったよ。その隠し場所を教えろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_10#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 286,
      "string_id": "arheolog_start_dialog_phrase_10",
      "occurrence": 1,
      "EN": "I knew you were a decent stalker, and not some contract killer scumbag! Listen to me carefully: the cache is in that booth over there with the two tanks and the grid across from these ruins.",
      "JA_current": "あんたが話の分かるまともなストーカーで助かったよ！ 金目当ての殺し屋のクズどもとは大違いだ！ ……いいか、よく聞けよ。隠し場所は、あの廃墟の向かいにある、タンクが2つ付いた鉄格子の小屋の中だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    }
