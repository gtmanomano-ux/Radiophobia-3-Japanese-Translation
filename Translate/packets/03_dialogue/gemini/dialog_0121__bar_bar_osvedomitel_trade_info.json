    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_4111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 971,
      "string_id": "bar_bar_osvedomitel_trade_info_4111",
      "occurrence": 1,
      "EN": "The secret of Lake Yantar is similar to the secret of the Brain Scorcher and their effects are similar in many ways. Some kind of emission zombifies all who come in contact with it. The zombified stalkers move around the center of some emitter, attacking everyone. There is information to suggest that the solution to the riddle of Lake Yantar is below ground. Here are the coordinates of the emitter at Lake Yantar and those of the Brain Scorcher.",
      "JA_current": "ヤンター湖の秘密ってのは、ブレイン・スコーチャーの仕組みとそっくりで、引き起こされる現象も瓜二つだ。正体不明の放射を浴びた者は、例外なくゾンビ化しちまう。ゾンビ化したストーカーどもは、放射源の周りをうろつきながら手当たり次第に襲いかかってくるわけだ。ヤンター湖の謎を解く鍵は地下にあるって情報もある。ヤンター湖の放射源とブレイン・スコーチャー、両方の座標をマークしてやるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "4111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
