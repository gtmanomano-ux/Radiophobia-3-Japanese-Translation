      "occurrence": 1,
      "EN": "Up to you. Come to the bar when you decide otherwise - I'm always here.",
      "JA_current": "好きにしな。気が変わったらバーに来い――俺はいつでもここにいる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
