      "occurrence": 1,
      "EN": "I want to buy some information.",
      "JA_current": "情報を買いに来た。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
