    },
    {
      "key": "stable_dialogs_bar:voronin_quest_dialog_2_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3101,
      "string_id": "voronin_quest_dialog_2_phrase_5",
      "occurrence": 1,
      "EN": "Weapons AND armor? Sounds good to me!",
      "JA_current": "武器と防具を両方か？ そいつは願ってもない！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
