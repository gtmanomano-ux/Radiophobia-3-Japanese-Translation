  "entries": [
    {
      "key": "stable_dialogs_bar:voronin_quest_dialog_2_phrase_1#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3089,
      "string_id": "voronin_quest_dialog_2_phrase_1",
      "occurrence": 1,
      "EN": "I found your Terrorist, he coughed up the locations of all the charges, I already disarmed each one.",
      "JA_current": "テロリストを突き止めた。仕掛けた爆弾の場所をすべて吐かせ、俺の手で全部解除しておいたぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "voronin_quest_dialog_2",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:voronin_quest_dialog_2_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3092,
      "string_id": "voronin_quest_dialog_2_phrase_2",
      "occurrence": 1,
      "EN": "Well, holy shit, Marked One, you just impressed the hell out of me! I think you missed your calling, I can see a career in detective work for you! You have saved the lives of countless good men today, you've spared Duty the indignity of a hasty evacuation and saved our little oasis here from destruction. I have half a mind to take you on as Duty's personal problem solver, we could use a guy with your skills to take care of the mess out there. What should I reward you with? What do you want: artifacts? Money? Weapons or Armor?? No price can match what you've done, but I think we can come pretty close!",
      "JA_current": "おお、なんて奴だ、マークド・ワン！ 心底驚かされたぞ！ 天職を間違えたのではないか？ 探偵として立派に飯が食える腕前だ！ 今日、お前が無数の善良な戦士たちの命を救ったのだ。デューティーが無様な慌ただしい退去を強いられる屈辱を防ぎ、このささやかなオアシスを壊滅の危機から救ってくれた。いっそお前をデューティー専属のトラブルシューターとして迎え入れたいくらいだ。外の厄介事を片付けるのに、お前ほどの腕利きがいれば頼もしいからな。さて、どんな褒美を望む？ アーティファクトか？ 現金か？ それとも武器や防具がいいか？ お前が成し遂げた偉業に釣り合う対価などつけようもないが、相応のものは用意させてもらう！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "voronin_quest_dialog_2",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:voronin_quest_dialog_2_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3095,
      "string_id": "voronin_quest_dialog_2_phrase_3",
      "occurrence": 1,
      "EN": "I wish I had some money. I like money...",
      "JA_current": "現金が欲しいな。金はいくらあっても困らない……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "voronin_quest_dialog_2",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:voronin_quest_dialog_2_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3098,
      "string_id": "voronin_quest_dialog_2_phrase_4",
      "occurrence": 1,
      "EN": "I want rare artifacts, and many of them.",
      "JA_current": "貴重なアーティファクトを、ありったけ頼む。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
