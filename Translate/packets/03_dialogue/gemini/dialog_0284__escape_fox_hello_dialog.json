  "entries": [
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 839,
      "string_id": "escape_fox_hello_dialog_2",
      "occurrence": 1,
      "EN": "Sorry, brother, but could you go somewhere else? I'm not in a chatty mood right now...",
      "JA_current": "悪いが兄弟、よそへ行ってくれないか？ 今は話し込める気分じゃないんだ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 857,
      "string_id": "escape_fox_hello_dialog_3",
      "occurrence": 1,
      "EN": "Thanks. OK, now I'm listening very carefully.",
      "JA_current": "助かった、恩に着るよ。よし、何でも聞いてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 869,
      "string_id": "escape_fox_hello_dialog_5",
      "occurrence": 1,
      "EN": "A medkit! Gimme a medkit!",
      "JA_current": "救急キットだ！ 頼む、救急キットをくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_61#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 878,
      "string_id": "escape_fox_hello_dialog_61",
      "occurrence": 1,
      "EN": "Hey, man, you saved me twice, and that's not something I forget. Take this... that's all I got!",
      "JA_current": "おい、二度も命を救ってもらったな。この恩は絶対に忘れねえよ。これを受け取ってくれ……持ち合わせのすべてだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "61",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 842,
      "string_id": "escape_fox_hello_dialog_21",
      "occurrence": 1,
      "EN": "I've got a couple of questions.",
      "JA_current": "少し聞きたいことがあるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_31#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 860,
      "string_id": "escape_fox_hello_dialog_31",
      "occurrence": 1,
      "EN": "Trader told me you might know something about Strelok.",
      "JA_current": "商人から、あんたがストレロクについて何か知ってるかもしれないと聞いた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_55#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 872,
      "string_id": "escape_fox_hello_dialog_55",
      "occurrence": 1,
      "EN": "Here you are.",
      "JA_current": "ほら、救急キットだ。使え。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "55",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_56#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 875,
      "string_id": "escape_fox_hello_dialog_56",
      "occurrence": 1,
      "EN": "Don't have one. Sorry.",
      "JA_current": "すまない、持っていないんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "56",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_611#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 881,
      "string_id": "escape_fox_hello_dialog_611",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "611",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_211#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 845,
      "string_id": "escape_fox_hello_dialog_211",
      "occurrence": 1,
      "EN": "OK, ask away.",
      "JA_current": "いいぜ、何でも聞いてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "211",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_311#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 863,
      "string_id": "escape_fox_hello_dialog_311",
      "occurrence": 1,
      "EN": "Why is everyone taking such a keen interest in him lately? OK, I can't say I know him personally. We did \"communicate\" though: my guys took some shots at him once. No one got hurt - it was clear his party had been waiting for someone else, so we parted in peace. Cussed each other out across a ravine and went on our separate ways. Seriy, my brother, is now in the hangar at the Garbage - I'll dish you his coordinates so you two can have a chat. He knows more about Strelok. Be careful at the exit, a small gang has settled down in those parts. By the way, I got a few mutts chasing me and it doesn't look like they've given up yet. You mind helping me deal with them? It's a walk in the park really.",
      "JA_current": "最近、どうしてみんなあいつのことに血眼になってるんだ？ まあ、個人的に知り合いってわけじゃないんだがな。ただ「言葉を交わした」ことはあるぜ。うちの連中が一度、奴らに発砲したことがあってな。幸い誰も怪我はしなかった。あいつらは別の相手を待ち伏せしていたらしくて、穏便に手を引いたよ。谷越しに悪態をつき合って、それぞれの道を行くってな。弟のセリーなら、今はガーベジの格納庫にいる。座標を送るから話を聞きに行ってみな。ストレロクのことなら俺より詳しいはずだ。出口の辺りは気をつけろよ、チンピラの小集団が居座ってる。ところで……何匹かの駄犬にずっと追われててな、まだ諦めてないらしい。片付けるのを手伝ってくれないか？ 朝飯前の簡単な仕事だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "311",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 848,
      "string_id": "escape_fox_hello_dialog_2111",
      "occurrence": 1,
      "EN": "What can you tell me about the Zone?",
      "JA_current": "ゾーンについて何か教えてくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2113#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 854,
      "string_id": "escape_fox_hello_dialog_2113",
      "occurrence": 1,
      "EN": "I've changed my mind. Thanks.",
      "JA_current": "気が変わった。気にしないでくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2113",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_3111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 866,
      "string_id": "escape_fox_hello_dialog_3111",
      "occurrence": 1,
      "EN": "Thanks for the info, I appreciate it.",
      "JA_current": "情報をありがとう、助かったよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_21111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 851,
      "string_id": "escape_fox_hello_dialog_21111",
      "occurrence": 1,
      "EN": "That's all you wanna know? Take a week off and then come back to see me. Look, my time ain't cheap and I'm kinda busy right now. Here are the basics and then you're on your own. About three kilometers North of here, you'll find the Garbage. That's the place where they used to dump all the radioactive waste from the station. High radiation levels, anomalies all over the place, so there are loads of artifacts to be found there... but not very valuable. Just beware of the gangs and don't cross the Duty patrols. West of the Garbage is the former Agroprom Research Institute. Little in terms of artifacts there so you can skip it. And to the East, there's the Dark Valley. Who knows... That's a pretty weird place. It seems quiet enough, apart from a bunch of gangsters roaming around. But I got a feeling there's more to it than meets the eye. Oh, and there's the Rostok factory right beyond the Garbage. That's Duty territory and a popular stalker hideout. You'll find lots of clued-up folks there, they'll tell you the rest.",
      "JA_current": "知りたいのはそれだけか？ 1週間ほど骨休めしてからまた聞きに来てくれ。俺の時間もタダじゃないし、今は立て込んでるんでね。基本だけ教えるから、あとは自分で何とかしな。ここから北へ3キロほど行くとガーベジだ。あそこは原発からの放射性廃棄物をまとめて投げ捨てていた場所でな。放射線量は高いし、いたる所にアノマリーがあるからアーティファクトは山ほど見つかる……もっとも、大した値打ちの物はないがな。ギャングどもには警戒しろよ。それとデューティーの巡回部隊の邪魔はするな。ガーベジの西側には旧アグロプロム研究所がある。アーティファクトはほとんどないから、行かなくてもいいだろう。そして東側にはダークバレーがある。さあな……かなり不気味な場所だ。うろつくギャングどもを除けば静まり返っているが、目に見える以上の何かが潜んでいる気がしてならない。ああ、それとガーベジを越えた先にはロストク工場がある。デューティーの縄張りで、ストーカーたちの溜まり場だ。事情通がたくさんいるから、残りはそいつらに聞くといい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "21111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_88#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 267,
      "string_id": "dialogs_escape_88",
      "occurrence": 1,
      "EN": "Wait... Do you hear that? Damn, it's the very pack that has been chasing me from the Garbage. Help me to finish them - I won't stint you of a reward.",
      "JA_current": "待て……今の音が聞こえたか？ くそっ、ガーベジから追ってきたあの群れだ！ 奴らを仕留めるのを手伝ってくれ――報酬は弾むぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "31111000",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_89#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 270,
      "string_id": "dialogs_escape_89",
      "occurrence": 1,
      "EN": "Deal. Yeah, they seem to be getting closer. Well, good luck to us!",
      "JA_current": "分かった。どんどん近づいてきているな。よし、お互い無事を祈ろう！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "31111001",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    }
