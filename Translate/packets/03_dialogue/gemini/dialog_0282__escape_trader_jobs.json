      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_51#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1189,
      "string_id": "escape_trader_jobs_51",
      "occurrence": 1,
      "EN": "Go on.",
      "JA_current": "続けてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "51",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_611#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1213,
      "string_id": "escape_trader_jobs_611",
      "occurrence": 1,
      "EN": "Anyway, here's the thing about Strelok. There's a stalker that goes by this name. They say he's found a path to the northern reaches of the Zone. And that is a virgin area, a real goldmine for artifacts... Yeah... Anyway, I can help you find him... However... As you can imagine, it won't be a free ride. You'll have to work it off... But in the long run we will both benefit: You're going to waste that Strelok fella and find out what's happened to you... And I'll find... well, I mean... I'll get my share of our mutual profit, he-he... So what do you say? Deal?",
      "JA_current": "とにかく、そのストレロクの話だ。そういう名前のストーカーがいる。噂じゃ、そいつはゾーン最北部へと通じるルートを見つけ出したらしい。そこはまだ誰も足を踏み入れていない手つかずの地で、アーティファクトのまさに宝の山だ……ああ……とにかく、俺ならそいつを探し出す手助けができる……だが……お前さんも察しのとおり、タダ働きってわけにはいかない。身体で払ってもらうぞ……だが最終的には、俺たち双方にとって美味い話になる。お前さんはそのストレロク野郎を始末して、自分の身に何が起きたのかを突き止める……そして俺は……まあ、つまりだ……お互いの儲けから分け前をいただく、へへっ……どうだ？ 乗るかい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "611",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_511#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1192,
      "string_id": "escape_trader_jobs_511",
      "occurrence": 1,
      "EN": "Sneak into the outpost quietly and \"recover\" the box. Do that and I'll pay you anything...within reason. Will you do it?",
      "JA_current": "前哨基地に静かに忍び込んで、箱を「回収」してきてくれ。やり遂げてくれたら、相応の額をきっちり弾むぞ。やってくれるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "511",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_6111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1216,
      "string_id": "escape_trader_jobs_6111",
      "occurrence": 1,
      "EN": "Go on.",
      "JA_current": "続けてくれ。",
