      "occurrence": 1,
      "EN": "Got any special missions for me?",
      "JA_current": "何か特別な依頼はあるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "0",
