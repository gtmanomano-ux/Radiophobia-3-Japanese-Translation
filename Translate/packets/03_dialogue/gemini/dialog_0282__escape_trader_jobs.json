        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_611111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1231,
      "string_id": "escape_trader_jobs_611111111",
      "occurrence": 1,
      "EN": "You'll have to go North through the Garbage, then turn West. You'll end up at the Agroprom Research Institute after a few kilometers. And be careful, the radiation level is way too high at the Garbage. So I suggest you cough up for some anti-rad or vodka. Well, good luck.",
      "JA_current": "ガーベジを北へ抜けて、そこから西へ舵を取るんだ。数キロ進めばアフロプロム研究所にぶち当たる。それと気をつけろよ、ガーベジは放射線が桁外れに高い。抗放射線薬かウォッカをケチらず用意して行くんだな。よし、武運を祈るぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "611111111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    }
  ],
