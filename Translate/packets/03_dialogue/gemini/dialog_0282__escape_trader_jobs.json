        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_6#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1207,
      "string_id": "escape_trader_jobs_6",
      "occurrence": 1,
      "EN": "Listen, Marked One... I've done some thinking, and here's what I'd like to offer... Generally speaking, what you really need is to find Strelok. Right?",
      "JA_current": "いいか、マークド・ワン……少し考えてみたんだが、お前さんに一つ提案がある。話を聞く限り、お前さんが本当にやりたいのはストレロクを見つけ出すことだな。そうだろ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1186,
      "string_id": "escape_trader_jobs_5",
      "occurrence": 1,
      "EN": "Well, here's the deal... A box containing the reports made by an expedition that went deep North into the Zone has been taken to the army outpost. By day, it's guarded as if it was filled with pure plutonium, but for some reason at night they only leave two guards.",
      "JA_current": "話はこうだ……ゾーン北部の奥深くまで潜入した遠征隊の調査報告書が入った箱が、軍の前哨基地に運び込まれた。昼間は純プルトニウムでも詰まってるかのように厳重に警備されてるんだが、なぜか夜になると見張りが二人だけになるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_1#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1180,
      "string_id": "escape_trader_jobs_1",
      "occurrence": 1,
      "EN": "Nope, not a thing.",
      "JA_current": "いや、今は何もないな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_61#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1210,
      "string_id": "escape_trader_jobs_61",
      "occurrence": 1,
      "EN": "Let's assume I do.",
      "JA_current": "まあ、そういうことにしておこう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
