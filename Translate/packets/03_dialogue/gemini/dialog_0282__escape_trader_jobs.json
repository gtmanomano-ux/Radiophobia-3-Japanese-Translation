    },
    {
      "key": "stable_dialogs_escape:escape_trader_jobs_12#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1183,
      "string_id": "escape_trader_jobs_12",
      "occurrence": 1,
      "EN": "What special missions? You haven't even finished the last one!",
      "JA_current": "特別な依頼だと？ 前の仕事もまだ片づいてないじゃないか！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_trader_jobs",
          "phrase_id": "12",
