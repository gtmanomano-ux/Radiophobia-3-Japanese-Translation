    },
    {
      "key": "stable_dialogs_deadcity:cit_doctor_escape_dialog_16#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 51,
      "string_id": "cit_doctor_escape_dialog_16",
      "occurrence": 1,
      "EN": "Who's in charge here?",
      "JA_current": "ここを仕切っているのは誰だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "cit_doctor_escape_dialog",
