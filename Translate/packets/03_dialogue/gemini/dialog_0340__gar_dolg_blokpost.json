      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 42,
      "string_id": "gar_dolg_blokpost_1111212111",
      "occurrence": 1,
      "EN": "Good luck, stalker.",
      "JA_current": "武運を祈るぞ、ストーカー。",
