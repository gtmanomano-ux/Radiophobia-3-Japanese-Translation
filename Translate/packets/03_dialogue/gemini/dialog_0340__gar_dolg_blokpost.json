    {
      "key": "stable_dialogs_garbage:gar_dolg_blokpost_1231#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 57,
      "string_id": "gar_dolg_blokpost_1231",
      "occurrence": 1,
      "EN": "Thanks for helping us fight off the boars, take the deserved reward.",
      "JA_current": "ボア退治に手を貸してくれて助かったよ。これは約束の報酬だ、受け取れ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_dolg_blokpost",
          "phrase_id": "1231",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
