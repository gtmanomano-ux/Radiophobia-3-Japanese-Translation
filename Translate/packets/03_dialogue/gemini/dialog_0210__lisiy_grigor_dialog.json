      ]
    },
    {
      "key": "stable_dialogs_bar:lisiy_grigor_dialog_phrase_9#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3220,
      "string_id": "lisiy_grigor_dialog_phrase_9",
      "occurrence": 1,
      "EN": "There, behind some garages...",
      "JA_current": "あそこのガレージの裏手だ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "lisiy_grigor_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:lisiy_grigor_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3214,
      "string_id": "lisiy_grigor_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Don't get upset. Don't you know that a real stalker keeps his stuff not only in his backpack, but also in secret hidey holes? I've got a pretty good stash, so now you can consider it yours. It's right here in the Bar. Opposite the cracked tower next to the hangar, there's a nook overgrown with bushes and some pipes sticking out. Look there, in the corner.",
      "JA_current": "そう落ち込むなよ。本物のストーカーなら、背中のリュックだけでなく秘密の隠し場所にも蓄えを残しておくもんだろ？ とっておきの隠し場所がある、あんたにくれてやるよ。場所はこのロストクだ。格納庫の隣にあるひび割れた塔の向かい、茂みが鬱陶しく生い茂ってパイプが突き出ている一角がある。その隅っこを探してみな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "lisiy_grigor_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:lisiy_grigor_dialog_phrase_10#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3223,
      "string_id": "lisiy_grigor_dialog_phrase_10",
      "occurrence": 1,
      "EN": "Don't lie.",
      "JA_current": "嘘をつくな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "lisiy_grigor_dialog",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:lisiy_grigor_dialog_phrase_11#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3226,
      "string_id": "lisiy_grigor_dialog_phrase_11",
      "occurrence": 1,
      "EN": "I'll be eaten by the Zone if I'm lying.",
      "JA_current": "嘘ならゾーンの餌食になったって構わん。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "lisiy_grigor_dialog",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:lisiy_grigor_dialog_phrase_12#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3229,
      "string_id": "lisiy_grigor_dialog_phrase_12",
      "occurrence": 1,
      "EN": "I hope she does eat you. Because I know where you got that tablet: you took it off my dead friend's corpse. I was told by witnesses that bandits killed him in a gunfight, and that some stalker who looked a lot like you helped himself to the body while it was still warm. Get out of here, asshole, and watch don't get a stray bullet in your back.",
      "JA_current": "せいぜい食われちまえばいい！ そのタブレットをどこで手に入れたか、俺は知ってるんだぞ。死んだ俺の友人の遺体から剥ぎ取ったんだろ！ 目撃者から聞いたんだ、友人が銃撃戦でバンディットに撃ち殺された後、まだ死体が温かいうちにあんたそっくりの野郎が漁っていったとな！ 消え失せろ、クズ野郎！ 背中に流れ弾を撃ち込まれたくなかったら、二度と俺の前に面を見せるな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "lisiy_grigor_dialog",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
  ],
