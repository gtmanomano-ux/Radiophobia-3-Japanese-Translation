    {
      "key": "stable_dialogs_bar:osvedomitel_ugroza_phrase_13#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1928,
      "string_id": "osvedomitel_ugroza_phrase_13",
      "occurrence": 1,
      "EN": "Listen to me carefully, cormorant. Have you heard the story of Robin Hood? No? Or George the Just? Well, your dough just went to the poor. Forget about it and get out of here. You just got ripped off! If you come near me or go crying about it, me and the boys will kick your mother's ass!",
      "JA_current": "よーく耳かっぽじって聞きな、カモ野郎。お前、ロビン・フッドの物語は知ってるか？ 知らねえ？ じゃあ『義人ジョージ』は？ へっ、お前の現ナマは今、貧しい人たちへ恵んでやられたのさ！ 諦めてとっとと失せな。お前はまんまとカモられたんだよ！ これ以上俺に近づいたり泣き喚いたりしてみろ、仲間を呼んでテメエの母親のケツを蹴り上げてやるからな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_ugroza",
          "phrase_id": "12",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_ugroza_phrase_14#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1931,
      "string_id": "osvedomitel_ugroza_phrase_14",
      "occurrence": 1,
      "EN": "You fucking snake!",
      "JA_current": "このクソ蛇野郎が……！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_ugroza",
          "phrase_id": "13",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_ugroza_phrase_15#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1934,
      "string_id": "osvedomitel_ugroza_phrase_15",
      "occurrence": 1,
      "EN": "It's your own fault. You wanted to screw me with Basta, so now you get it.",
      "JA_current": "自業自得だろ。バスタの件で俺を騙そうとしたんだ、ツケを払っただけだぜ。",
