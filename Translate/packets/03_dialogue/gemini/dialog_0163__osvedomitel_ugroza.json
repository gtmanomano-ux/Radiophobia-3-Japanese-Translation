      "occurrence": 1,
      "EN": "I killed a stalker named Basta.",
      "JA_current": "バスタというストーカーを殺してきた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_ugroza",
