    },
    {
      "key": "stable_dialogs_escape:escape_trader_start_dialog_521211#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1321,
      "string_id": "escape_trader_start_dialog_521211",
      "occurrence": 1,
      "EN": "Here, take it.",
      "JA_current": "ほら、受け取れ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_escape:escape_trader_start_dialog_5212111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1324,
      "string_id": "escape_trader_start_dialog_5212111",
      "occurrence": 1,
      "EN": "Good...We'll consider that you passed the test. I'd suggest you avoid going to the rookie camp.",
      "JA_current": "よし……これでテストは合格とみなしてやろう。ルーキー村には近づかんほうが身のためだぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_escape:escape_trader_start_dialog_571#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1330,
      "string_id": "escape_trader_start_dialog_571",
      "occurrence": 1,
      "EN": "So, did you bring the artifact?",
      "JA_current": "で、アーティファクトは持ってきたんだろうな？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_escape:escape_trader_start_dialog_5711#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1333,
      "string_id": "escape_trader_start_dialog_5711",
      "occurrence": 1,
      "EN": "Not yet.",
      "JA_current": "まだだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_escape:escape_trader_start_dialog_57111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1336,
      "string_id": "escape_trader_start_dialog_57111",
      "occurrence": 1,
      "EN": "Well, until you bring it, we've got nothing to talk about. Got it?",
      "JA_current": "おいおい、それを持ってくるまでは話すことなんかないぞ。分かったな？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
