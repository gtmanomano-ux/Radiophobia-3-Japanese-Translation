          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1874,
      "string_id": "osvedomitel_daet_infu_phrase_2",
      "occurrence": 1,
      "EN": "Let me see... That's right, that's his. There's the engraving. That's it, mission accomplished.",
      "JA_current": "どれ見せてみろ……間違いない、あいつのだ。刻印が入ってる。よし、任務完了だな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1877,
      "string_id": "osvedomitel_daet_infu_phrase_3",
      "occurrence": 1,
      "EN": "Now, I need the information you promised me, and that agent.",
      "JA_current": "さあ、約束の情報だ。あのエージェントについて教えてもらおうか。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1880,
      "string_id": "osvedomitel_daet_infu_phrase_4",
      "occurrence": 1,
      "EN": "Yeah, listen: this agent is a stalker nicknamed Knopik. He's been working with that group for a short while. Mostly procures all kinds of equipment for them and acts as a scout and point-man.",
      "JA_current": "ああ、耳をかっぽじって聞けよ。エージェントってのは、『クノピク』ってあだ名のストーカーだ。あの一味とつるみ始めてまだ日が浅い。主な役回りは装備や弾薬の調達で、斥候や先導役もこなしてる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1883,
      "string_id": "osvedomitel_daet_infu_phrase_5",
      "occurrence": 1,
      "EN": "Where can I find him?",
      "JA_current": "そいつはどこにいる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1886,
      "string_id": "osvedomitel_daet_infu_phrase_6",
      "occurrence": 1,
      "EN": "Until recently, he was with the group, I know that for a fact. I don't know where to find them all, you'll have to do more digging. These strangers are too secretive, they don't talk to anyone. I believe someone affiliated with them has been to the bar recently, on a supply run for some ammo and kit. He was last seen crossing through the Army Warehouses. Try to intercept him there, be warned that mercs have been seen there lately, could be connected.",
      "JA_current": "つい最近まで一味と一緒に行動してたのは確かだ。奴ら全員がどこに潜んでるかまでは掴んでねえ、そこはお前自身で掘り下げるんだな。あの余所者どもは用心深すぎて誰とも口を利かねえ。だが、最近一味の息がかかった奴が、弾薬や装備の補給でバーに来てたらしい。最後に目撃されたのは軍事倉庫を横切っていく姿だ。あそこで待ち伏せしてみろ。最近あの一帯でマーセナリーズが目撃されてるから、何かつながりがあるかもしれねえぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_daet_infu_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1889,
      "string_id": "osvedomitel_daet_infu_phrase_7",
      "occurrence": 1,
      "EN": "I see, thank you. I'm going over there now.",
      "JA_current": "分かった、恩に着る。今すぐ向かうよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
