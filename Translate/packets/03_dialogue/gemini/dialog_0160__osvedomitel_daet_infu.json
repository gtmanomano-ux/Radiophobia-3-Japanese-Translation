      "string_id": "osvedomitel_daet_infu_phrase_1",
      "occurrence": 1,
      "EN": "I liquidated that stalker. Here is the proof - his wristwatch.",
      "JA_current": "あのストーカーを始末してきた。これが証拠だ――奴の腕時計だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_daet_infu",
