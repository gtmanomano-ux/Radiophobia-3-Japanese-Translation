      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 168,
      "string_id": "dialogs_bar_55",
      "occurrence": 1,
      "EN": "Not bad, stalker, not bad at all. You found some pretty rare artifacts, so you'll have no problem finding this cache. It's in the Dark Valley. There's a swamp, an island on it, and a tree on the island. Under that tree is the cache.",
      "JA_current": "上出来だ、ストーカー、実に素晴らしい。これほど貴重なアーティファクトを見つけられる腕なら、隠し場所も見落としはすまい。場所はダークバレーだ。沼の中に小島があって、そこに1本の木が生えている。その木の根元が隠し場所だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron2_dialog",
          "phrase_id": "4",
