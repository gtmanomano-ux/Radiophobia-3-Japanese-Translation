  "entries": [
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_0#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1304,
      "string_id": "bar_dolg_leader_join_0",
      "occurrence": 1,
      "EN": "Barkeep told me that you have some assignment for me at the military warehouses...",
      "JA_current": "バーキープから聞いた。軍事倉庫で俺にやらせたい仕事があるそうだな……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_1#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1307,
      "string_id": "bar_dolg_leader_join_1",
      "occurrence": 1,
      "EN": "I want to ask you to do one thing for me, it's a personal favor, you understand? We're in the midst of territorial warfare with the Freedom faction and we need some weapons more powerful than what we have. Freedom has some excellent grenade launchers. If you could penetrate their territory and steal at least one such grenade launcher, I would generously reward you. Since you aren't in our faction, you can quickly gain the trust of Freedom and, if you're lucky, get a hold of the hardware.",
      "JA_current": "頼みたいことがある。私個人の依頼だ、いいな？ 今、我々はフリーダムと縄張り争いの真っ最中だが、連中に対抗するためにより強力な火力を欲している。フリーダムは非常に優れたグレネードランチャーをいくつか保有しているのだ。奴らの本拠地に潜入し、そのグレネードランチャーを一丁でも盗み出してくれれば、惜しみない報酬を出そう。お前はまだ我が派閥の人間ではない。奴らを油断させて信用を得るのも容易だろうし、運が良ければブツを手に入れられるはずだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_11#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1310,
      "string_id": "bar_dolg_leader_join_11",
      "occurrence": 1,
      "EN": "Go on.",
      "JA_current": "続けてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1313,
      "string_id": "bar_dolg_leader_join_111",
      "occurrence": 1,
      "EN": "I'll upload the location of the Freedom base for you. You'll need to find the Chef. He's a member of Freedom. He knows where the goods are kept. And he likes his booze so bring a lot of vodka with you. So, what do you say?",
      "JA_current": "フリーダム基地の座標をPDAに送っておく。向こうで「シェフ」という男を探せ。フリーダムの隊員で、武器の保管場所を握っている。奴は大の酒好きだ、ウォッカをたんまり持っていくといい。どうだ、引き受けてくれるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_1111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1316,
      "string_id": "bar_dolg_leader_join_1111",
      "occurrence": 1,
      "EN": "OK, I'll try to steal a grenade launcher from Freedom.",
      "JA_current": "分かった。フリーダムからグレネードランチャーをくすねてこよう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "1111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_1112#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1322,
      "string_id": "bar_dolg_leader_join_1112",
      "occurrence": 1,
      "EN": "I'm not ready for such exploits just yet.",
      "JA_current": "そんな危険な芸当に首を突っ込む気はまだないな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "1112",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_11111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1319,
      "string_id": "bar_dolg_leader_join_11111",
      "occurrence": 1,
      "EN": "Oh, and one more thing. Colonel Skull and his boys disobeyed my order and decided to attack the Freedom base without authorization. Well, they can reap what they've sown... suicidal bastards. Don't get involved in their fight. Just try to get me the launcher - nothing else matters.",
      "JA_current": "ああ、それともう一つ。スカル大佐とその部下どもが私の命令に背き、独断でフリーダム基地へ攻撃を仕掛けようとしている。まったく、自分で蒔いた種は自分で刈り取ってもらうしかない……死に急ぐ阿呆どもめ。奴らの戦闘には決して関わるな。グレネードランチャーを確実に私の元へ持ち帰るんだ――それ以外はどうでもいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "11111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_join_11121#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1325,
      "string_id": "bar_dolg_leader_join_11121",
      "occurrence": 1,
      "EN": "Up to you.",
      "JA_current": "お前が決めることだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_join",
          "phrase_id": "11121",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
