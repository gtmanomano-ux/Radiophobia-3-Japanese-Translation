    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2784,
      "string_id": "bar_izlom_magnit_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Do you even know what this thing is?",
      "JA_current": "お前、こいつが何なのか分かって言ってるのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2787,
      "string_id": "bar_izlom_magnit_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Sure! It's a real delicacy for us jerks. Well, why are you staring like a pig at lard? Come on, I said, bring it here, you cheapskate. You don't know that it's sucking the juices out of you people? Come on, while it's still good, I know just how to remove it!",
      "JA_current": "当たり前だろぅ！ 俺たち奇形野郎にとっちゃ極上のごちそうなんだよ。何ブタみてえにぽかんと眺めてやがる？ 早く持ってこいって言ってんだ、ドケチ野郎！ こいつがお前ら人間の生気を吸い尽くしてるって知らねえのか？ 鮮度が落ちないうちに早く寄越せ、外し方ならちゃんと知ってるからよぅ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2790,
      "string_id": "bar_izlom_magnit_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Yeah, sure, take it.",
      "JA_current": "ああ、分かった。持っていけ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
