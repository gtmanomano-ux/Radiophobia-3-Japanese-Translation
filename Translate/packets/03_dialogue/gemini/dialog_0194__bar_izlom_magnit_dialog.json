          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2781,
      "string_id": "bar_izlom_magnit_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Why didn't you tell me you had such delicious things? Come on, give it to me, my little dove, and hurry up!",
      "JA_current": "何でそんな美味そうなもん持ってるって早く言わねえんだよぅ！ ほら、早く俺に寄越しな、可愛い鳩ちゃん、さあ早く！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
