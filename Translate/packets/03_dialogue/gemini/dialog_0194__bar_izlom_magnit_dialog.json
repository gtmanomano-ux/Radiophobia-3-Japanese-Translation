        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2775,
      "string_id": "bar_izlom_magnit_dialog_phrase_2",
      "occurrence": 1,
      "EN": "A \"black magnet\", you say? How long have you had it?",
      "JA_current": "「ブラックマグネット」だってぇ？ そいつはいつからくっついてるんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_izlom_magnit_dialog_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2778,
      "string_id": "bar_izlom_magnit_dialog_phrase_3",
      "occurrence": 1,
      "EN": "A while... It's stuck to me like tar, I can't get rid of it.",
      "JA_current": "もうずいぶん前だ……タールみたいに張り付いて、どうしても剥がれないんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
