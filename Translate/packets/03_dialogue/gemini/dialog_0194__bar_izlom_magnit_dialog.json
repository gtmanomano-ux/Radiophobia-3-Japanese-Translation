      "string_id": "bar_izlom_magnit_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Listen, do you know who could help me get rid of this Black Magnet?",
      "JA_current": "なあ、このブラックマグネットを取り外してくれる奴を知らないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_izlom_magnit_dialog",
