      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2793,
      "string_id": "bar_izlom_magnit_dialog_phrase_8",
      "occurrence": 1,
      "EN": "I'd rather take it to the scientists, they will irradiate it with something, and it will fall off. And I'll get some money for it, too.",
      "JA_current": "科学者のところへ持っていく方がマシだ。何か照射でもすれば外れるだろうし、報酬ももらえる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
