          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:osvedomitel_about_slon_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2809,
      "string_id": "osvedomitel_about_slon_phrase_4",
      "occurrence": 1,
      "EN": "I see... Maybe I can help you out... Oh, yeah, that's it! I can help you with your problem, but only if you bring me three artifacts: the Urchin, the Crystal, and the Soul.",
      "JA_current": "なるほどな……力になってやれるかもしれん……ああ、そうだ！ お前の困り事を解決してやってもいいが、そのためにはアーティファクトを3つ持ってきてもらうぜ。«アーチン»、«クリスタル»、それに«ソウル»だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_about_slon",
