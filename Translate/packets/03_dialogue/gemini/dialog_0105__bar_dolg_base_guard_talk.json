      "string_id": "bar_dolg_base_guard_talk_2",
      "occurrence": 1,
      "EN": "A war with Freedom? Why?",
      "JA_current": "フリーダムと戦争だと？ どうしてだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_talk",
