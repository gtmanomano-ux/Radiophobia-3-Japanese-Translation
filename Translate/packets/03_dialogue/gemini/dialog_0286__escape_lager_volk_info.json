      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "What do you know about the Zone?",
      "JA_current": "ゾーンについて何か知っているか？",
      "string_entry_candidates": [
        "stable_dialogs_escape:escape_lager_volk_info_2#1"
      ]
    },
    {
      "phrase_id": "3",
      "text_id": "escape_lager_volk_info_3",
