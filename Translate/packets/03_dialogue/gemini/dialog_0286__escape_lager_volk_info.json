      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Have you heard about a guy called Strelok?",
      "JA_current": "Strelok という男を聞いたことがあるか？",
      "string_entry_candidates": [
        "stable_dialogs_escape:escape_lager_volk_info_3#1"
      ]
    },
    {
      "phrase_id": "4",
      "text_id": "escape_lager_volk_info_4",
      "next": [
        "41"
      ],
      "conditions": [],
