    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1000,
      "string_id": "escape_lager_volk_info_2",
      "occurrence": 1,
      "EN": "What do you know about the Zone?",
      "JA_current": "ゾーンについて何か知っているか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1036,
      "string_id": "escape_lager_volk_info_3",
      "occurrence": 1,
      "EN": "Have you heard about a guy called Strelok?",
      "JA_current": "ストレロクという男について、何か聞いたことはないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "3",
