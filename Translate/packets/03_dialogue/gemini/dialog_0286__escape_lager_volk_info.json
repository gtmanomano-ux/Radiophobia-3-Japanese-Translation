        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_4#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1042,
      "string_id": "escape_lager_volk_info_4",
      "occurrence": 1,
      "EN": "What do you know about \"death trucks?\"",
      "JA_current": "「死のトラック」について何か知らないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_10#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 997,
      "string_id": "escape_lager_volk_info_10",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1003,
      "string_id": "escape_lager_volk_info_21",
      "occurrence": 1,
      "EN": "I know many things. Be more specific.",
      "JA_current": "知ってることなら山ほどある。もっと具体的に聞いてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_31#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1039,
      "string_id": "escape_lager_volk_info_31",
      "occurrence": 1,
      "EN": "I seem to remember he's one of the tough ones. Never actually met the man. Well, I haven't come close to the center in a while and all we get here is rookies. You should find someone who hangs out deep in the Zone and have a chat with him.",
      "JA_current": "相当腕の立つストーカーだったはずだ。直接会ったことはないがな。まあ、俺もしばらく中心部には近づいてないし、この辺境をうろついてるのは青二才ばかりだからな。ゾーンの深部に入り浸ってる奴を探して、話を聞いてみるといい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_41#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1045,
      "string_id": "escape_lager_volk_info_41",
      "occurrence": 1,
      "EN": "I know nothing and that's fine by me, thank you!  Sorry, I know about your situation. Too much mysticism about it. You spend a month in these parts and you can't help but become superstitious about life. Dead people in the trunk, dead people behind the wheel... Who are they, where did they come from and why? I can only hope they didn't rise up from the grave.",
      "JA_current": "何も知らんし、知りたくもないね！\n……すまん、お前の事情は知ってるよ。だが、あの話は気味が悪すぎる。この辺りにひと月もいれば、嫌でもオカルト染みた迷信を信じるようになっちまう。荷台に積まれた死体、ハンドルを握る死体……奴らは何者で、どこから来て、何の目的があるんだ？ せめてあの世から蘇ってきたゾンビじゃないことを祈るばかりだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_211#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1006,
      "string_id": "escape_lager_volk_info_211",
      "occurrence": 1,
      "EN": "What's in the center of the Zone?",
      "JA_current": "ゾーンの中心には何があるんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "211",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_212#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1018,
      "string_id": "escape_lager_volk_info_212",
      "occurrence": 1,
      "EN": "How did the Zone come to be?",
      "JA_current": "ゾーンはどうやって生まれたんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "212",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_213#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1024,
      "string_id": "escape_lager_volk_info_213",
      "occurrence": 1,
      "EN": "What brought you to the Zone?",
      "JA_current": "なぜゾーンに来たんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "213",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_214#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1030,
      "string_id": "escape_lager_volk_info_214",
      "occurrence": 1,
      "EN": "What's the most dangerous thing in the Zone?",
      "JA_current": "ゾーンで一番危険なものは何だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "214",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_2111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1009,
      "string_id": "escape_lager_volk_info_2111",
      "occurrence": 1,
      "EN": "Ahem, that's a question alright... I've been looking for the answer for two years! I still haven't found a way to the center, at least not one I could take and come back alive. My friends and I tried to break through a couple of times. I barely made it back, but my friends - well, some did, some didn't...  You'll ask why we went there at all. We were chasing our dreams, trying to make them come true.",
      "JA_current": "おいおい、とんでもないことを聞くな……そいつの答えを、俺はもう2年も探し続けてるんだ！ だが生きて帰ってこられるような中心部へのルートなんざ、いまだに見つけられちゃいない。昔、仲間と何度か強行突破を試みたんだがな。俺は命からがら戻れたものの、仲間は……全員が無事とはいかなかった。なぜそんな無茶をしたのかって？ 夢を追ってたのさ。願いを叶えたくてな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "2111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_2121#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1021,
      "string_id": "escape_lager_volk_info_2121",
      "occurrence": 1,
      "EN": "There was another explosion here in 2006. That's how it came about. I know that's not a real answer. Very few know the whole truth, if anyone at all.",
      "JA_current": "2006年にここで二度目の大爆発が起きて、その結果ゾーンが生まれた。まあ、これじゃ答えになってないのは分かってる。だが真実を知る者なんざ、このゾーンに誰一人いないかもしれん。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "2121",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_2131#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1027,
      "string_id": "escape_lager_volk_info_2131",
      "occurrence": 1,
      "EN": "I used to work in a mine before they closed it down. I had no money and nothing to look forward to. Then I heard some rumors about the fabulous riches hidden inside the Zone. I had some experience under my belt, so I thought \"Why the hell not?\". Can't say I've become rich, but some cash came my way, that's for sure. Not a really interesting story; most of us got here the same way.",
      "JA_current": "赤字で閉山になるまでは炭鉱で働いてたんだ。金もなきゃ将来の希望もない。そんな時、ゾーンには途方もない富が眠ってるって噂を耳にしてな。多少は体も動かせたし、「一丁やってみるか」と腹をくくったのさ。大金持ちになったとは言えんが、それなりに稼げるようにはなった。まあ、ありきたりな話だよ。ここにいる奴らの大半が似たような理由で流れ着いてる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "2131",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_2141#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1033,
      "string_id": "escape_lager_volk_info_2141",
      "occurrence": 1,
      "EN": "Hard to say. There are so many dangers and surprises, you just can't run into all of them. There's more than enough for one person anyway. I got one toe bitten off, my hair is falling out from the radiation, and half my leg got fried in a Scorcher... Things are real bad out there. Another time I happened to come face to face with a bloodsucker - now there's a meeting I'd like to forget. So, we can talk all you like, but you'll never truly know until you experience it on your own. The only advice I can give is to be on your guard - everywhere and always.",
      "JA_current": "一言じゃ言えないな。危険も未知の脅威も山ほどあって、全部に出くわす前にまず命を落とす。俺だって散々な目に遭ってきたさ。足の指を一本フレッシュに噛みちぎられ、放射線で髪が抜け落ち、右足の半分をバーナーで丸焼きにされかけた……あのバーナーのアノマリーは本当に最悪だ。ブラッドサッカーと鼻先を突き合わせたことだってある――思い出すだけでもゾッとするぜ。まあ、いくら言葉で説明したところで、身をもって体験しなきゃ分かりっこない。俺から言える助言はただ一つ、常に、どこにいようと油断するな、それだけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "2141",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_21111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1012,
      "string_id": "escape_lager_volk_info_21111",
      "occurrence": 1,
      "EN": "Can dreams come true?",
      "JA_current": "夢は本当に叶うのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "21111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_volk_info_211111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1015,
      "string_id": "escape_lager_volk_info_211111",
      "occurrence": 1,
      "EN": "There is this beautiful story about a Wish-Granting Machine. They say there is a spot in the center of the Zone where any desires can come true, no matter how bizarre. But you know what? I know for a fact there's lots of ways to kick the bucket in the center of the Zone, and I don't believe in the Wish-Granting Machine anymore. Don't take that risk. I wouldn't.",
      "JA_current": "「願望機」という美しいおとぎ話がある。ゾーンの中心には、どんな途方もない願いでも叶えてくれる場所があるってな。だがな、言わせてもらえば……中心部にあるのは確実にくたばる無数の罠だけだ。俺はもう願望機なんざ信じちゃいない。無駄死にしに行くな。絶対にやめておけ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_volk_info",
          "phrase_id": "211111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    }
  ],
