      "string_id": "osvedomitel_about_agent_phrase_1",
      "occurrence": 1,
      "EN": "I have a case for you about one person.",
      "JA_current": "ある人物について、あんたに相談があるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "osvedomitel_about_agent",
