      "string_id": "barman_room_dialog_phrase_8",
      "occurrence": 1,
      "EN": "You're all obsessed with these artifacts...",
      "JA_current": "どいつもこいつも、アーティファクトのことばかりだな……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_room_dialog",
