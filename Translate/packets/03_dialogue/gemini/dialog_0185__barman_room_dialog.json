      "source_xml_line": 2373,
      "string_id": "barman_room_dialog_phrase_10",
      "occurrence": 1,
      "EN": "Well, then go sleep on some dirty mattress somewhere, doesn't make a difference to me.",
      "JA_current": "ふん、ならその辺の薄汚いマットレスの上で寝腐ってろ。俺の知ったことじゃない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
