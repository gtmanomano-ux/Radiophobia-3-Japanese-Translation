        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_start_51#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1394,
      "string_id": "bar_dolg_leader_start_51",
      "occurrence": 1,
      "EN": "The war with Freedom is coming to an end, Marked One. You played your part in fighting for the cause and now I want to finish this war. I want you to kill the Freedom leader.",
      "JA_current": "フリーダムとの抗争もいよいよ大詰めだ、マークド・ワン。お前は大義のために立派に戦ってくれた。この戦争に終止符を打ちたい。フリーダムのリーダーを始末してくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_start",
          "phrase_id": "51",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_start_81#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1397,
      "string_id": "bar_dolg_leader_start_81",
      "occurrence": 1,
      "EN": "What brings you here, brother? You killed the leader of those Freedom anarchists and their group has crumbled. The war is not over but its outcome is certain. Your achievements are great and they will not be forgotten.",
      "JA_current": "どうした、同志？ フリーダムのアナーキストどものリーダーを討ち取ったおかげで、連中の組織は瓦解した。まだ完全に戦争が終わったわけではないが、勝敗はすでに決したも同然だ。お前の功績は極めて大きい。決して忘れはせん。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_start",
          "phrase_id": "81",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_start_31#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1382,
      "string_id": "bar_dolg_leader_start_31",
      "occurrence": 1,
      "EN": "You brought the grenade launcher?",
      "JA_current": "グレネードランチャーは手に入ったか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
