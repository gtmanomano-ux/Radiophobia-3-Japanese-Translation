      "EN": "What brings you here, brother?",
      "JA_current": "どうした、同志？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_start",
