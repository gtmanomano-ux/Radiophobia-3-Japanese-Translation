      "string_id": "bar_dolg_leader_start_41",
      "occurrence": 1,
      "EN": "What brought you to me, brother?",
      "JA_current": "私に何か用か、同志？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
