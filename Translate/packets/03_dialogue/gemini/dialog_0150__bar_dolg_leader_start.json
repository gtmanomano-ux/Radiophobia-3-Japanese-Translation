    {
      "key": "stable_dialogs_bar:bar_dolg_leader_start_311#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1385,
      "string_id": "bar_dolg_leader_start_311",
      "occurrence": 1,
      "EN": "Yes, here it is.",
      "JA_current": "ああ、これだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_start",
          "phrase_id": "311",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_start_3111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1388,
      "string_id": "bar_dolg_leader_start_3111",
      "occurrence": 1,
      "EN": "Good work, stalker! This is exactly what we need. Well, Marked One, you carried out my request to the letter, and in return you can take this suit as a small sample of our appreciation. I think you'll like it. This is just the tip of the iceberg, our Duty boys always carry the best kit, all paid for by us. This privilege could also extend to you. You've proven yourself to be a capable operator, and we need men like you to do us proud. Therefore, I would like to make you the offer of joining our ranks officially. You'll never want for food, shelter, equipment and good company again, not when you're wearing Duty colors. \\n \\nWhat do you say, stalker? Ready to take the oath? ",
      "JA_current": "見事だ、ストーカー！ まさに求めていたものだ。マークド・ワン、私の個人的な頼みを完璧に果たしてくれたな。感謝の印にこのスーツを受け取ってくれ。気に入るはずだ。だがこれはほんの氷山の一角にすぎん。我がデューティーの隊員たちには、常に最高の装備をすべて組織持ちで支給している。お前が望めば、その特権を手にすることもできるのだ。お前が極めて有能な戦士であることは証明された。我々にはお前のような誇り高き男が必要だ。どうだ、正式にデューティーに加わらないか？ デューティーの軍服を纏えば、二度と食料や寝床、装備や仲間に困ることはないぞ。\\n \\nどうだ、ストーカー？ 誓いを立てる気はあるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_start",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
