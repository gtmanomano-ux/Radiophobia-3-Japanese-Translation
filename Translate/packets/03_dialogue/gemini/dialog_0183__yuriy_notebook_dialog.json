    {
      "key": "stable_dialogs_bar:yuriy_notebook_dialog_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2310,
      "string_id": "yuriy_notebook_dialog_phrase_3",
      "occurrence": 1,
      "EN": "That smart guy wired up an explosive booby-trap in his hiding place. My ears are still ringing!",
      "JA_current": "あの利口な野郎、隠れ家にブービートラップを仕掛けやがった。まだ耳鳴りが止まらないぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_notebook_dialog",
          "phrase_id": "2",
