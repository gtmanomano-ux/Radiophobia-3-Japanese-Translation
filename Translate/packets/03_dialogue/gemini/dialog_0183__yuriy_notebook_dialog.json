      "occurrence": 1,
      "EN": "Hello, Marked One! How's it going?",
      "JA_current": "やあ、マークド・ワン！ 調子はどうだい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_notebook_dialog",
