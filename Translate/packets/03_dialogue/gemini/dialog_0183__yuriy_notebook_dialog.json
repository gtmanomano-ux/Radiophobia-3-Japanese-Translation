        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_notebook_dialog_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2313,
      "string_id": "yuriy_notebook_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Wow, what a gift! Glad you made it, Marked One. Did anything survive the explosion?",
      "JA_current": "おや、とんでもないお出迎えだな！ よく無事だったよ、マークド・ワン。爆発の跡に何か残っていなかったかい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_notebook_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_notebook_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2316,
      "string_id": "yuriy_notebook_dialog_phrase_5",
      "occurrence": 1,
      "EN": "There was this shockproof laptop. It was in a sturdy box, so it remained intact. I couldn't access the data though; it's password-protected.",
      "JA_current": "耐衝撃仕様のノートPCがあった。頑丈なケースに入っていたおかげで無傷だ。だがパスワードで保護されていて、データにアクセスできない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_notebook_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_notebook_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2319,
      "string_id": "yuriy_notebook_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Whatever it is must be valuable for Raven to set up a trap like that. So how can we crack the password? Tell you what: go to the Barkeep, he knows a lot of people here and maybe he can tell you who could help us access a protected laptop or at least get the data out of it.",
      "JA_current": "レイヴンがあれほどの罠を仕掛けていた以上、極めて重要な情報に違いない。さて、どうやってパスワードを解除するかだが……そうだ、バーキープのところへ行ってみてくれ。彼はこの界隈で顔が広い。保護されたノートPCを解析できる人物か、少なくともデータを吸い出せる者を知っているはずだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_notebook_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_notebook_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2322,
      "string_id": "yuriy_notebook_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Okay, I'll go ask.",
      "JA_current": "分かった、聞いてみよう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
