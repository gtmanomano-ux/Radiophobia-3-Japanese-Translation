      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3022,
      "string_id": "arny_teror_dialog_phrase_9",
      "occurrence": 1,
      "EN": "I'm gathering information so that the worst can be prevented.",
      "JA_current": "最悪の事態を防ぐために情報を集めてるだけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
