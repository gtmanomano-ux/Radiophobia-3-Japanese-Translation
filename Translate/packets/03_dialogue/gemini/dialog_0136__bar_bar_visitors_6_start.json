      "incoming": [
        "41"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Let's hope so.",
      "JA_current": "そう願うよ。",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_411#1"
      ]
    },
    {
      "phrase_id": "511",
      "text_id": "bar_bar_visitors_1_start_511",
      "next": [],
