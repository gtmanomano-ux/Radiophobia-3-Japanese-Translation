    },
    {
      "key": "stable_dialogs_bar:bar_bar_visitors_6_start_7111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1163,
      "string_id": "bar_bar_visitors_6_start_7111",
      "occurrence": 1,
      "EN": "Missing stalkers come back from time to time. It's a scary sight, I tell you: they mumble something and reach for their weapons, which they lost somewhere... One came to a Duty outpost some time ago and a crowd gathered to look at him. Someone even recognized him... He was scary... Red eyes, all bloodshot and bruised... Couldn't say a word, just moaned like an animal and went around in circles. Duty took him in, but he died after a couple of days anyway. Something happens to people in the Zone, but what is it?",
      "JA_current": "行方不明になったストーカーが、時々戻ってくるんだ。ひどい有様だよ。何かぶつぶつ言いながら、どこかで失くした武器に手を伸ばす。少し前、デューティーの前哨地に一人現れて、見物人が集まった。そいつを知ってる奴までいたよ……目は充血して真っ赤、全身あざだらけでな。言葉も話せず、獣みたいにうなりながら、同じ所をぐるぐる回ってた。デューティーが保護したが、二日後には死んだ。ゾーンじゃ人間に何かが起きる。だが、いったい何なんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_6_start",
          "phrase_id": "7111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_visitors_6_start_71111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1166,
      "string_id": "bar_bar_visitors_6_start_71111",
      "occurrence": 1,
      "EN": "I'd like to know too.",
      "JA_current": "俺も知りたいよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
