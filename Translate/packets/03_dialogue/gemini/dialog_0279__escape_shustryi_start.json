        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1156,
      "string_id": "escape_shustryi_start_21",
      "occurrence": 1,
      "EN": "Have a safe trip, stalker!",
      "JA_current": "道中気をつけてな、ストーカー！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1144,
      "string_id": "escape_shustryi_start_111",
      "occurrence": 1,
      "EN": "Listen, I need that flash drive you were taking to the trader. Do you have it?",
      "JA_current": "おい、商人に届けるはずだったフラッシュドライブが必要なんだ。持ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_1111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1147,
      "string_id": "escape_shustryi_start_1111",
      "occurrence": 1,
      "EN": "Yeah, I got it... Those morons can't even do a proper search. Well, what the heck, take it! After all, you saved my life. It was well hidden, but these thugs can't frisk for shit.",
      "JA_current": "ああ、持ってるぜ……あの間抜けども、ろくに身体検査もできやしねえんだ。ほら、持っていってくれ！ あんたには命を救ってもらったんだからな。うまく隠してあったとはいえ、あんなチンピラどもに見つけられるはずもないがね。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "1111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_11111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1150,
      "string_id": "escape_shustryi_start_11111",
      "occurrence": 1,
      "EN": "Thanks. Where did you keep it anyway? Who knows, might come in handy.",
      "JA_current": "助かる。ところで、一体どこに隠してたんだ？ 参考までに聞いておきたいな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "11111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1153,
      "string_id": "escape_shustryi_start_111111",
      "occurrence": 1,
      "EN": "I didn't keep it down THERE so don't worry. I've worked Sidor for a long time so I can store information safely! By the way, I told the thugs a nice little story about a cache full of artifacts and they ordered one guy to go there. The cache exists, but it's only got one artifact. I can give you its coordinates if you want.",
      "JA_current": "別に「あんな場所」に突っ込んでたわけじゃないから安心しろよ。シドロヴィッチの下で長く働いてるんだ、情報の安全な隠し場所くらい心得てるさ！ そうそう、チンピラどもにはアーティファクトが山ほど眠る隠し場所の作り話をしてやったんだ。連中、さっそく一人取りに向かわせたぜ。隠し場所自体はあるが、アーティファクトは一つだけだ。あんたが要るなら座標を教えてやるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "111111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_311#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1159,
      "string_id": "escape_shustryi_start_311",
      "occurrence": 1,
      "EN": "Sure, thanks.",
      "JA_current": "ああ、教えてくれ。助かる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "311",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_shustryi_start_3111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1162,
      "string_id": "escape_shustryi_start_3111",
      "occurrence": 1,
      "EN": "But don't forget: there's lots of wild animals there. Besides, the gangster they sent is armed with more than a scoop and a shovel, so be careful. Thanks, man.",
      "JA_current": "だが忘れるなよ、あそこは野獣がうようよいる。それに、送り込まれたバンディットもスコップやシャベルだけじゃなく、しっかり銃で武装してるはずだ。用心しろよ。本当にありがとうな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
