      "source_xml_line": 1141,
      "string_id": "escape_shustryi_start_11",
      "occurrence": 1,
      "EN": "Thanks, brother! You did me a great service! I don't even know how to thank you...",
      "JA_current": "助かったよ、あんた！ 本当に大恩に着るぜ！ 何て礼を言ったらいいか……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_shustryi_start",
