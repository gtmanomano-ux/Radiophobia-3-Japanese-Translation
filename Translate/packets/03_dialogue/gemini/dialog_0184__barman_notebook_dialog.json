      "EN": "Hello, Barkeep. Do you know anything about computers?",
      "JA_current": "バーキープ、あんたコンピューターについて何か知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_notebook_dialog",
