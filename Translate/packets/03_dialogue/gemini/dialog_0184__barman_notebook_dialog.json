      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2334,
      "string_id": "barman_notebook_dialog_phrase_2",
      "occurrence": 1,
      "EN": "I know how to send an email, that's about it. What is it you need?",
      "JA_current": "メールを送るくらいなら分かるが、その程度だな。一体何用だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_notebook_dialog",
