    },
    {
      "key": "stable_dialogs_bar:barman_notebook_dialog_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2337,
      "string_id": "barman_notebook_dialog_phrase_3",
      "occurrence": 1,
      "EN": "I have a locked laptop with encrypted data. You know any computer whiz around the Zone who could decipher it or unlock it?",
      "JA_current": "データが暗号化された、ロック付きのノートPCがあるんだ。このゾーンのどこかに、解読したりロックを解除できるような凄腕の技術者はいないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_notebook_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:barman_notebook_dialog_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2340,
      "string_id": "barman_notebook_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Yeah, actually, I know someone. He's a Freedom fighter, lives in the Army Warehouses, goes by the nickname \"Lucky\". They say he has a talent for computers and other electronic stuff: he fixes PDAs, gadgets, detectors, stuff of that sort. Rumor has it that he once managed to build some kind of device that intercepted and decrypted radio chatter between Duty's commanders.",
      "JA_current": "ああ、実は一人心当たりがあるぞ。フリーダムの連中で、軍事倉庫を拠点にしてる「ラッキー」って通称の男だ。コンピューターや電子機器の扱いに長けててな。PDAやガジェット、検出器なんかの修理もお手の物らしい。噂じゃ、デューティー幹部たちの無線通信を傍受して暗号を解読する装置まで自作したって話だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_notebook_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:barman_notebook_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2343,
      "string_id": "barman_notebook_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Thanks for the information, I will go to him.",
      "JA_current": "情報をありがとう。そいつのところへ行ってみるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
