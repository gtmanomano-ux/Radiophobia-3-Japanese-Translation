      "source_xml_line": 2125,
      "string_id": "otshel_hello_dialog_phrase_6",
      "occurrence": 1,
      "EN": "I'm not after any money! Calm down, bro..",
      "JA_current": "金なんか狙っちゃいない！ 落ち着けって……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "otshel_hello_dialog",
