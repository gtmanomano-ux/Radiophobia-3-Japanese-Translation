    {
      "key": "stable_dialogs_bar:otshel_hello_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2122,
      "string_id": "otshel_hello_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Oh yeah?? They sent you after the money, didn't they? Well, make your move, fucker!!",
      "JA_current": "嘘つけ！ 連中から金の取り立てを頼まれたんだろ！？ やる気なら受けて立つぞ、クソッタレめ！！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "otshel_hello_dialog",
