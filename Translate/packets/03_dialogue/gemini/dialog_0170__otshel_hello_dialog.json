    {
      "key": "stable_dialogs_bar:otshel_hello_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2128,
      "string_id": "otshel_hello_dialog_phrase_7",
      "occurrence": 1,
      "EN": "For fuck's sake, sorry.. I'm so sick of this, man... Those fucking racketeers... There's all kinds of scumbags around here eager to fleece the working man...",
      "JA_current": "くそっ……す、すまない……もうノイローゼになりそうでね……あの忌々しい取り立て屋どもめ……ここらには真面目に働く人間から金を巻き上げようとするクズばかりだ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
