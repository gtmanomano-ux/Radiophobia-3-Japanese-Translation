  "entries": [
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_11#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 914,
      "string_id": "escape_lager_leader_hello_11",
      "occurrence": 1,
      "EN": "Listen up, Marked One, you will come in handy! We could really use some help.",
      "JA_current": "なあ、マークド・ワン、いいところに来てくれた！ ぜひ手を貸してほしいんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 944,
      "string_id": "escape_lager_leader_hello_21",
      "occurrence": 1,
      "EN": "Waiting for these boy scouts. I got a feeling they're just around the corner.",
      "JA_current": "例の連中のお出ましを待ってるところだ。そろそろ現れるはずだぜ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_31#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 947,
      "string_id": "escape_lager_leader_hello_31",
      "occurrence": 1,
      "EN": "You're a real killer, Marked One! I wouldn't want to stand in your way. Ever!",
      "JA_current": "マークド・ワン、とんでもない男だな！ お前だけは絶対に敵に回したくないぜ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_41#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 956,
      "string_id": "escape_lager_leader_hello_41",
      "occurrence": 1,
      "EN": "Hey, Marked One, great to see you!",
      "JA_current": "よう、マークド・ワン！ 会えて嬉しいぜ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 917,
      "string_id": "escape_lager_leader_hello_111",
      "occurrence": 1,
      "EN": "Go on.",
      "JA_current": "続けてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_311#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 950,
      "string_id": "escape_lager_leader_hello_311",
      "occurrence": 1,
      "EN": "Yup, something like that.",
      "JA_current": "まあな、そんなところだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "311",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_411#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 959,
      "string_id": "escape_lager_leader_hello_411",
      "occurrence": 1,
      "EN": "Hello to you, too.",
      "JA_current": "ああ、元気そうだな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "411",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_412#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 962,
      "string_id": "escape_lager_leader_hello_412",
      "occurrence": 1,
      "EN": "By the way, where did Wolf go?",
      "JA_current": "ところで、ウルフはどこへ行ったんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "412",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_1111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 920,
      "string_id": "escape_lager_leader_hello_1111",
      "occurrence": 1,
      "EN": "I'm Fanatic, and I'm filling in as the leader around here since Wolf left. A few Mercs came by here yesterday... and they were some tough bastards, let me tell you. They come here and start making serious demands - \"You've got one day to clear this camp out. It's gonna be our new base.\" Tonight they're coming back, and as you can imagine, they won't be in the mood for a chat.",
      "JA_current": "俺はファナティック。ウルフが出ていってから、ここでリーダー代わりを務めてる。昨日、マーセナリーズが何人か乗り込んできてな……クソッ、筋金入りの手強い連中だ。いきなり「キャンプを明け渡せ。一日やるから出ていけ、ここは俺たちの新拠点にする」なんて要求を突きつけてきやがった。今夜、連中が戻ってくる。当然、ただの話し合いで済むはずもない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "1111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_3111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 953,
      "string_id": "escape_lager_leader_hello_3111",
      "occurrence": 1,
      "EN": "Here, I hope you won't forget about us. And by the way... a million thanks for the help. We saved the young ones, Marked One.",
      "JA_current": "ほら、俺たちからの礼だ、取っておいてくれ。\nそれと……本当に助かった、感謝してもしきれんよ。若い連中を救えたのはお前のおかげだ、マークド・ワン。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_4121#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 965,
      "string_id": "escape_lager_leader_hello_4121",
      "occurrence": 1,
      "EN": "Oh, he got a message from a stalker who was passing by. He packed his things, grabbed a box of dynamite and went deep in the Zone. I came to the Cordon to rest up and recover from some bad wounds so he asked me to look after the kids.",
      "JA_current": "ああ、通りがかったストーカーから何か伝言を受け取ってな。すぐに荷物をまとめて、ダイナマイトの木箱を抱えてゾーンの奥へと向かっちまったよ。俺は傷の治療でコルドンに戻って休んでたところだったから、あいつから若い奴らの面倒を見てくれと頼まれたんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "4121",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_11111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 923,
      "string_id": "escape_lager_leader_hello_11111",
      "occurrence": 1,
      "EN": "So, what are you going to do?",
      "JA_current": "それで、どうするつもりなんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "11111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 926,
      "string_id": "escape_lager_leader_hello_111111",
      "occurrence": 1,
      "EN": "We're gonna set up an ambush 'cause a direct attack would probably be the end of us. They've got the fighting gear and everything, plus they're trained in tactics like you can't even imagine. And all we've got here are little boys. So, we've decided to just sit tight in these houses and make it look like we're gone. Then when the right moment comes, we attack. Fighters like you are just the thing we could use right now. And we'd make sure to thank you properly after it's all over. You know we're good for it! So, what do you say, will you help us out?",
      "JA_current": "待ち伏せを仕掛けることにした。正面から撃ち合ったらひとたまりもないからな。奴らは装備も万全だし、戦術も叩き込まれてる。こっちはまだひよっこばかりだ。だから家の中に息を潜めて、村を放棄したように見せかける。頃合いを見計らって一斉に叩く作戦だ。今はお前のような腕利きがどうしても必要なんだ。終わったらきっちり礼は弾む、約束は違えない！ どうだ、手を貸してくれるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "111111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_1111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 929,
      "string_id": "escape_lager_leader_hello_1111111",
      "occurrence": 1,
      "EN": "I will.",
      "JA_current": "いいだろう、手を貸そう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "1111111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_1111112#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 938,
      "string_id": "escape_lager_leader_hello_1111112",
      "occurrence": 1,
      "EN": "No, I'm not ready yet.",
      "JA_current": "いや、まだ準備ができてない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "1111112",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_11111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 932,
      "string_id": "escape_lager_leader_hello_11111111",
      "occurrence": 1,
      "EN": "Let's spend the rest of the time preparing for the fight. Here's the plan: I'll put the most hopeless rookies in houses and basements and tell them not to make a move - otherwise they'll just get in the way and might even slaughter each other by accident. You and me and a couple other decent shots will take the best positions to have an eye on the area around the fire. As soon as they come close to the fire, we let the bullets fly from everywhere! They'll be coming from the bridge... and I don't think we'll have to wait long. So, find yourself a hiding place with a view, then wait for my command. Take a look around, but remember that your odds aren't as good in the open. It's your call.",
      "JA_current": "残された時間で戦闘準備を整えよう。作戦を伝えるぞ。一番頼りない新米どもは家や地下室に押し込んで、頭一つ出すなと言い含めておく。無駄死にさせたくないし、混乱して同士討ちでもされたらたまらんからな。お前と俺、それに少しは撃てる連中で、焚き火の広場を取り囲む射撃ポイントを陣取る。奴らが焚き火に近づいた瞬間、四方から一斉に蜂の巣にしてやるんだ！ 橋のほうから現れるはずだ……もうすぐ来るだろう。視界が効く遮蔽物を見つけて、俺の合図を待て。開けた場所に突っ立ってちゃ生き残れんぞ。健闘を祈る。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "11111111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_11111121#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 941,
      "string_id": "escape_lager_leader_hello_11111121",
      "occurrence": 1,
      "EN": "That's a shame. We could really use a fighter like you. I guess we'll have to do it on our own...",
      "JA_current": "そうか、残念だ。お前のような男がいてくれたら心強かったんだが……仕方ない、俺たちだけでやるしかないな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_leader_hello",
          "phrase_id": "11111121",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_leader_hello_111111111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 935,
      "string_id": "escape_lager_leader_hello_111111111",
      "occurrence": 1,
      "EN": "OK.",
      "JA_current": "了解した。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
