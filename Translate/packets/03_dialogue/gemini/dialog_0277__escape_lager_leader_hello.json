      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Listen up, Marked One, you will come in handy! We could really use some help.",
      "JA_current": "聞いてくれ、Marked One、力になってくれ！ 俺たちを助けて欲しい。",
      "string_entry_candidates": [
        "stable_dialogs_escape:escape_lager_leader_hello_11#1"
