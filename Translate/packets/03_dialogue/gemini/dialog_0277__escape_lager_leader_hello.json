        "stable_dialogs_escape:escape_lager_leader_hello_411#1"
      ]
    },
    {
      "phrase_id": "412",
      "text_id": "escape_lager_leader_hello_412",
      "next": [
        "4121"
      ],
      "conditions": [],
      "effects": [],
