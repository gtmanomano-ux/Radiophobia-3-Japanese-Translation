      "string_id": "bar_bar_visitors_9_start_711",
      "occurrence": 1,
      "EN": "What did you hear?",
      "JA_current": "何か聞いたか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
