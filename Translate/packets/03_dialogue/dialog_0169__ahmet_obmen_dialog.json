      "source_xml_line": 2043,
      "string_id": "ahmet_obmen_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Okay, what did you bring? \\n \\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x18 PBM: %c[0,170,170,170]Jellyfish\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x19 JHP: %c[0,170,170,170]Stone Blood\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]45ACP Hydro: %c[0,170,170,170]Thorn\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.45x39mm 7N22: %c[0,170,170,170]Stone Flower\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.56x45mm NATO SS190: %c[0,170,170,170]Gravi\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x54mm 7N13: %c[0,170,170,170]Fireball\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x51mm NATO BP: %c[0,170,170,170]Crystal Thorn\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x39 SP-6: %c[0,170,170,170]Slug\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]VOG-25 (2x), M-209 (2x): %c[0,170,170,170]Night Star\n\t\t",
      "JA_current": "Okay, what did you bring? \\n \\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x18 PBM: %c[0,170,170,170]Jellyfish\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x19 JHP: %c[0,170,170,170]Stone Blood\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]45ACP Hydro: %c[0,170,170,170]Thorn\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.45x39mm 7N22: %c[0,170,170,170]Stone Flower\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.56x45mm NATO SS190: %c[0,170,170,170]Gravi\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x54mm 7N13: %c[0,170,170,170]Fireball\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x51mm NATO BP: %c[0,170,170,170]Crystal Thorn\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x39 SP-6: %c[0,170,170,170]Slug\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]VOG-25 (2x), M-209 (2x): %c[0,170,170,170]Night Star\n\t\t",
      "JA_new": "分かった。何を持ってきた？ \\n \\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x18 PBM: %c[0,170,170,170]ジェリーフィッシュ\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x19 JHP: %c[0,170,170,170]ストーンブラッド\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]45ACP Hydro: %c[0,170,170,170]ソーン\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.45x39mm 7N22: %c[0,170,170,170]ストーンフラワー\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]5.56x45mm NATO SS190: %c[0,170,170,170]グラビ\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x54mm 7N13: %c[0,170,170,170]ファイアボール\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]7.62x51mm NATO BP: %c[0,170,170,170]クリスタルソーン\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]9x39 SP-6: %c[0,170,170,170]スラッグ\\n\n\t\t%c[0,0,255,255] • %c[0,255,255,255]VOG-25 (2x), M-209 (2x): %c[0,170,170,170]ナイトスター\n\t\t",
