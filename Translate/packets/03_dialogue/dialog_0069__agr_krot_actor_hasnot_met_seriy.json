    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_100#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 60,
      "string_id": "agr_krot_actor_hasnot_met_seriy_100",
      "occurrence": 1,
      "EN": "Me and my boys found a nice little area full of artifacts but those army bastards attacked us for some reason. I don't know what the hell they wanted from us...",
      "JA_current": "俺たちはアーティファクトで一杯のイカした場所を見つけたんだが、Army のクソ野郎どもが、なぜか攻撃してきやがるんだ。あいつら俺たちに何か恨みでもあんのか…。",
      "JA_new": "俺たちでアーティファクトが山ほどある場所を見つけたんだが、軍のクソ野郎どもに襲われた。何が狙いだったのかさっぱりだ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "100",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "1001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_3500#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 75,
      "string_id": "agr_krot_actor_hasnot_met_seriy_3500",
      "occurrence": 1,
      "EN": "If you lied to me, I'll find you and finish what the soldiers couldn't!",
      "JA_current": "もしデタラメだったら、アンタに Army どもが出来なかったことをやってやるぜ？",
      "JA_new": "嘘だったら、俺が見つけ出して、兵隊ができなかったことをやってやる！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "3500",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "35001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_400#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 78,
      "string_id": "agr_krot_actor_hasnot_met_seriy_400",
      "occurrence": 1,
      "EN": "I'm not lying. I know that nobody trusts anyone here so you have little choice.",
      "JA_current": "嘘なんかじゃないさ。だがここじゃ誰も信じられないからな… まぁお前の好きにすればいいさ。やるべきことは分かってんだろ？",
      "JA_new": "嘘じゃない。この辺じゃ誰も誰も信用しないのは分かってる。あんたには信じるしかないだろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "400",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "4001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_200#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 63,
      "string_id": "agr_krot_actor_hasnot_met_seriy_200",
      "occurrence": 1,
      "EN": "Yeah, I've heard about him. I think he used to \"make his living\" in this area - it's quite a good place, actually. He left a long time ago; I don't know when it was exactly and I've got no clue where he was headed. That's everything I can tell you.",
      "JA_current": "ああ、名前は聞いたことがあるぜ。ここいらを根城にしていたらしい。確かに悪くねぇ場所さ。だがヤツはだいぶ前に、ここを離れた。それがいつか、どこへ行ったか、俺は見当もつかん。知ってるのはそれだけだ。",
      "JA_new": "ああ、そいつの話は聞いたことがある。この辺で「稼いで」たらしい。なかなかいい場所だったよ。ずいぶん前にいなくなったが、いつだったかも、どこへ向かったかも分からない。話せるのはそれだけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "200",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "2001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_2000#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 66,
      "string_id": "agr_krot_actor_hasnot_met_seriy_2000",
      "occurrence": 1,
      "EN": "You weren't waiting here for no reason, were you? Otherwise why would the Spetsnaz show up here?",
      "JA_current": "スペツナズが湧いて出て来るのに、なぜここで待ってなかったんだい？",
      "JA_new": "こんな所で待ち伏せしてたのには、理由があるんだろ？ そうでなきゃ、スペツナズが来るわけない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "2000",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "20001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_250#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 69,
      "string_id": "agr_krot_actor_hasnot_met_seriy_250",
      "occurrence": 1,
      "EN": "OK, I know something about Strelok.",
      "JA_current": "ああ、Strelok のことは知ってるよ。",
      "JA_new": "よし、ストレロクのことなら知ってる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
          "phrase_id": "250",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        },
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "2501",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_hasnot_met_seriy_2500#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 72,
      "string_id": "agr_krot_actor_hasnot_met_seriy_2500",
      "occurrence": 1,
      "EN": "Yeah? I really need to know that!",
      "JA_current": "本当か？ 教えてくれ！",
      "JA_new": "本当か？ そいつのことを知りたいんだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
