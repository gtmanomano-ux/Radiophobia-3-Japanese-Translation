      "string_id": "agr_krot_actor_hasnot_met_seriy_0",
      "occurrence": 1,
      "EN": "What's going on?",
      "JA_current": "ここで何をやってんだい？",
      "JA_new": "何があった？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_krot_actor_hasnot_met_seriy",
