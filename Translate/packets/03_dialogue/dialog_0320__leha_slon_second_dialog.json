  "entries": [
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_1#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2519,
      "string_id": "leha_slon_second_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Listen, I went to the military at the roadblock... Their commander wants a whole million rubles for the release of your brother. He gave me a limit of two days, after which he says he'll have him executed.",
      "JA_current": "Listen, I went to the military at the roadblock... Their commander wants a whole million rubles for the release of your brother. He gave me a limit of two days, after which he says he'll have him executed.",
      "JA_new": "聞いてくれ。検問所の軍に会ってきた。弟を解放するのに、司令官は100万ルーブルを要求してる。期限は二日だ。それまでに払わなければ、弟を処刑すると言ってた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2522,
      "string_id": "leha_slon_second_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Where the hell am I going to get so much? This is fucked! Listen, help me out, will you? Lend me at least half a mil, and I'll somehow pick up the rest myself. A man is gonna get killed here, help me out!",
      "JA_current": "Where the hell am I going to get so much? This is fucked! Listen, help me out, will you? Lend me at least half a mil, and I'll somehow pick up the rest myself. A man is gonna get killed here, help me out!",
      "JA_new": "そんな大金、どこで用意しろってんだ？ くそっ！ 頼む、助けてくれ。せめて50万貸してくれ。残りは何とか自分で工面する。弟が殺されちまうんだ。助けてくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2525,
      "string_id": "leha_slon_second_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Okay, I'll try to raise the necessary amount of money. How much money do you have now?",
      "JA_current": "Okay, I'll try to raise the necessary amount of money. How much money do you have now?",
      "JA_new": "分かった。必要な金を工面してみる。今いくら持ってる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_4#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2528,
      "string_id": "leha_slon_second_dialog_phrase_4",
      "occurrence": 1,
      "EN": "This is too much. This is your problem, you deal with it yourself.",
      "JA_current": "This is too much. This is your problem, you deal with it yourself.",
      "JA_new": "高すぎる。自分の問題だろ。自分で何とかしろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2531,
      "string_id": "leha_slon_second_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Well, thank you, man! Here, I have three hundred thousand, there you go. Now all that's left to do is raise another seven hundred grand. I'll pull all my connections and acquaintances, and in the meantime, try to raise at least half a million, okay?",
      "JA_current": "Well, thank you, man! Here, I have three hundred thousand, there you go. Now all that's left to do is raise another seven hundred grand. I'll pull all my connections and acquaintances, and in the meantime, try to raise at least half a million, okay?",
      "JA_new": "助かるよ！ ほら、俺の手元には30万ある。残りは70万だ。俺も伝手をたどって金を集める。その間に、せめて50万は用意してくれ。頼む。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:leha_slon_second_dialog_phrase_7#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2537,
      "string_id": "leha_slon_second_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Jeez, man, that's really ice cold, leaving someone to die like that! I thought you were an honest guy...",
      "JA_current": "Jeez, man, that's really ice cold, leaving someone to die like that! I thought you were an honest guy...",
      "JA_new": "ああ、冷たい奴だな。人が死ぬのを見捨てるなんて！ 誠実な人間だと思ってたのに……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "leha_slon_second_dialog",
