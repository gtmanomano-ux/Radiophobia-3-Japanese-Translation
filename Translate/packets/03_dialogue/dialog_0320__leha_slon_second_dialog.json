      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2540,
      "string_id": "leha_slon_second_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Don't talk to me about honesty here, and give me the artifact you stole!",
      "JA_current": "Don't talk to me about honesty here, and give me the artifact you stole!",
      "JA_new": "誠実さなんて持ち出すな。盗んだアーティファクトを返せ！",
