      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 656,
      "string_id": "mil_guard_arsenal_dialog_2002",
      "occurrence": 1,
      "EN": "Don't sweat it, it's nothing terrible. The lock is jammed, that's all. If you really can't wait, just shoot it to pieces, I'll replace it later.",
      "JA_current": "気にすんな、大したことじゃない。錠が詰まっている、それだけだ。どうしても待てないなら、撃ってバラバラにしちまえばいい。後で交換するよ。",
      "JA_new": "気にするな、大したことじゃない。鍵が壊れてるだけだ。急ぐなら撃って壊せばいい。後で俺が交換しておく。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_guard_arsenal_dialog",
