      "string_id": "mil_patrol_dialog1_0",
      "occurrence": 1,
      "EN": "Man, you're in the Freedom base! Relax, make yourself at home!",
      "JA_current": "Freedom の基地にようこそってか！ 家のようにくつろいでくれよな！",
      "JA_new": "ここはフリーダムの基地だ。くつろいでけよ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
