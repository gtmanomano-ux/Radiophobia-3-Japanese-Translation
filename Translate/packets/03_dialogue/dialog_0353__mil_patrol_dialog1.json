    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog1_2#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1083,
      "string_id": "mil_patrol_dialog1_2",
      "occurrence": 1,
      "EN": "Behave, OK? Got it? Try fooling around and you'll be sorry. We had a slow-witted one here once; he pissed everyone off so bad that we made him take a hike on the minefield - naked. You should have heard Skinflint cursing when that dude's arm fell square on his head! That was something special... yeah... So, you got the idea?",
      "JA_current": "行儀よくな、いいか？ 分かったか？ うろうろすれば、後悔することになるだろう。以前ここに、頭の鈍いヤツがいた； 地雷原を歩かせたこともある ― 素っ裸でだ、そんぐらいひどく皆をイライラさせた。その場にいれば、頭に腕を乗せられて、Skinflint が罵っているのを聞いたはずだ！ あれは特別な何かだった… そう… で、何か思い至ったのか？",
      "JA_new": "いいか、行儀よくしろよ。分かったか？ふざけた真似をしたら後悔するぞ。前に頭の鈍い奴がいてな。皆を怒らせるもんだから、地雷原を裸で歩かせたんだ。あいつの腕が頭に落ちてきた時の、スキンフリントの悪態ときたら！最高だった……ああ……分かったな？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog1",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog1_3#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1086,
      "string_id": "mil_patrol_dialog1_3",
      "occurrence": 1,
      "EN": "Gotcha.",
      "JA_current": "分かった。",
      "JA_new": "分かったよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog1",
