      "string_id": "mil_patrol_dialog1_1",
      "occurrence": 1,
      "EN": "I see.",
      "JA_current": "わかった。",
      "JA_new": "そうか。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
