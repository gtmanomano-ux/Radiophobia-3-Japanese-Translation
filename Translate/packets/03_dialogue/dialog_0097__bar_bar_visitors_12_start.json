      "occurrence": 1,
      "EN": "What do you want?",
      "JA_current": "何だい？",
      "JA_new": "何の用だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_12_start",
