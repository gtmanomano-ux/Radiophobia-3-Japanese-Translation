        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3058,
      "string_id": "sufferot_start_dialog_phrase_2",
      "occurrence": 1,
      "EN": "There you are! Bin Laden, I presume?",
      "JA_current": "There you are! Bin Laden, I presume?",
      "JA_new": "いたな！ビンラディンってあんたか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
