      "string_id": "sufferot_start_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Aah! W-Who are you?!",
      "JA_current": "Aah! W-Who are you?!",
      "JA_new": "うわっ！だ、誰だ！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "0",
