        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3061,
      "string_id": "sufferot_start_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Don't shoot, don't shoot!",
      "JA_current": "Don't shoot, don't shoot!",
      "JA_new": "撃たないでくれ、撃たないで！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_4#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3064,
      "string_id": "sufferot_start_dialog_phrase_4",
      "occurrence": 1,
      "EN": "I won't shoot if you deactivate the bombs and give me the detonators.",
      "JA_current": "I won't shoot if you deactivate the bombs and give me the detonators.",
      "JA_new": "爆弾を解除して起爆装置を渡せ。そうすれば撃たない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3067,
      "string_id": "sufferot_start_dialog_phrase_5",
      "occurrence": 1,
      "EN": "I can't... There were no detonators, I set it all up to work on a timer in case something happened to me. I set it to go off in about six days, so now it's a lot less...",
      "JA_current": "I can't... There were no detonators, I set it all up to work on a timer in case something happened to me. I set it to go off in about six days, so now it's a lot less...",
      "JA_new": "できない……起爆装置はないんだ。万一に備えてタイマー式にした。あと6日くらいで爆発するように……だから、もう残り時間が……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3070,
      "string_id": "sufferot_start_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Can the charges themselves be disarmed?",
      "JA_current": "Can the charges themselves be disarmed?",
      "JA_new": "爆弾そのものは解除できるのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3073,
      "string_id": "sufferot_start_dialog_phrase_7",
      "occurrence": 1,
      "EN": "They can... I- I can give you the locations and all you need to do is pull out the cables.",
      "JA_current": "They can... I- I can give you the locations and all you need to do is pull out the cables.",
      "JA_new": "できる……場所を教えるから、あとはケーブルを引き抜いてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_8#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3076,
      "string_id": "sufferot_start_dialog_phrase_8",
      "occurrence": 1,
      "EN": "How many charges are there and where did you hide them? I need specifics...",
      "JA_current": "How many charges are there and where did you hide them? I need specifics...",
      "JA_new": "爆弾はいくつある？隠した場所も具体的に話せ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_9#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3079,
      "string_id": "sufferot_start_dialog_phrase_9",
      "occurrence": 1,
      "EN": "There are a total of four bombs. One is located at the Duty base, one in the Bar, one near the Arena, and one more in one of the hangars where the stalkers live.",
      "JA_current": "There are a total of four bombs. One is located at the Duty base, one in the Bar, one near the Arena, and one more in one of the hangars where the stalkers live.",
      "JA_new": "全部で4つだ。デューティーの基地に1つ、ロストクに1つ、アリーナの近くに1つ。それと、ストーカーたちが寝泊まりしてる格納庫のどこかにもう1つ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:sufferot_start_dialog_phrase_10#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3082,
      "string_id": "sufferot_start_dialog_phrase_10",
      "occurrence": 1,
      "EN": "I'll be right back. Meanwhile, you wait here and start thinking about what you'll tell General Voronin when he brings you in for what you've done.",
      "JA_current": "I'll be right back. Meanwhile, you wait here and start thinking about what you'll tell General Voronin when he brings you in for what you've done.",
      "JA_new": "すぐ戻る。それまでここで待ってろ。ヴォロニン将軍に連行されたら、何て説明するか考えておけ。自分が何をしたのか、な。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sufferot_start_dialog",
