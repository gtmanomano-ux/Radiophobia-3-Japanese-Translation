  "entries": [
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1001#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 554,
      "string_id": "mil_freedom_commander_1001",
      "occurrence": 1,
      "EN": "What's up, stalker! You're just in time. We're defending against Monolith jerks, and the next wave is about to arrive! Believe it or not, we just had our last sniper knocked off! Can you help? We'll pay back after the fight - you won't be sorry!",
      "JA_current": "よおストーカー。いいところに来た。今モノリス信者の急襲を防衛していて、次の襲撃がもうすぐなんだ。こんなことを行っても信じないだろうが、ちょうど最後のスナイパーがやられたとこなんだ。助けてくれないか？ 戦闘の後ちゃんと礼はする、後悔はさせんよ！",
      "JA_new": "よお、ストーカー！ちょうどいいところに来たな。今、モノリスのクズどもを防いでる。次の襲撃がすぐそこだ！信じられないだろうが、最後の狙撃手までやられちまった。手を貸してくれないか？戦いが済んだら礼はする。損はさせないぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_10011#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 557,
      "string_id": "mil_freedom_commander_10011",
      "occurrence": 1,
      "EN": "No, I cannot help you.",
      "JA_current": "いいや、あんたを助けられない。",
      "JA_new": "悪いが、手は貸せない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_10012#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 560,
      "string_id": "mil_freedom_commander_10012",
      "occurrence": 1,
      "EN": "That's too bad. Come back if you change your mind.",
      "JA_current": "それは残念だ。もし気が変わったら戻ってきな。",
      "JA_new": "そいつは残念だ。気が変わったら戻ってきてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1002#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 563,
      "string_id": "mil_freedom_commander_1002",
      "occurrence": 1,
      "EN": "I will.",
      "JA_current": "そうするよ。",
      "JA_new": "分かった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1003#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 566,
      "string_id": "mil_freedom_commander_1003",
      "occurrence": 1,
      "EN": "Great! Go to the tower, there's a sniper rifle and a bunch of ammo. Pick them off from above and don't come down, or you run the risk of getting it from our own guys. Is the assignment clear?",
      "JA_current": "いいぞ！ 櫓へ登れ、スナイパーライフルとたくさんの弾薬があるぞ。上でそれらを手に入れたら下へは降りるな、さもないと仲間の兵に撃たれる危険がある。以上、分かったか？",
      "JA_new": "よし！塔へ行け。狙撃銃と弾薬が置いてある。上から敵を撃て。下へ降りるなよ。味方に撃たれる危険がある。指示は分かったか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_4001#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 605,
      "string_id": "mil_freedom_commander_4001",
      "occurrence": 1,
      "EN": "Hey, Marked One! Did Lukash send you?",
      "JA_current": "やぁ、Marked One！ Lukash がよこしたのか？",
      "JA_new": "よお、マークド・ワン！ルカシュに頼まれて来たのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_4002#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 608,
      "string_id": "mil_freedom_commander_4002",
      "occurrence": 1,
      "EN": "Yes. He asked me to help you.",
      "JA_current": "ああ、奴があんたを助けるようにってな。",
      "JA_new": "ああ。あんたを助けるよう頼まれた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_5001#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 614,
      "string_id": "mil_freedom_commander_5001",
      "occurrence": 1,
      "EN": "Looks like we took them all down. I say that's enough for today. Thanks for your help! Here, take this - a little bit of money to cheer you up.",
      "JA_current": "敵を全員やっつけたようだな。今日のところは十分だ。協力に感謝する。これは謝礼だ。受け取ってくれ。",
      "JA_new": "敵は全員片づいたようだな。今日はここまででいいだろう。助かったよ！ほら、礼だ。少しだが受け取ってくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_5002#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 617,
      "string_id": "mil_freedom_commander_5002",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "JA_new": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_5003#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 620,
      "string_id": "mil_freedom_commander_5003",
      "occurrence": 1,
      "EN": "Good luck, Marked One.",
      "JA_current": "Marked One、幸運を祈る！",
      "JA_new": "幸運を祈る、マークド・ワン。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_hunter_dialog_502#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 716,
      "string_id": "mil_hunter_dialog_502",
      "occurrence": 1,
      "EN": "Just looking around.",
      "JA_current": "周りを見てみな。",
      "JA_new": "ちょっと見て回ってるだけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_hunter_dialog_503#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 719,
      "string_id": "mil_hunter_dialog_503",
      "occurrence": 1,
      "EN": "Was this the best place you could find? This is probably the shittiest spot in the whole Zone...",
      "JA_current": "見た中で最良の場所だったのか？ ここは多分、ゾーン全体の中で最も不快なスポットだ…。",
      "JA_new": "ここが一番マシな場所だったのか？ゾーンで最悪の場所だろ、ここ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_max_dialog_400522#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1029,
      "string_id": "mil_max_dialog_400522",
      "occurrence": 1,
      "EN": "Got any ammo for it?",
      "JA_current": "この銃の弾、何かもらえるか？",
      "JA_new": "この銃の弾はあるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:mil_max_dialog_400523#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1032,
      "string_id": "mil_max_dialog_400523",
      "occurrence": 1,
      "EN": "Just what's in the magazine. Sorry, that's all I got. Go see Skinflint, he might have some.",
      "JA_current": "そのマガジンに入ってる。悪いな、それが俺の持ってる全部だ。Skinflint に会いに行けよ、いくらか持ってるかも知れない。",
      "JA_new": "マガジンに入ってる分だけだ。悪いな、それしかない。ケチンボのところへ行ってみろ。持ってるかもしれない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_5#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1592,
      "string_id": "shurup_car_trade_5",
      "occurrence": 1,
      "EN": "No, thanks, I'll take a walk and a breath of fresh air.",
      "JA_current": "No, thanks, I'll take a walk and a breath of fresh air.",
      "JA_new": "いや、いい。散歩でもして外の空気を吸ってくる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_6#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1595,
      "string_id": "shurup_car_trade_6",
      "occurrence": 1,
      "EN": "Sorry, man, I've changed my mind. I don't need the car.",
      "JA_current": "Sorry, man, I've changed my mind. I don't need the car.",
      "JA_new": "悪いな、気が変わった。車はいらない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_7#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1598,
      "string_id": "shurup_car_trade_7",
      "occurrence": 1,
      "EN": "I'm sorry too, dude, but the car's being delivered now. So, I'm not giving the money back, but I'll assist you with the matter.",
      "JA_current": "I'm sorry too, dude, but the car's being delivered now. So, I'm not giving the money back, but I'll assist you with the matter.",
      "JA_new": "こっちも悪いが、もう車を手配しちまった。金は返せないが、何とかしてやるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_8#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1601,
      "string_id": "shurup_car_trade_8",
      "occurrence": 1,
      "EN": "Ah... To hell with that, let's have a drink.",
      "JA_current": "Ah... To hell with that, let's have a drink.",
      "JA_new": "ああ……もういいや。飲みに行こう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_2#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1605,
      "string_id": "shurup_car_trade_2",
      "occurrence": 1,
      "EN": "Just bring it here, I'll drive to wherever I need.",
      "JA_current": "Just bring it here, I'll drive to wherever I need.",
      "JA_new": "ここに持ってきてくれ。あとは必要な場所まで自分で運転する。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_21#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1608,
      "string_id": "shurup_car_trade_21",
      "occurrence": 1,
      "EN": "Ok then, just take our \"draught horse\" on the way out. For 10'000 only. I'll fix a new one later...",
      "JA_current": "Ok then, just take our \"draught horse\" on the way out. For 10'000 only. I'll fix a new one later...",
      "JA_new": "分かった。それじゃ出るときに、うちの「働き馬」を持っていけ。たった1万ルーブルだ。あとで新しいのを調達するよ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_22#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1611,
      "string_id": "shurup_car_trade_22",
      "occurrence": 1,
      "EN": "Alright, let's check if you are Mr-Fix-It indeed.",
      "JA_current": "Alright, let's check if you are Mr-Fix-It indeed.",
      "JA_new": "よし、本当に何でも直せるのか見せてもらおう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_3#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1614,
      "string_id": "shurup_car_trade_3",
      "occurrence": 1,
      "EN": "Somewhere closer to the stalkers' camp.",
      "JA_current": "Somewhere closer to the stalkers' camp.",
      "JA_new": "ストーカーのキャンプに近いところがいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_31#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1617,
      "string_id": "shurup_car_trade_31",
      "occurrence": 1,
      "EN": "Ha... Ok... I can arrange a \"Moskvich\". 20 grand - and it's all yours. In the bloodsuckers village. You can have yourself a Zone safari, a little drive'n'hunt, ha-ha! Damn, why am I not marketing this to the outside yet!?",
      "JA_current": "Ha... Ok... I can arrange a \"Moskvich\". 20 grand - and it's all yours. In the bloodsuckers village. You can have yourself a Zone safari, a little drive'n'hunt, ha-ha! Damn, why am I not marketing this to the outside yet!?",
      "JA_new": "はは……よし……「モスクヴィッチ」を手配してやる。2万ルーブルでお前のものだ。ブラッドサッカーの村に置くぞ。ゾーンをサファリ気分でドライブして狩りもできる。ははっ！くそっ、まだ外の連中に宣伝してなかったな！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_32#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1620,
      "string_id": "shurup_car_trade_32",
      "occurrence": 1,
      "EN": "Wow! A \"Moskvich\"! I like that!!!",
      "JA_current": "Wow! A \"Moskvich\"! I like that!!!",
      "JA_new": "すげえ、「モスクヴィッチ」か！気に入った！！！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_4#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1624,
      "string_id": "shurup_car_trade_4",
      "occurrence": 1,
      "EN": "Let it be at around the scorcher.",
      "JA_current": "Let it be at around the scorcher.",
      "JA_new": "ブレイン・スコーチャーの近くがいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_41#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1627,
      "string_id": "shurup_car_trade_41",
      "occurrence": 1,
      "EN": "18'000 rubles. The devil knows what this car is, but it's yours. It will be waiting for you by the Monolith fanatics' roadblock. Best quality service, see?",
      "JA_current": "18'000 rubles. The devil knows what this car is, but it's yours. It will be waiting for you by the Monolith fanatics' roadblock. Best quality service, see?",
      "JA_new": "1万8,000ルーブルだ。どんな車かは神のみぞ知る、だがもうお前のものだ。モノリス狂信者の検問所のそばに置いておく。これが最高のサービスってやつだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "stable_dialogs_military:shurup_car_trade_42#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1630,
      "string_id": "shurup_car_trade_42",
