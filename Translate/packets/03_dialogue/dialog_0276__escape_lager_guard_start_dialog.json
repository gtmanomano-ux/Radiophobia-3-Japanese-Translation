  "entries": [
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 887,
      "string_id": "escape_lager_guard_start_dialog_2",
      "occurrence": 1,
      "EN": "Wait, Marked One! No one at the camp is gonna to talk to you right now.",
      "JA_current": "待て、Marked One！ 今このキャンプで、お前と話そうとするヤツは誰もいないぞ。",
      "JA_new": "待て、印付き！　今はキャンプの誰もお前と話す気はない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 911,
      "string_id": "escape_lager_guard_start_dialog_3",
      "occurrence": 1,
      "EN": "Hello, Marked One. What do you want?",
      "JA_current": "こんにちは、Marked One。何が欲しいんだ？",
      "JA_new": "やあ、印付き。何の用だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_121#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 884,
      "string_id": "escape_lager_guard_start_dialog_121",
      "occurrence": 1,
      "EN": "Our boss here wanted to see you. But that doesn't make you a welcomed guest. Keep moving.",
      "JA_current": "ボスがあんたを探してたぞ。歓迎はしてなかったようだがな。行ってみな。",
      "JA_new": "ここのボスがお前に会いたがってる。だからって歓迎されてるわけじゃないぞ。先へ進め。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "121",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 890,
      "string_id": "escape_lager_guard_start_dialog_21",
      "occurrence": 1,
      "EN": "Why?",
      "JA_current": "何故だ？",
      "JA_new": "どうしてだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_22#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 908,
      "string_id": "escape_lager_guard_start_dialog_22",
      "occurrence": 1,
      "EN": "Alright, so be it.",
      "JA_current": "分かった、やってみる。",
      "JA_new": "分かった。そうする。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "22",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_212#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 893,
      "string_id": "escape_lager_guard_start_dialog_212",
      "occurrence": 1,
      "EN": "What kind of idiot would chat with a former passenger of the \"death truck\"? First, you gotta prove you're OK to deal with.",
      "JA_current": "どんな馬鹿が「死のトラック」の元乗客と話すんだ？ お前が先に、相手にして大丈夫だということを証明してみろよ。",
      "JA_new": "「死のトラック」に乗ってた奴と、誰が気軽に話すんだ？　まずはまともに付き合える人間だと証明しろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "212",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_2121#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 896,
      "string_id": "escape_lager_guard_start_dialog_2121",
      "occurrence": 1,
      "EN": "What \"death truck?\" What are you talking about?",
      "JA_current": "「死のトラック」とは何だ？ 何を言ってるんだ？",
      "JA_new": "「死のトラック」って何だ？　どういう意味だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "2121",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_2122#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 902,
      "string_id": "escape_lager_guard_start_dialog_2122",
      "occurrence": 1,
      "EN": "What can I do to make people believe me?",
      "JA_current": "皆の信頼を得るために、何をしたらいいんだ？",
      "JA_new": "どうすれば皆に信じてもらえる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "2122",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_21211#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 899,
      "string_id": "escape_lager_guard_start_dialog_21211",
      "occurrence": 1,
      "EN": "Ah, hell only knows what it really is. But whatever it is, it's bad, about as bad as it gets...  Why am I talking to you about this anyway?! Maybe I'm just superstitious, but you, Marked One, should really take a hike before something happens to you. Go speak to the Trader, prove that you can be trusted, then we'll see.",
      "JA_current": "ああ、それが実際何なのか知ってるのは地獄の番人だけだ。だが、それが何であっても、ひでぇものには違いない… いずれにせよ、なんでこんなこと話してるんだ？ 多分俺は迷信深いんだろうな。だが Marked One、わが身に何か起こる前に、絶対に近寄らないことだ。",
      "JA_new": "さあな。本当のところは誰も知らない。だが、とにかく最悪の代物だ……って、なんで俺がお前にこんな話をしてる？　俺が迷信深いだけかもしれないが、何か起きる前にここから離れた方がいい、印付き。商人のところへ行って、信用できると証明しろ。話はそれからだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "21211",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_lager_guard_start_dialog_21221#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 905,
      "string_id": "escape_lager_guard_start_dialog_21221",
      "occurrence": 1,
      "EN": "Talk to the Trader, do some work around here while we watch. If you're alright - if you're not trigger-happy and you use your head - then we'll definitely find some common ground. Don't you worry.",
      "JA_current": "俺たちが見ているから、トレーダーが与えたテストにパスしろ。もしそれが出来たら、― ただし、すぐ銃をぶっ放したりせず、頭を使ってだ ― そうすりゃ確かに、俺たちの間にいくらか共通の立場を見つけることが出来る。心配するな。",
      "JA_new": "商人と話して、この辺りの仕事をいくつかこなせ。こっちは見てる。大丈夫な奴なら――すぐ撃ったりせず、頭を使える奴なら――折り合いをつけられる。心配するな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_lager_guard_start_dialog",
          "phrase_id": "21221",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    }
  ],
