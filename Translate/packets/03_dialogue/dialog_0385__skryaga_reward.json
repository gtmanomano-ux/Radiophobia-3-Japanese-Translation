                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_2#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1707,
                        "string_id":  "skryaga_reward_phrase_2",
                        "occurrence":  1,
                        "EN":  "Is that so? And where is it located? How did he die?",
                        "JA_current":  "Is that so? And where is it located? How did he die?",
                        "JA_new":  "そうか。それで、どこにあった？ どうやって死んだんだ？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "skryaga_reward",
                                               "phrase_id":  "1",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_3#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1710,
                        "string_id":  "skryaga_reward_phrase_3",
                        "occurrence":  1,
                        "EN":  "Near the Scorcher, at the edge of the forest. Apparently, Miklukha fell into some strange anomaly... I got out of there by pure chance myself.",
                        "JA_current":  "Near the Scorcher, at the edge of the forest. Apparently, Miklukha fell into some strange anomaly... I got out of there by pure chance myself.",
                        "JA_new":  "スコーチャーの近く、森の端だ。どうやらミクルーハは奇妙なアノマリーに巻き込まれたらしい……俺も運よく逃げ出せただけだ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "skryaga_reward",
                                               "phrase_id":  "2",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_4#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1713,
                        "string_id":  "skryaga_reward_phrase_4",
                        "occurrence":  1,
                        "EN":  "Oh, the amount of shit the Zone throws at us just to wipe out our brothers, it\u0027s baffling... Of course, it\u0027s a pity about Miklukha, he was a real pro... About your case: while you were beyond the barrier, this one stalker came to me, started asking me questions about the same group of unknowns as you did. Told me he\u0027d been following them for a long time. But he didn\u0027t say anything about...",
                        "JA_current":  "Oh, the amount of shit the Zone throws at us just to wipe out our brothers, it\u0027s baffling... Of course, it\u0027s a pity about Miklukha, he was a real pro... About your case: while you were beyond the barrier, this one stalker came to me, started asking me questions about the same group of unknowns as you did. Told me he\u0027d been following them for a long time. But he didn\u0027t say anything about...",
                        "JA_new":  "ゾーンは、仲間を消し去るためにどれだけひどい目に遭わせるんだろうな……。ミクルーハは本当に惜しい奴だった。腕も立ったしな……。それはそうと、お前がバリアの向こうにいる間、見知らぬストーカーが来てな。お前と同じ、正体不明の連中について聞いてきた。そいつも、連中を長いこと追ってると言ってたが……",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "skryaga_reward",
                                               "phrase_id":  "3",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_5#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1716,
                        "string_id":  "skryaga_reward_phrase_5",
                        "occurrence":  1,
                        "EN":  "Who was he?",
                        "JA_current":  "Who was he?",
                        "JA_new":  "誰だった？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "skryaga_reward",
                                               "phrase_id":  "4",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_6#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1719,
                        "string_id":  "skryaga_reward_phrase_6",
                        "occurrence":  1,
                        "EN":  "His name is Alan, and he\u0027s a loner. Don\u0027t interrupt me, or I\u0027ll forget to tell you the main thing! I told this Alan about you, and he was interested and wanted to get in touch with you. I told him you had gone towards the barrier, and he followed you. You must have missed him.",
                        "JA_current":  "His name is Alan, and he\u0027s a loner. Don\u0027t interrupt me, or I\u0027ll forget to tell you the main thing! I told this Alan about you, and he was interested and wanted to get in touch with you. I told him you had gone towards the barrier, and he followed you. You must have missed him.",
                        "JA_new":  "アランって名前のローナーだ。話を遮るな、肝心なことを忘れるだろ！ そいつにお前のことを話したら、興味を持って連絡を取りたがってた。お前はバリアへ向かったと伝えたら、追いかけていったよ。すれ違ったんじゃないか。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "skryaga_reward",
                                               "phrase_id":  "5",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:skryaga_reward_phrase_7#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1722,
                        "string_id":  "skryaga_reward_phrase_7",
                        "occurrence":  1,
                        "EN":  "Thanks for the info, I\u0027ll try to catch up with him!",
                        "JA_current":  "Thanks for the info, I\u0027ll try to catch up with him!",
                        "JA_new":  "情報ありがとう。追いついてみる！",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
