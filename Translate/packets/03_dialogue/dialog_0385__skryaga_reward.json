                        "EN":  "I found Miklukha\u0027s body.",
                        "JA_current":  "I found Miklukha\u0027s body.",
                        "JA_new":  "ミクルーハの遺体を見つけた。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
