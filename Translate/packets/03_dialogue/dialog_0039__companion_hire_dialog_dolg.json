    },
    {
      "key": "stable_dialogs:companion_hire_dialog_dolg_3#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 166,
      "string_id": "companion_hire_dialog_dolg_3",
      "occurrence": 1,
      "EN": "Sorry, I can't. There're some rumors about you...",
      "JA_current": "Sorry, I can't. There're some rumors about you...",
      "JA_new": "悪いが無理だ。あんたの噂を聞いててな……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_dolg",
