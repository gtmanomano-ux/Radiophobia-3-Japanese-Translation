          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_dolg_6#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 175,
      "string_id": "companion_hire_dialog_dolg_6",
      "occurrence": 1,
      "EN": "Marked One, you can't go with me. Gain some experience first, then we'll talk.",
      "JA_current": "Marked One, you can't go with me. Gain some experience first, then we'll talk.",
      "JA_new": "マークド・ワン、今のままじゃ一緒に行けない。もっと経験を積んでから話そう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_dolg",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_dolg_7#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 178,
      "string_id": "companion_hire_dialog_dolg_7",
      "occurrence": 1,
      "EN": "No, thanks. Your experience is way bigger than mine.",
      "JA_current": "No, thanks. Your experience is way bigger than mine.",
      "JA_new": "遠慮しとく。あんたの経験には到底かなわない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
