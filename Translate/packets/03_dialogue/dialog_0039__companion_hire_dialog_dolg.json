      "source_xml_line": 163,
      "string_id": "companion_hire_dialog_dolg_2",
      "occurrence": 1,
      "EN": "No, Marked One, I'm on a mission.",
      "JA_current": "No, Marked One, I'm on a mission.",
      "JA_new": "任務中だ、マークド・ワン。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_dolg",
