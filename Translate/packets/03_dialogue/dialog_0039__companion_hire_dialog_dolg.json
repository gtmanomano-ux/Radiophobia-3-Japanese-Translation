        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_dolg_4#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 169,
      "string_id": "companion_hire_dialog_dolg_4",
      "occurrence": 1,
      "EN": "No way, Marked One, you always return alone. I don't want to die.",
      "JA_current": "No way, Marked One, you always return alone. I don't want to die.",
      "JA_new": "無理だ、マークド・ワン。あんたはいつも一人で帰ってくるだろ。死にたくないんでね。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_dolg",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_dolg_5#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 172,
      "string_id": "companion_hire_dialog_dolg_5",
      "occurrence": 1,
      "EN": "Sorry, I can't. Very tired, need rest.",
      "JA_current": "Sorry, I can't. Very tired, need rest.",
      "JA_new": "悪い、疲れてるんだ。休ませてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_dolg",
