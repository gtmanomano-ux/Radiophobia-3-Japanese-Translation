      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 328,
      "string_id": "mahno_hello_phrase_9",
      "occurrence": 1,
      "EN": "Keeps me out of view of some mean bastards out there. Anyway, it's none of your business. If you have any problems, come over and we'll talk, I won't be so bored sitting here.",
      "JA_current": "Keeps me out of view of some mean bastards out there. Anyway, it's none of your business. If you have any problems, come over and we'll talk, I won't be so bored sitting here.",
      "JA_new": "外の危ない連中に見つからないようにな。それより、俺のことは放っておけ。何か困ったら来いよ。ここで一人で座ってるのも退屈だし、話くらい聞いてやる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "8",
