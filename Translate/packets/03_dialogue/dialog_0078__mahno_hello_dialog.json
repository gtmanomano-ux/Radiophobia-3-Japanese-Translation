      "string_id": "mahno_hello_phrase_2",
      "occurrence": 1,
      "EN": "Hey, I'm the Marked One.",
      "JA_current": "Hey, I'm the Marked One.",
      "JA_new": "やあ、俺はマークド・ワンだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
