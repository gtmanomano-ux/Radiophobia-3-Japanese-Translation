        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_3#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 310,
      "string_id": "mahno_hello_phrase_3",
      "occurrence": 1,
      "EN": "If there's a bazaar, push, if not, get the fuck out.",
      "JA_current": "If there's a bazaar, push, if not, get the fuck out.",
      "JA_new": "商売の話ならしろ。用がないなら、とっとと失せな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_4#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 313,
      "string_id": "mahno_hello_phrase_4",
      "occurrence": 1,
      "EN": "What a place you've found. What will you do if mutants sniff you out down here?",
      "JA_current": "What a place you've found. What will you do if mutants sniff you out down here?",
      "JA_new": "こんなところで何してる？ ミュータントに見つかったらどうするんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_5#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 316,
      "string_id": "mahno_hello_phrase_5",
      "occurrence": 1,
      "EN": "Very simple: I'll take 200 grams of vodka and go ahead with the music!",
      "JA_current": "Very simple: I'll take 200 grams of vodka and go ahead with the music!",
      "JA_new": "簡単さ。ウォッカを200グラム飲んで、音楽を鳴らしながら進むんだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_6#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 319,
      "string_id": "mahno_hello_phrase_6",
      "occurrence": 1,
      "EN": "Yeah, that's an interesting tactic. I'll have to try it myself sometime. And what's brought you to the Zone, if it's no secret?",
      "JA_current": "Yeah, that's an interesting tactic. I'll have to try it myself sometime. And what's brought you to the Zone, if it's no secret?",
      "JA_new": "なるほど、面白い作戦だな。俺もいつか試してみるよ。ところで、差し支えなければ、どうしてゾーンに来た？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_7#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 322,
      "string_id": "mahno_hello_phrase_7",
      "occurrence": 1,
      "EN": "It's very simple: sea, sun, yachts, cognac for ten bucks, chicks - the most expensive!",
      "JA_current": "It's very simple: sea, sun, yachts, cognac for ten bucks, chicks - the most expensive!",
      "JA_new": "簡単さ。海に太陽にヨット、10ドルのコニャック、それに女の子！ 女の子は最高に高くつくけどな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:mahno_hello_phrase_8#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 325,
      "string_id": "mahno_hello_phrase_8",
      "occurrence": 1,
      "EN": "I think you're not the only one with dreams like that. So, why are you hiding down here all alone?",
      "JA_current": "I think you're not the only one with dreams like that. So, why are you hiding down here all alone?",
      "JA_new": "そういう夢を見てるのは、あんただけじゃないだろ。じゃあ、どうして一人でこんな地下に隠れてる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mahno_hello_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
