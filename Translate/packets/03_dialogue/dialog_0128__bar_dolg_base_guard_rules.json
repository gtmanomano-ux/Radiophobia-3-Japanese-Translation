  "entries": [
    {
      "key": "stable_dialogs_bar:bar_dolg_base_guard_rules_0#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1241,
      "string_id": "bar_dolg_base_guard_rules_0",
      "occurrence": 1,
      "EN": "Barkeep told me that your leadership has some sort of assignment for me.",
      "JA_current": "アンタが俺向けの任務を何か持ってるって、Barkeep が言ってたんだが。",
      "JA_new": "バーキープから、あんたの上役が俺に仕事を頼みたいと聞いた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_rules",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_base_guard_rules_1#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1244,
      "string_id": "bar_dolg_base_guard_rules_1",
      "occurrence": 1,
      "EN": "Yes, he let us know about you, but before we let you in I want to brief you on our rules. So listen, our rules are simple. First rule - it's forbidden to shoot on our territory. If you break the rule twice, our patrol will open fire on you. Even if you make a run for it, you won't appear on our territory again - our guards will make sure of that. If you act calmly, you won't have any problems.",
      "JA_current": "ああ、ヤツがお前のことを教えてくれた。加わってもらう前に、お前に俺たちのルールを説明したい。まあ聞けよ、俺たちのルールはシンプルだ。第1に ― 俺たちのテリトリーで発砲は禁止だ。2度ルールを破れば、警備がぶっ放すことになる。逃げたとしても、2度とこのテリトリーに顔は出せない ― 俺たちの見張りがきっとそうする。大人しくしてれば、問題ないがな。",
      "JA_new": "ああ、バーキープから話は聞いてる。だが、中へ入れる前に規則を説明する。よく聞け。規則は簡単だ。ここで撃つのは禁止。一度でも破れば、二度目には巡回兵が発砲する。逃げたとしても、もう二度とこの敷地には入れない。警備がそうさせる。落ち着いて行動すれば問題ない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_rules",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_base_guard_rules_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1247,
      "string_id": "bar_dolg_base_guard_rules_2",
      "occurrence": 1,
      "EN": "Got it. Anything else?",
      "JA_current": "わかった。他には？",
      "JA_new": "分かった。他には？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_rules",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_base_guard_rules_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1250,
      "string_id": "bar_dolg_base_guard_rules_3",
      "occurrence": 1,
      "EN": "Yes, that's enough. You can pass.",
      "JA_current": "ああ、それで充分だ。通っていいぞ。",
      "JA_new": "それだけだ。通っていい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_rules",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_base_guard_rules_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1256,
      "string_id": "bar_dolg_base_guard_rules_5",
      "occurrence": 1,
      "EN": "That's about it. If you want to try to join Duty, feel free. We need good men but I'm warning you: before being accepted, you'll have to do a few dangerous jobs. We don't need pussies so everyone is tested.",
      "JA_current": "そんなところだ。Duty に加わりたいなら、気兼ねするな。いいヤツを求めてるが、お前は警戒している： 受け入れる前に、2、3危険な仕事をしてもらう。めめしい男は要らねえ、どんなヤツでもテストするんだ。",
      "JA_new": "以上だ。デューティーに入隊したいなら、好きにしろ。腕の立つ奴は必要だが、警告しておく。正式に認められる前に危険な仕事をいくつかこなしてもらう。腰抜けはいらない。全員に試験を受けてもらう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_base_guard_rules",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
  ],
