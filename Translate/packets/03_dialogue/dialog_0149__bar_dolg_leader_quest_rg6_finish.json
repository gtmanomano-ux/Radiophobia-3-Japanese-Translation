      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_prisyaga_01#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1334,
      "string_id": "bar_dolg_leader_prisyaga_01",
      "occurrence": 1,
      "EN": "No, I'm not ready to enter the Duty.",
      "JA_current": "No, I'm not ready to enter the Duty.",
      "JA_new": "いや、まだデューティーに入隊するつもりはない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_quest_rg6_finish",
