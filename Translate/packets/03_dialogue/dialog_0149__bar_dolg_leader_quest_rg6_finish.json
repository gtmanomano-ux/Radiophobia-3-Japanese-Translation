    {
      "key": "stable_dialogs_bar:bar_dolg_leader_prisyaga_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1349,
      "string_id": "bar_dolg_leader_prisyaga_3",
      "occurrence": 1,
      "EN": "To protect the Earth from the dangers of the Zone, to seek out and destroy anything it spawns within and beyond its borders.",
      "JA_current": "ゾーンの危険からこの大地を守り、境界の内外に大量に生み出される何ものをも捜し出し、破壊することを誓う。",
      "JA_new": "ゾーンの脅威から地球を守り、ゾーンが生み出すものを境界の内外を問わず探し出して破壊する。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
