        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_prisyaga_1#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1343,
      "string_id": "bar_dolg_leader_prisyaga_1",
      "occurrence": 1,
      "EN": "Good man! Repeat after me: \"I, a stalker known as Marked One, swear to defend the goals and ideals of Duty.\"",
      "JA_current": "よろしい！ 復唱しろ： 「私、Marked One と名乗るストーカーは、Duty の目標と理念を守ると誓う」。",
      "JA_new": "よし。復唱しろ。「ストーカー、マークド・ワンとして、デューティーの目的と理想を守ると誓う。」",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_quest_rg6_finish",
          "phrase_id": "31113",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        },
        {
          "dialog_id": "bar_dolg_leader_start",
          "phrase_id": "31113",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        },
        {
          "dialog_id": "dolg_attach_community",
          "phrase_id": "31113",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_leader_prisyaga_00#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1331,
      "string_id": "bar_dolg_leader_prisyaga_00",
      "occurrence": 1,
      "EN": "So, Marked One. We'll never forget what you have done for us. And I'll be ready and willing to accept you as our member whenever you make up your mind about it.",
      "JA_current": "So, Marked One. We'll never forget what you have done for us. And I'll be ready and willing to accept you as our member whenever you make up your mind about it.",
      "JA_new": "分かった、マークド・ワン。お前がしてくれたことは忘れない。気が変わったら、いつでも仲間として迎え入れよう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_leader_quest_rg6_finish",
