    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_011#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 270,
      "string_id": "agr_swamp_ratcatcher_talks1_011",
      "occurrence": 1,
      "EN": "Tell me about the collector. How do I get inside? Where are the exits and entrances?",
      "JA_current": "Collector について教えてくれ。どうやって中に？ 入り口と出口はどこだ？",
      "JA_new": "下水道について教えてくれ。中にはどうやって入る？ 出入口はどこだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "011",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_013#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 288,
      "string_id": "agr_swamp_ratcatcher_talks1_013",
      "occurrence": 1,
      "EN": "Who are you?",
      "JA_current": "アンタは誰だい？",
      "JA_new": "あんたは誰だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "013",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_012#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 285,
      "string_id": "agr_swamp_ratcatcher_talks1_012",
      "occurrence": 1,
      "EN": "Nothing. See you.",
      "JA_current": "何でもない、じゃあな",
      "JA_new": "何でもない。じゃあな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "012",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_0111#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 273,
      "string_id": "agr_swamp_ratcatcher_talks1_0111",
      "occurrence": 1,
      "EN": "It's dangerous inside the collector. There are six entrances and two of them are in the area around the Institute where the military have set up a base. That area is patrolled and the captain keeps the patrol schedule in his armory.",
      "JA_current": "Collector 内部は大変危険だ。6つの入り口があって、そのうち2つは、軍が設立した基地の研究所の周囲にある。このエリアは常に哨戒されていて、隊長が武器庫にいて、哨戒スケジュールを守らせているんだ。",
      "JA_new": "下水道の中は危険だ。出入口は6つある。そのうち2つは、軍が基地を構えた研究所周辺にある。あの一帯は巡回されてるし、巡回予定表は大尉が武器庫に保管してる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "0111",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_0135#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 294,
      "string_id": "agr_swamp_ratcatcher_talks1_0135",
      "occurrence": 1,
      "EN": "I am Ratcatcher.",
      "JA_current": "俺は Ratcatcher だ。",
      "JA_new": "俺はラットキャッチャーだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "0135",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_01111#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 276,
      "string_id": "agr_swamp_ratcatcher_talks1_01111",
      "occurrence": 1,
      "EN": "How do you know all that?",
      "JA_current": "それはどうやって知った？",
      "JA_new": "どうしてそこまで知ってる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "01111",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_0111111#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 282,
      "string_id": "agr_swamp_ratcatcher_talks1_0111111",
      "occurrence": 1,
      "EN": "I see. Bye! Good luck to you.",
      "JA_current": "わかった。じゃあな！ 君に幸あれ！",
      "JA_new": "そうか。じゃあな！ 元気でな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "0111111",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_01351#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 297,
      "string_id": "agr_swamp_ratcatcher_talks1_01351",
      "occurrence": 1,
      "EN": "What are you doing in this marsh?",
      "JA_current": "こんな沼地の中で何をしてるんだ？",
      "JA_new": "こんな沼地で何をしてる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "01351",
