    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_011111#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 279,
      "string_id": "agr_swamp_ratcatcher_talks1_011111",
      "occurrence": 1,
      "EN": "The rats told me.",
      "JA_current": "ネズミに教わったのさ。",
      "JA_new": "ネズミが教えてくれた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "011111",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_0134#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 291,
      "string_id": "agr_swamp_ratcatcher_talks1_0134",
      "occurrence": 1,
      "EN": "I live here, if you can call this a life. I breed rats in the collector to annoy the military at the Institute.",
      "JA_current": "俺はここで生活している。生活と呼べる物であるならな。俺は研究所で Military を苛つかせるために、Collector 内でネズミを飼育しているのさ。",
      "JA_new": "ここに住んでる。これを暮らしと呼べるならな。下水道でネズミを繁殖させて、研究所の軍連中を困らせてるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
          "phrase_id": "0134",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_swamp_ratcatcher_talks1_123#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 300,
      "string_id": "agr_swamp_ratcatcher_talks1_123",
      "occurrence": 1,
      "EN": "Oh... I get it.... Well, I'm from another story. Ha-ha-ha...",
      "JA_current": "おお… とったぞ… さて、俺は別のお話から来たんだよ。はっはっは…。",
      "JA_new": "ああ……そういうことか。まあ、俺は別の話の人間なんだ。ははは……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_swamp_ratcatcher_talks1",
