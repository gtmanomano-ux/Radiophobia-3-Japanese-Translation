                        "source_xml_line":  2062,
                        "string_id":  "cherep_treasure_dialog_phrase_8",
                        "occurrence":  1,
                        "EN":  "Great, here\u0027s the info on the stash: it\u0027s in a boarded-up hangar near the entrance to our base. I put it on a vertical green tank, so no one would stumble upon it by accident.",
                        "JA_current":  "Great, here\u0027s the info on the stash: it\u0027s in a boarded-up hangar near the entrance to our base. I put it on a vertical green tank, so no one would stumble upon it by accident.",
                        "JA_new":  "よし、隠し場所の情報だ。基地の入口近くにある、板で塞がれた格納庫の中だ。縦に置かれた緑のタンクの上に隠した。偶然見つける奴はいないだろう。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
