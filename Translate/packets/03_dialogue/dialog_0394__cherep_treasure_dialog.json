                    {
                        "key":  "stable_dialogs_military:cherep_treasure_dialog_phrase_1#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2041,
                        "string_id":  "cherep_treasure_dialog_phrase_1",
                        "occurrence":  1,
                        "EN":  "Yeah, you guys are tough, like something out of a Hollywood movie. Yet you can\u0027t take down a single stoner Freedom sniper. What\u0027s the matter?",
                        "JA_current":  "Yeah, you guys are tough, like something out of a Hollywood movie. Yet you can\u0027t take down a single stoner Freedom sniper. What\u0027s the matter?",
                        "JA_new":  "映画に出てくる兵隊みたいに強そうだな。それなのに、ラリったフリーダムの狙撃手一人始末できないのか？ どうした？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "cherep_treasure_dialog",
                                               "phrase_id":  "0",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:cherep_treasure_dialog_phrase_2#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2044,
                        "string_id":  "cherep_treasure_dialog_phrase_2",
                        "occurrence":  1,
                        "EN":  "You know what, why don\u0027t you go... We have a serious operation ahead of us, do us a favor, don\u0027t play on our nerves! Regarding the sniper, just so you know, we thought of everything. Circumstances interfered! ",
                        "JA_current":  "You know what, why don\u0027t you go... We have a serious operation ahead of us, do us a favor, don\u0027t play on our nerves! Regarding the sniper, just so you know, we thought of everything. Circumstances interfered! ",
                        "JA_new":  "もういい、行ってくれ……こっちは大事な作戦を控えてる。頼むから、これ以上イライラさせないでくれ！ 狙撃手の件なら手は打ってあった。邪魔が入っただけだ！",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "cherep_treasure_dialog",
                                               "phrase_id":  "1",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:cherep_treasure_dialog_phrase_3#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2047,
                        "string_id":  "cherep_treasure_dialog_phrase_3",
                        "occurrence":  1,
                        "EN":  "What were these circumstances?",
                        "JA_current":  "What were these circumstances?",
                        "JA_new":  "どんな邪魔が入った？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "cherep_treasure_dialog",
                                               "phrase_id":  "2",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:cherep_treasure_dialog_phrase_4#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2050,
                        "string_id":  "cherep_treasure_dialog_phrase_4",
                        "occurrence":  1,
                        "EN":  "I ordered a sniper rifle from a technician, but could not pick up in time - we were in too much of a rush. It remained in my cache, and I spent so much money to upgrade it... Hey, you wouldn\u0027t happen to need it, would you? I could sell it. It\u0027s a powerful rifle, and even with reinforced optics - handmade, you might say! For 40,000 I\u0027ll give you information on the location of that cache. Alternatively, you can get your hands on the artifacts \"Shell\" and \"Mama\u0027s beads\" - I\u0027m heading for a fight so extra protection will be a welcome sight. So what do you think?",
                        "JA_current":  "I ordered a sniper rifle from a technician, but could not pick up in time - we were in too much of a rush. It remained in my cache, and I spent so much money to upgrade it... Hey, you wouldn\u0027t happen to need it, would you? I could sell it. It\u0027s a powerful rifle, and even with reinforced optics - handmade, you might say! For 40,000 I\u0027ll give you information on the location of that cache. Alternatively, you can get your hands on the artifacts \"Shell\" and \"Mama\u0027s beads\" - I\u0027m heading for a fight so extra protection will be a welcome sight. So what do you think?",
                        "JA_new":  "技師に狙撃銃を注文したんだが、急いでいて受け取りに行けなかった。俺の隠し場所に置いたままだ。改造に大金をつぎ込んだんだがな……あんた、要らないか？ 売ってやるよ。強力な銃だし、強化スコープもついてる。手作りと言ってもいいくらいだ！ 4万ルーブルで隠し場所の場所を教える。あるいは、アーティファクトの«シェル»と«ママズ・ビーズ»を持ってきてもいい。これから戦いに行くんで、防護になるものがあると助かる。どうする？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "cherep_treasure_dialog",
                                               "phrase_id":  "3",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
