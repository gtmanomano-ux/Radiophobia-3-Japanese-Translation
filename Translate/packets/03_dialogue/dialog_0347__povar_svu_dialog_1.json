    {
      "key": "stable_dialogs_military:fuck#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 34,
      "string_id": "fuck",
      "occurrence": 1,
      "EN": "D... Damn... How the hell did I happen to lose it?.. It's all 'cause of those voices... In my head, making me exhausted... Now, again... Hey, be so kind, friend, bring me some vodka!",
      "JA_current": "D... Damn... How the hell did I happen to lose it?.. It's all 'cause of those voices... In my head, making me exhausted... Now, again... Hey, be so kind, friend, bring me some vodka!",
      "JA_new": "く……くそっ……どうして失くしたんだ？頭の中の声に疲れ果てて……全部あいつらのせいだ。なあ、頼むよ、ウォッカを持ってきてくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "povar_svu_dialog_1",
