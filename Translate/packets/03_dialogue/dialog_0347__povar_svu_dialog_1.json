        }
      ]
    },
    {
      "key": "stable_dialogs_military:da_takoi#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 28,
      "string_id": "da_takoi",
      "occurrence": 1,
      "EN": "Yeah! That's it! Have you seen it?!",
      "JA_current": "Yeah! That's it! Have you seen it?!",
      "JA_new": "そうだ！それだよ！見たのか！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "povar_svu_dialog_1",
