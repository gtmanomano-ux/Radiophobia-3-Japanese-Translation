        }
      ]
    },
    {
      "key": "stable_dialogs_military:verni_stvol#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 62,
      "string_id": "verni_stvol",
      "occurrence": 1,
      "EN": "Listen to me, Marked One. Give it back to me, please... Whatever I have, I'll give it to you!",
      "JA_current": "Listen to me, Marked One. Give it back to me, please... Whatever I have, I'll give it to you!",
      "JA_new": "なあ、マークドワン。頼む、返してくれ……持ってるものは何でもやる！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
