    {
      "key": "stable_dialogs_military:patronov_dam#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 40,
      "string_id": "patronov_dam",
      "occurrence": 1,
      "EN": "Really, Marked One!? Even I grew more sober by that! Can't you do a favor for free once in your life?! Screw you!.. Ok, I understand... The only thing I've got left is some ammo for that \"Commando ISG\" of mine... I don't need them, anyway... Bring me 10 bottles - and they are yours, all of them!",
      "JA_current": "Really, Marked One!? Even I grew more sober by that! Can't you do a favor for free once in your life?! Screw you!.. Ok, I understand... The only thing I've got left is some ammo for that \"Commando ISG\" of mine... I don't need them, anyway... Bring me 10 bottles - and they are yours, all of them!",
      "JA_new": "本当に頼むよ、マークドワン！こっちだって酔いがさめてきたぞ。たまにはタダで人助けできないのか？この野郎……分かったよ。残ってるのは「Commando ISG」用の弾薬くらいだ。もういらん。ウォッカを10本持ってこい。全部お前のだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
