      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 31,
      "string_id": "nea_ne_videl",
      "occurrence": 1,
      "EN": "Ah... Nope, I haven't...",
      "JA_current": "Ah... Nope, I haven't...",
      "JA_new": "ああ……いや、見てない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
