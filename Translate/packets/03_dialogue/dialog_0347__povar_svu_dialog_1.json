    {
      "key": "stable_dialogs_military:stvol_u_menya#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 59,
      "string_id": "stvol_u_menya",
      "occurrence": 1,
      "EN": "I have seen it and actually, as a matter of fact, I have it with me.",
      "JA_current": "I have seen it and actually, as a matter of fact, I have it with me.",
      "JA_new": "見たし、実は今持ってる。",
