      "occurrence": 1,
      "EN": "What do you know about Pripyat?",
      "JA_current": "Pripyat について何か知らないか？",
      "JA_new": "プリピャチについて、何か知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_find_stalkers_dialog_2",
