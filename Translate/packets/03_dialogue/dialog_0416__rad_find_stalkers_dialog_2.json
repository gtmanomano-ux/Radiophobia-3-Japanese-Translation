    },
    {
      "key": "stable_dialogs_radar:rad_find_stalkers_dialog_2_10#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 33,
      "string_id": "rad_find_stalkers_dialog_2_10",
      "occurrence": 1,
      "EN": "It's an old abandoned city from the communist era! From history! I reckon it's full of monsters and hordes of Monolith fighters now! No one who has gone there before ever returned!",
      "JA_current": "共産主義時代からある見捨てられた古い都市って事になってるぜ！ だが今では Monolith 兵の群れと怪物どもでいっぱいだろうな。あそこから生きて帰ってきた奴はまだ居ないぜ！",
      "JA_new": "共産主義時代に築かれた、歴史に残る古い廃墟の街さ！ 今じゃ怪物とモノリス兵の大群で埋め尽くされてるだろうな！ あそこへ行ったきり、戻ってきた奴は誰もいない！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_find_stalkers_dialog_2",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_find_stalkers_dialog_2_100#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 36,
      "string_id": "rad_find_stalkers_dialog_2_100",
      "occurrence": 1,
      "EN": "You think it's dangerous?",
      "JA_current": "あんたも危ない所だと思うか？",
      "JA_new": "そんなに危険だと思うか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_find_stalkers_dialog_2",
          "phrase_id": "100",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_find_stalkers_dialog_2_20#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 39,
      "string_id": "rad_find_stalkers_dialog_2_20",
      "occurrence": 1,
      "EN": "No doubt about it - nobody has ever come back from there.",
      "JA_current": "疑問をさし挟む余地はないな… まだ誰もあそこから生きて帰って来ちゃいないって事にな。",
      "JA_new": "間違いない。あそこから戻ってきた奴は一人もいない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
