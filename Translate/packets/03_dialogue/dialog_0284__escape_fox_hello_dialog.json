  "entries": [
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 839,
      "string_id": "escape_fox_hello_dialog_2",
      "occurrence": 1,
      "EN": "Sorry, brother, but could you go somewhere else? I'm not in a chatty mood right now...",
      "JA_current": "すまんが兄弟、他を当たってくれないか？ 俺は人に会うために、ここにいる…。",
      "JA_new": "悪いな、兄弟。今は話す気分じゃないんだ。よそへ行ってくれ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 857,
      "string_id": "escape_fox_hello_dialog_3",
      "occurrence": 1,
      "EN": "Thanks. OK, now I'm listening very carefully.",
      "JA_current": "ありがとう、助かったぜ。",
      "JA_new": "助かった。よし、ちゃんと聞くよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 869,
      "string_id": "escape_fox_hello_dialog_5",
      "occurrence": 1,
      "EN": "A medkit! Gimme a medkit!",
      "JA_current": "Medkit を！ Medkit をくれ！",
      "JA_new": "救急キットだ！ 早くよこしてくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_61#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 878,
      "string_id": "escape_fox_hello_dialog_61",
      "occurrence": 1,
      "EN": "Hey, man, you saved me twice, and that's not something I forget. Take this... that's all I got!",
      "JA_current": "へへ、お前には2度も助けられたな。おっと、礼を忘れていたな。少ないが受け取ってくれ。",
      "JA_new": "二度も助けてもらった。忘れたりしないさ。これを受け取ってくれ……俺が出せるのはこれだけだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "61",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_21#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 842,
      "string_id": "escape_fox_hello_dialog_21",
      "occurrence": 1,
      "EN": "I've got a couple of questions.",
      "JA_current": "いくつか聞きたいことがある。",
      "JA_new": "少し聞きたいことがある。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_31#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 860,
      "string_id": "escape_fox_hello_dialog_31",
      "occurrence": 1,
      "EN": "Trader told me you might know something about Strelok.",
      "JA_current": "Trader から、あんたが Strelok について知っていると聞いたんだが。",
      "JA_new": "商人から、ストレロクについて何か知ってるかもって聞いた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_55#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 872,
      "string_id": "escape_fox_hello_dialog_55",
      "occurrence": 1,
      "EN": "Here you are.",
      "JA_current": "使え。",
      "JA_new": "ほら、これだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "55",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_56#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 875,
      "string_id": "escape_fox_hello_dialog_56",
      "occurrence": 1,
      "EN": "Don't have one. Sorry.",
      "JA_current": "持ってないんだ。すまない。",
      "JA_new": "持ってないんだ。悪い。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "56",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_611#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 881,
      "string_id": "escape_fox_hello_dialog_611",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとよ。",
      "JA_new": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "611",
