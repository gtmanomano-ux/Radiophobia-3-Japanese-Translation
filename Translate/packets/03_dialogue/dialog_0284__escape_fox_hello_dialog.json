        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_211#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 845,
      "string_id": "escape_fox_hello_dialog_211",
      "occurrence": 1,
      "EN": "OK, ask away.",
      "JA_current": "いいだろう、そのまま訊いてくれ。",
      "JA_new": "いいよ、聞いてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "211",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_311#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 863,
      "string_id": "escape_fox_hello_dialog_311",
      "occurrence": 1,
      "EN": "Why is everyone taking such a keen interest in him lately? OK, I can't say I know him personally. We did \"communicate\" though: my guys took some shots at him once. No one got hurt - it was clear his party had been waiting for someone else, so we parted in peace. Cussed each other out across a ravine and went on our separate ways. Seriy, my brother, is now in the hangar at the Garbage - I'll dish you his coordinates so you two can have a chat. He knows more about Strelok. Be careful at the exit, a small gang has settled down in those parts. By the way, I got a few mutts chasing me and it doesn't look like they've given up yet. You mind helping me deal with them? It's a walk in the park really.",
      "JA_current": "最近、皆そいつについて聞いてくるんだが。とは言っても、俺も直接会った訳ではないんだ。かつて、仲間と奴を追っていたんだが、誰1人として捕まえられた者はいなかった。今、弟の Serily が Gabage の格納庫にいる。Strelok についてなら、俺よりもコイツの方が詳しいんだ。話ができるよう弟に伝えておくよ。ところで、さっき片付けた化物の残りが、まだ近くにいるようなんだ。もしよければ、残りの奴らを始末するのを手伝ってくれないか？",
      "JA_new": "最近、どうして皆あいつに興味津々なんだ？ 個人的に知ってるわけじゃないが、俺たちは一度「話し合った」ことがある。うちの連中があいつに何発か撃ち込んだんだ。誰も怪我はしなかった。あいつらは別の相手を待ち伏せしてたらしくて、そのまま穏便に別れたよ。谷越しに互いを罵り合って、それぞれ別の道へってな。弟のセリーなら、今ガーベジの格納庫にいる。座標を教えるから、会ってみろ。ストレロクについて、あいつのほうが詳しい。出口付近は気をつけろ。あの辺りに小さなギャングが居着いてる。それと、何匹かの犬に追い回されてて、まだ諦めてないらしい。片付けるのを手伝ってくれないか？ たいした仕事じゃないさ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "311",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 848,
      "string_id": "escape_fox_hello_dialog_2111",
      "occurrence": 1,
      "EN": "What can you tell me about the Zone?",
      "JA_current": "ゾーンについて何か教えてくれないか？",
      "JA_new": "ゾーンについて何か教えてくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_2113#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 854,
      "string_id": "escape_fox_hello_dialog_2113",
      "occurrence": 1,
      "EN": "I've changed my mind. Thanks.",
      "JA_current": "気が変わった。ありがとよ。",
      "JA_new": "気が変わった。ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "2113",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_3111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 866,
      "string_id": "escape_fox_hello_dialog_3111",
      "occurrence": 1,
      "EN": "Thanks for the info, I appreciate it.",
      "JA_current": "良いことを聞いた。感謝するよ。",
      "JA_new": "情報ありがとう、助かった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:escape_fox_hello_dialog_21111#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 851,
      "string_id": "escape_fox_hello_dialog_21111",
      "occurrence": 1,
      "EN": "That's all you wanna know? Take a week off and then come back to see me. Look, my time ain't cheap and I'm kinda busy right now. Here are the basics and then you're on your own. About three kilometers North of here, you'll find the Garbage. That's the place where they used to dump all the radioactive waste from the station. High radiation levels, anomalies all over the place, so there are loads of artifacts to be found there... but not very valuable. Just beware of the gangs and don't cross the Duty patrols. West of the Garbage is the former Agroprom Research Institute. Little in terms of artifacts there so you can skip it. And to the East, there's the Dark Valley. Who knows... That's a pretty weird place. It seems quiet enough, apart from a bunch of gangsters roaming around. But I got a feeling there's more to it than meets the eye. Oh, and there's the Rostok factory right beyond the Garbage. That's Duty territory and a popular stalker hideout. You'll find lots of clued-up folks there, they'll tell you the rest.",
      "JA_current": "それが知りたいだけか？ 1週間後に会いに戻って来てくれ。いいか、俺の時間は安くはない、それにちょっと今は忙しい。ここを基点に、アンタ一人で行くんだ。ここから3キロ北の辺りで、Garbage を見つけるだろう。そこはあらゆる放射性廃棄物を駅からどっさり捨てるのに使われた場所だ。放射能濃度が高く、いたる所にアノーマリーが存在し沢山のアーティファクトを見つけられる… だが、あまり貴重なものはない。ギャングに注意しろ、それに Duty のパトロールは横切るな。Garbage の西は、旧 Agroprom 研究所だ。アーティファクトはほとんど無いから、そこはスッ飛ばしてもかまわない。そして東側に、Dark Valley がある。よくは知らんがね… そこはかなり怪しい場所だ。辺りをうろついている多くのギャングは別として、ずいぶんと静かな場所に見える。だが目に映る多くのものがそこにある感じがするな。ああ、それに Rostok の工場が、Garbage を越えてすぐにある。そこはストーカーの支配地域だ。そこでもっと知っている連中を見つけられると思う、彼らが残りを話してくれるだろう。",
      "JA_new": "それだけでいいのか？ 一週間休んでからまた来てくれ。悪いが俺の時間もタダじゃないし、今は手が離せない。基本だけ話すから、あとは自分で何とかしてくれ。ここから北へ3キロほど行くとガーベジだ。発電所から出る放射性廃棄物を捨ててた場所でな。放射線は強いし、アノマリーだらけだから、アーティファクトはたくさん見つかる……たいした値打ちはないがな。ギャングには気をつけろ。デューティーの巡回にも近づくな。ガーベジの西には、昔のアフロプロム研究所がある。アーティファクトはほとんどないから、行かなくていい。東にはダークバレーだ。さて、どうだかな……妙な場所だよ。ギャングがうろついてる以外は、静かそうに見える。だが、見た目以上に何かある気がする。それから、ガーベジのすぐ向こうにロストク工場がある。デューティーの縄張りで、ストーカーがよくたむろしてる。事情通が大勢いるから、残りはあいつらに聞くといい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "21111",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_88#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 267,
      "string_id": "dialogs_escape_88",
      "occurrence": 1,
      "EN": "Wait... Do you hear that? Damn, it's the very pack that has been chasing me from the Garbage. Help me to finish them - I won't stint you of a reward.",
      "JA_current": "Wait... Do you hear that? Damn, it's the very pack that has been chasing me from the Garbage. Help me to finish them - I won't stint you of a reward.",
      "JA_new": "待て……今の聞こえたか？ くそ、ガーベジから俺を追ってきた群れだ！ 片付けるのを手伝ってくれ。礼は弾むぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "escape_fox_hello_dialog",
          "phrase_id": "31111000",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_89#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 270,
      "string_id": "dialogs_escape_89",
      "occurrence": 1,
      "EN": "Deal. Yeah, they seem to be getting closer. Well, good luck to us!",
      "JA_current": "Deal. Yeah, they seem to be getting closer. Well, good luck to us!",
      "JA_new": "いいだろう。近づいてきてるな。じゃあ、うまくいくよう祈ろう！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
