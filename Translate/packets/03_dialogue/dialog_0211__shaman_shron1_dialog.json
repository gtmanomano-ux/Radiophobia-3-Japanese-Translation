      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 144,
      "string_id": "dialogs_bar_47",
      "occurrence": 1,
      "EN": "Here are the three Meat Chunks.",
      "JA_current": "Here are the three Meat Chunks.",
      "JA_new": "ミートチャンクを3つ持ってきた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
