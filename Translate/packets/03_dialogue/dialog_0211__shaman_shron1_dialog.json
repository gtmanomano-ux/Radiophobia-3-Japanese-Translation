        }
      ]
    },
    {
      "key": "dialogs_bar_gameplay_text:dialogs_bar_44#1",
      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 135,
      "string_id": "dialogs_bar_44",
      "occurrence": 1,
      "EN": "Wanna know some cool hidey holes, huh? I've been around for a while, had a few stashes reserved in case I fell on hard times. I'm thinking of leaving the Zone anyway so I can share some.. But it won't be free - I'm willing to cash them in for some artifacts.",
      "JA_current": "Wanna know some cool hidey holes, huh? I've been around for a while, had a few stashes reserved in case I fell on hard times. I'm thinking of leaving the Zone anyway so I can share some.. But it won't be free - I'm willing to cash them in for some artifacts.",
      "JA_new": "いい隠し場所を知りたいんだろ？俺は長くここにいるから、いざって時のために何か所か隠してある。どうせゾーンを出るつもりだし、教えてやってもいい。ただしタダじゃない。アーティファクトと交換だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron1_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "dialogs_bar_gameplay_text:dialogs_bar_45#1",
      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 138,
      "string_id": "dialogs_bar_45",
      "occurrence": 1,
      "EN": "As is your right. What do you want?",
      "JA_current": "As is your right. What do you want?",
      "JA_new": "それはあんたの勝手だ。何が欲しい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron1_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "dialogs_bar_gameplay_text:dialogs_bar_46#1",
      "source_table": "dialogs_bar_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_bar_gameplay_text.xml",
      "source_xml_line": 141,
      "string_id": "dialogs_bar_46",
      "occurrence": 1,
      "EN": "We'll do it like this. You bring me three Meat Chunks, you'll get a lead on a cache.",
      "JA_current": "We'll do it like this. You bring me three Meat Chunks, you'll get a lead on a cache.",
      "JA_new": "こうしよう。ミートチャンクを3つ持ってきたら、隠し場所を教えてやる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron1_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
