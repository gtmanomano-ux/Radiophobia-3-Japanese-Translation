      "string_id": "dialogs_bar_43",
      "occurrence": 1,
      "EN": "Got any tips for some loot?",
      "JA_current": "Got any tips for some loot?",
      "JA_new": "戦利品の情報、何かないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "shaman_shron1_dialog",
