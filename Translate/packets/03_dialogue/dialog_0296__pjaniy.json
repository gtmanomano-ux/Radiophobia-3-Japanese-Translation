      "string_id": "dialogs_escape_136",
      "occurrence": 1,
      "EN": "As you wish.",
      "JA_current": "As you wish.",
      "JA_new": "分かった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
