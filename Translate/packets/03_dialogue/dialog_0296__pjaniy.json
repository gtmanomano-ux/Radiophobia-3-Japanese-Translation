    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_130#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 393,
      "string_id": "dialogs_escape_130",
      "occurrence": 1,
      "EN": "Mm' dear res... hic... Respe'tful gentleman... hic... I 'ave a pe... petition to forward to ya. Hic... Concern'g my spi... hic...ritual wounds... I beg ya very... hic... mmuch to mmagnani... hic...nanimously assist mme...",
      "JA_current": "Mm' dear res... hic... Respe'tful gentleman... hic... I 'ave a pe... petition to forward to ya. Hic... Concern'g my spi... hic...ritual wounds... I beg ya very... hic... mmuch to mmagnani... hic...nanimously assist mme...",
      "JA_new": "あ、あの……ひっく……紳士さんにお願いが……ひっく……心の傷のことで……どうか、寛大なご配慮を……ひっく……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_131#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 396,
      "string_id": "dialogs_escape_131",
      "occurrence": 1,
      "EN": "What are you saying, Marked One?",
      "JA_current": "What are you saying, Marked One?",
      "JA_new": "何を言ってるんだ、印付き？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:pjaniy_1#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 9,
      "string_id": "pjaniy_1",
      "occurrence": 1,
      "EN": "You know, Marked One, that tinned meat they sell may lead to botulism and twisted bowels... And the vodka around here is sure to be unlicensed, may even cause liver lesions... The sausage is well past its expiry date as well, better let some dogs try it before you eat it...",
      "JA_current": "You know, Marked One, that tinned meat they sell may lead to botulism and twisted bowels... And the vodka around here is sure to be unlicensed, may even cause liver lesions... The sausage is well past its expiry date as well, better let some dogs try it before you eat it...",
      "JA_new": "知ってるか、印付き。売ってる缶詰肉を食べると、ボツリヌス中毒になったり、ひどく腹を壊したりするぞ……ここのウォッカだって無許可の代物だ。肝臓を傷めるかもしれん……ソーセージも賞味期限切れだ。食べる前に、犬に試させたほうがいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_141#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 426,
      "string_id": "dialogs_escape_141",
      "occurrence": 1,
      "EN": "Piss off.",
      "JA_current": "Piss off.",
      "JA_new": "あっちへ行け。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "12",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_132#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 399,
      "string_id": "dialogs_escape_132",
      "occurrence": 1,
      "EN": "Nothing at all. I just got woozy because of vodka.",
      "JA_current": "Nothing at all. I just got woozy because of vodka.",
      "JA_new": "何でもない。ウォッカで酔っただけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_133#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 402,
      "string_id": "dialogs_escape_133",
      "occurrence": 1,
      "EN": "I have a fit of spleen... Keep me company, will ya? I still got some more vodka.",
      "JA_current": "I have a fit of spleen... Keep me company, will ya? I still got some more vodka.",
      "JA_new": "ちょっと気が滅入っててな……付き合ってくれないか？ まだウォッカが残ってる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_138#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 417,
      "string_id": "dialogs_escape_138",
      "occurrence": 1,
      "EN": "Do you know, whippersnapper, that my grandpa has made it to 106 years and keeps fine?!",
      "JA_current": "Do you know, whippersnapper, that my grandpa has made it to 106 years and keeps fine?!",
      "JA_new": "なあ、若造。俺のじいさんは106歳まで生きて、今も元気だって知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_142#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 429,
      "string_id": "dialogs_escape_142",
      "occurrence": 1,
      "EN": "Ok, ok, I'm leaving.",
      "JA_current": "Ok, ok, I'm leaving.",
      "JA_new": "分かった、分かった。もう行くよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "13",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_143#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 432,
      "string_id": "dialogs_escape_143",
      "occurrence": 1,
      "EN": "Screw you, dolt.",
      "JA_current": "Screw you, dolt.",
      "JA_new": "くたばれ、バカ野郎。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "14",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_134#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 405,
      "string_id": "dialogs_escape_134",
      "occurrence": 1,
      "EN": "Well, there's no reason for me to refuse the invitation. And I feel like realaxing a bit.",
      "JA_current": "Well, there's no reason for me to refuse the invitation. And I feel like realaxing a bit.",
      "JA_new": "せっかく誘ってくれたんだ。断る理由もないし、少し羽を伸ばしたい気分だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_135#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 408,
      "string_id": "dialogs_escape_135",
      "occurrence": 1,
      "EN": "Thanks, lad. But I've got no time for that now.",
      "JA_current": "Thanks, lad. But I've got no time for that now.",
      "JA_new": "ありがとう、若いの。でも、今はそんな暇がないんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_139#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 420,
      "string_id": "dialogs_escape_139",
      "occurrence": 1,
      "EN": "He what? Used to eat tinned food with sausage and drank vodka?",
      "JA_current": "He what? Used to eat tinned food with sausage and drank vodka?",
      "JA_new": "そのじいさんがどうした？ 缶詰とソーセージを食べて、ウォッカも飲んでたのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "dialogs_escape_gameplay_text:dialogs_escape_137#1",
      "source_table": "dialogs_escape_gameplay_text",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\dialogs_escape_gameplay_text.xml",
      "source_xml_line": 414,
      "string_id": "dialogs_escape_137",
      "occurrence": 1,
      "EN": "Help yourself.",
      "JA_current": "Help yourself.",
      "JA_new": "好きにしてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "pjaniy",
