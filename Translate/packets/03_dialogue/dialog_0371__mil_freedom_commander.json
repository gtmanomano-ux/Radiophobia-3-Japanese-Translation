  "entries": [
    {
      "key": "stable_dialogs_military:mil_freedom_commander_2001#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 593,
      "string_id": "mil_freedom_commander_2001",
      "occurrence": 1,
      "EN": "Stake out your own spot 'cause later you won't have time!",
      "JA_current": "後々時間がないだろうから、持ち場を見張ってくれ！",
      "JA_new": "場所を決めておけ。後になったら選んでる暇はないぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "2001",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_3001#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 596,
      "string_id": "mil_freedom_commander_3001",
      "occurrence": 1,
      "EN": "Looks like we took them all down. I say that's enough for today. Thanks for your help! Here, take this - a little bit of money to cheer you up.",
      "JA_current": "敵を全員やっつけたようだな。今日のところは十分だ。協力に感謝する。これは謝礼だ。受け取ってくれ。",
      "JA_new": "どうやら全員片付けたようだ。今日はここまでだな。助かったよ。ほら、気分が明るくなるように小遣いだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "3001",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_4003#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 611,
      "string_id": "mil_freedom_commander_4003",
      "occurrence": 1,
      "EN": "You're just in time. We're fending off the Monolith jerks, and the next wave is almost here! Believe it or not, we just had our last sniper knocked off! Can you help? We'll pay back after the fight - you won't be sorry!",
      "JA_current": "いいとこにきたな。今モノリス信者の急襲を防衛していて、次の襲撃がもうすぐなんだ。こんなことを言っても信じないだろうが、ちょうど最後のスナイパーがやられたとこなんだ。助けてくれないか？ 戦闘の後ちゃんと礼はする、後悔はさせんよ！",
      "JA_new": "ちょうどいい時に来たな。モノリスのクソどもを食い止めてる。次の波もすぐそこだ。信じられないだろうが、最後のスナイパーまでやられた！手を貸してくれないか？戦いが終わったら報酬を払う。後悔はさせない！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "4003",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_3003#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 602,
      "string_id": "mil_freedom_commander_3003",
      "occurrence": 1,
      "EN": "Good luck, Marked One!",
      "JA_current": "Marked One、幸運を祈る！",
      "JA_new": "幸運を祈る、マークドワン！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "3003",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_3002#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 599,
      "string_id": "mil_freedom_commander_3002",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "JA_new": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "3002",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1004#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 569,
      "string_id": "mil_freedom_commander_1004",
      "occurrence": 1,
      "EN": "As clean as a whistle.",
      "JA_current": "きれいさっぱり片付けようか。",
      "JA_new": "準備万端だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1004",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1005#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 572,
      "string_id": "mil_freedom_commander_1005",
      "occurrence": 1,
      "EN": "As it should be. I hope to talk to you in the morning. Oh, and don't walk off too far... Or I might think you've decided to run off. And that would mean you-know-what, so keep that in mind! Now, assume your position.",
      "JA_current": "そうなるといいな。明日の朝、君とまだ会話ができるといいが。そうそう、あんまり遠くには行かんでくれ。じゃないと、君が逃げ出したんだと思うからな。私がそう思ったら、君も知ってのとおりの結末になる。だから、気をつけてくれ！ さぁ、配置についてくれ。",
      "JA_new": "それでいい。朝にまた話そう。あまり遠くへ行くなよ……逃げるつもりだと思っちまう。そうなったら、例の件になるからな。覚えておけ。さあ、持ち場につけ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1005",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1007#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 575,
      "string_id": "mil_freedom_commander_1007",
      "occurrence": 1,
      "EN": "That's right. OK, let's get to work. A Monolith group might be trying to break through here. That means it's gonna get hot real soon.",
      "JA_current": "それでいい。よし、仕事に取り掛かろう。Monolith の集団は、ここを突破しようとするかもしれない。その意味で、もう間もなく熱い戦いになりそうだ。",
      "JA_new": "そうだ。よし、始めよう。モノリスの一団がここを突破しようとするかもしれない。すぐに激戦になるぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1007",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1008#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 578,
      "string_id": "mil_freedom_commander_1008",
      "occurrence": 1,
      "EN": "Got it.",
      "JA_current": "分かった。",
      "JA_new": "分かった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1008",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1009#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 581,
      "string_id": "mil_freedom_commander_1009",
      "occurrence": 1,
      "EN": "You're right. I hope they won't be too many...",
      "JA_current": "だろうな。ヤツらが多すぎないことを願うよ…。",
      "JA_new": "そうだな。あまり大勢じゃないといいが……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1009",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1010#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 584,
      "string_id": "mil_freedom_commander_1010",
      "occurrence": 1,
      "EN": "Where is my place?",
      "JA_current": "俺の持ち場はどこだ？",
      "JA_new": "俺の持ち場はどこだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1010",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1011#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 587,
      "string_id": "mil_freedom_commander_1011",
      "occurrence": 1,
      "EN": "Go to the tower, there's a Dragunov and some ammo. You'll be able to pick them off from above, but don't come down - you may get caught in the crossfire. Is the assignment clear?",
      "JA_current": "櫓へ登れ、Dragunov といくらかの弾薬があるぞ。上でそれらが手に入る、だが下へは降りるな ― 仲間の銃弾に気を付けろ。以上、分かったか？",
      "JA_new": "塔へ行け。ドラグノフと弾薬がある。上から狙撃できるが、降りてくるな。味方の銃撃に巻き込まれるぞ。任務は理解したか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_freedom_commander",
          "phrase_id": "1011",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_freedom_commander_1012#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 590,
      "string_id": "mil_freedom_commander_1012",
      "occurrence": 1,
      "EN": "Yes.",
      "JA_current": "あぁ。",
      "JA_new": "ああ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
