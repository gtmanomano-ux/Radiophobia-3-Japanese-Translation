      "string_id": "sahar_magnetto_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Professor, help me. Some crap is stuck onto me, it's affecting my strength, and I don't know how to get rid of it!",
      "JA_current": "Professor, help me. Some crap is stuck onto me, it's affecting my strength, and I don't know how to get rid of it!",
      "JA_new": "教授、助けてくれ。何かが体に張り付いて、力が出ないんだ。どうやって取り除けばいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_magnetto_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
