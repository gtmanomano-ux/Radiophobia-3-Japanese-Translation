      "source_xml_line": 933,
      "string_id": "sahar_magnetto_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Oh, what a lovely specimen of Magnetos Lymphophagus! Where did you find it?",
      "JA_current": "Oh, what a lovely specimen of Magnetos Lymphophagus! Where did you find it?",
      "JA_new": "おお、なんと見事なマグネトス・リンフォファガスだ！ どこで見つけたんだね？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_magnetto_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:sahar_magnetto_dialog_phrase_3#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 936,
      "string_id": "sahar_magnetto_dialog_phrase_3",
      "occurrence": 1,
      "EN": "I'm not up for scientific terms right now! Just tell me what to do to get rid of it.",
      "JA_current": "I'm not up for scientific terms right now! Just tell me what to do to get rid of it.",
      "JA_new": "今は科学用語なんか聞いてる場合じゃない！ どうすれば取れるのかだけ教えてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_magnetto_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:sahar_magnetto_dialog_phrase_4#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 939,
      "string_id": "sahar_magnetto_dialog_phrase_4",
      "occurrence": 1,
      "EN": "To get rid of this parasite, you need to irradiate it with infrared radiation of a special wavelength. For this purpose, a special device called the Sokolov Model 17-B Infrared Radiator, or IIRS-17B for short, has been developed.",
      "JA_current": "To get rid of this parasite, you need to irradiate it with infrared radiation of a special wavelength. For this purpose, a special device called the Sokolov Model 17-B Infrared Radiator, or IIRS-17B for short, has been developed.",
      "JA_new": "この寄生生物を取り除くには、特定の波長の赤外線を当てる必要がある。そのために、ソコロフ式17-B赤外線照射器という装置が開発された。略称はIIRS-17Bだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_magnetto_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
