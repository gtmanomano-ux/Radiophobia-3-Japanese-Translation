      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 942,
      "string_id": "sahar_magnetto_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Get that device over here, quick, and let's go!",
      "JA_current": "Get that device over here, quick, and let's go!",
      "JA_new": "それをすぐ持ってきてくれ。急いでくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_magnetto_dialog",
