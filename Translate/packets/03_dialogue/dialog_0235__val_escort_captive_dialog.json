        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_511#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 236,
      "string_id": "val_escort_captive_dialog_511",
      "occurrence": 1,
      "EN": "Bye.",
      "JA_current": "じゃあな。",
      "JA_new": "じゃあな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "511",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_11#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 212,
      "string_id": "val_escort_captive_dialog_11",
      "occurrence": 1,
      "EN": "Bandits! Those sons of bitches were taking me to the old factory. I don't know what they were planning to do with me there. I saw them take another guy in there before and I never saw him after that. They've got another one of ours, Serega. They keep him in the basement... in that big unfinished building there. Help him, would ya? Otherwise they'll... you know...",
      "JA_current": "Bandits! あいつらロクデナシどもは、俺を古い工場に連れて行く途中だった。連中、俺に何をしようと計画してたのかは判らねぇが。俺は以前、連中が他の奴を連れて行くのを見たことがあるが、その後そいつを一切見かけねぇ。俺たち仲間の1人、Seregaを 連中は連れて行ったが、連中はあいつを地下室に監禁してる… そこの大きな建築途中のビルだ。あいつを助けてくれ。やってくれるか？ さもなくば連中は… どうするか分かるだろ…。",
      "JA_new": "バンディットだ！あのクソ野郎どもに旧工場へ連れていかれるところだった。そこで何をするつもりだったかは知らない。前にも別の奴が連れていかれるのを見たが、それきり姿を見てないんだ。仲間のセレガも捕まってる。地下に……あそこにある大きな未完成の建物だ。助けてやってくれ。そうしないと奴ら……分かるだろ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_41#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 227,
      "string_id": "val_escort_captive_dialog_41",
      "occurrence": 1,
      "EN": "It's a shame about my partner... He was a great guy. But still, I owe you.",
      "JA_current": "これは相棒には恥ずかしいが… あいつはたいした奴だった、だがそれでも、あんたに任すよ。",
      "JA_new": "相棒のことは残念だ……いい奴だったのに。でも、あんたには借りができた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_21#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 218,
      "string_id": "val_escort_captive_dialog_21",
      "occurrence": 1,
      "EN": "I haven't heard much. All I know is that their boss Borov has some type of key around his neck that fits to the underground door there. Supposed to lead into some type of lab, or something... I did hear that Borov has been eager to get inside, but can't without the second half of the key. Now, if you're thinking of trying to get inside that compound, think twice before you do. It's full of thugs.",
      "JA_current": "多くは聞いてねぇ。俺が知ってるのは、連中の親玉 Borov が、ここの地下への鍵の一部を持ってることだけだ。研究室だか何かがあってその… 俺は Borov が中に入りたがってるとは聞いたが、鍵の後半が無くては叶わないらしい。ううむ、もしあんたが中に入ろうと考えてるんなら、2度考え直せ。中は暴漢でいっぱいだ。",
      "JA_new": "詳しくは知らない。ボロフって頭が、地下扉に合うらしい鍵を首から下げてる。それは研究所か何かにつながってるそうだ……ボロフは中に入りたがってるらしいが、鍵のもう半分がないと開けられない。もし基地に入ろうと思ってるなら、よく考えた方がいい。チンピラだらけだからな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_51#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 233,
      "string_id": "val_escort_captive_dialog_51",
      "occurrence": 1,
      "EN": "Thanks for your help!",
      "JA_current": "助力に感謝する！",
      "JA_new": "助けてくれてありがとう！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "51",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_411#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 230,
      "string_id": "val_escort_captive_dialog_411",
      "occurrence": 1,
      "EN": "These things happen.",
      "JA_current": "それらが起こった。",
      "JA_new": "そういうこともある。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
