  "entries": [
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_61#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 239,
      "string_id": "val_escort_captive_dialog_61",
      "occurrence": 1,
      "EN": "You don't give a damn about people. What's there to discuss between you and me?",
      "JA_current": "あんたがそいつらを気にしないんじゃ、俺とあんたで話し合う余地があるか？",
      "JA_new": "人のことなんてどうでもいいんだろ。あんたと話すことは何もない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "61",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_2#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 215,
      "string_id": "val_escort_captive_dialog_2",
      "occurrence": 1,
      "EN": "Do you know what they've got there at the factory?",
      "JA_current": "連中がその工場で何を得たのか知ってるか？",
      "JA_new": "工場に何があるか知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_3#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 224,
      "string_id": "val_escort_captive_dialog_3",
      "occurrence": 1,
      "EN": "I'll try to help your man.",
      "JA_current": "その男の救出、やってみるよ。",
      "JA_new": "仲間を助けてみるよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_captive_dialog",
