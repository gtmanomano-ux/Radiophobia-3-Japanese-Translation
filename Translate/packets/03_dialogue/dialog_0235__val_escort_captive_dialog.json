    {
      "key": "stable_dialogs_darkvalley:val_escort_captive_dialog_211#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 221,
      "string_id": "val_escort_captive_dialog_211",
      "occurrence": 1,
      "EN": "Gotcha. Thanks, I'll keep it in mind.",
      "JA_current": "了解。感謝する。心に止めておくよ。",
      "JA_new": "分かった。ありがとう、覚えておくよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
