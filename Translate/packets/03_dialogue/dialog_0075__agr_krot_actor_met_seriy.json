    },
    {
      "key": "stable_dialogs_agroprom:agr_krot_actor_met_seriy_250#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 87,
      "string_id": "agr_krot_actor_met_seriy_250",
      "occurrence": 1,
      "EN": "I don't know anything else. I told you everything I knew and now you have to work it out on your own. Good luck to you.",
      "JA_current": "いや、他には知らないな。俺は洗いざらい話したし、とにかくお前が1人でそれを片付けなきゃならないってことだよ。幸運を祈るぜ。",
      "JA_new": "もう何も知らない。知ってることは全部話した。あとは自分で何とかしな。幸運を祈るよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
