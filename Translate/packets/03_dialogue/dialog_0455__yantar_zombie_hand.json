                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  182,
                        "string_id":  "podumai_horoshenko",
                        "occurrence":  1,
                        "EN":  "Maybe you reconsider your decision. My offer is alluring indeed! I will be looking forward to your making the right decision to help the science.",
                        "JA_current":  "Maybe you reconsider your decision. My offer is alluring indeed! I will be looking forward to your making the right decision to help the science.",
                        "JA_new":  "考え直してもいいんですよ。魅力的な条件でしょう？ 科学のために力を貸す決断をしてくれると期待しています。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
