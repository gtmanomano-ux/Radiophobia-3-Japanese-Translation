                    },
                    {
                        "key":  "stable_dialogs_yantar:4to_imenno#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  154,
                        "string_id":  "4to_imenno",
                        "occurrence":  1,
                        "EN":  "May you, please, be more specific?",
                        "JA_current":  "May you, please, be more specific?",
                        "JA_new":  "もう少し詳しく聞かせてもらえますか？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "1",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_yantar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_yantar:raspravilsa_s_zombi#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  158,
                        "string_id":  "raspravilsa_s_zombi",
                        "occurrence":  1,
                        "EN":  "I have \"calmed down\" a band of exploding zombies and there was a hand among their remains. It is warm, glowing and it seems to protect against radiation...",
                        "JA_current":  "I have \"calmed down\" a band of exploding zombies and there was a hand among their remains. It is warm, glowing and it seems to protect against radiation...",
                        "JA_new":  "爆発するゾンビの一団を「鎮めた」んだが、その残骸から手が出てきた。温かくて光ってる。放射線も防いでくれるみたいだ……。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "2",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_yantar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_yantar:neuzheli_ruka#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  162,
                        "string_id":  "neuzheli_ruka",
                        "occurrence":  1,
                        "EN":  "Marked One! Have you really happened to find a hand of the legendary zombie-kamikaze?! If so, than it is going to advance our research work greatly! We haven\u0027t ever experienced any material evidence of zombie-kamikaze\u0027s existence! Only Ghost told me about how he had met them, but I thought he was spinning a yarn... You are to give this artifact to me for research!.. Do not worry about the payment! If my investigation proves that it is really the specimen you claim it to be - the reward is going to be remarkable!",
                        "JA_current":  "Marked One! Have you really happened to find a hand of the legendary zombie-kamikaze?! If so, than it is going to advance our research work greatly! We haven\u0027t ever experienced any material evidence of zombie-kamikaze\u0027s existence! Only Ghost told me about how he had met them, but I thought he was spinning a yarn... You are to give this artifact to me for research!.. Do not worry about the payment! If my investigation proves that it is really the specimen you claim it to be - the reward is going to be remarkable!",
                        "JA_new":  "マークドワン！ 伝説の自爆ゾンビの手を本当に見つけたのですか！？ だとしたら、研究が大きく前進します！ 自爆ゾンビが実在したという物証は、一度も確認できていません。ゴーストから遭遇した話を聞いたことはありますが、作り話だと思っていました……。そのアーティファクトを研究用に譲ってください！ 報酬のことは心配しないでください。私の見立てが正しければ、相応の報酬をお渡しします！",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "3",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_yantar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_yantar:horosho#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  166,
                        "string_id":  "horosho",
                        "occurrence":  1,
                        "EN":  "Glad to hear that! You may have the hand.",
                        "JA_current":  "Glad to hear that! You may have the hand.",
                        "JA_new":  "それはよかった！ 手を渡そう。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "31",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_yantar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_yantar:priberegu#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  170,
                        "string_id":  "priberegu",
                        "occurrence":  1,
                        "EN":  "Excuse me, Professor, but I\u0027d prefer to keep it for myself.",
                        "JA_current":  "Excuse me, Professor, but I\u0027d prefer to keep it for myself.",
                        "JA_new":  "すみません、教授。でも自分で持っておきたい。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "32",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_yantar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_yantar:provedu_issledovanie#1",
                        "source_table":  "stable_dialogs_yantar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
                        "source_xml_line":  174,
                        "string_id":  "provedu_issledovanie",
                        "occurrence":  1,
                        "EN":  "That is awesome, Marked One!.. Take a walk now - I need some time to perform some initial tests.",
                        "JA_current":  "That is awesome, Marked One!.. Take a walk now - I need some time to perform some initial tests.",
                        "JA_new":  "すばらしい、マークドワン！ ……少し出ていてください。予備検査に時間が必要です。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "yantar_zombie_hand",
                                               "phrase_id":  "311",
