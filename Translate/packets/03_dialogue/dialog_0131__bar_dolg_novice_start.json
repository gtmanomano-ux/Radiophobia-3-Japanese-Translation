          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_novice_start_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1427,
      "string_id": "bar_dolg_novice_start_6",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "JA_new": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_novice_start",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_novice_start_31#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1412,
      "string_id": "bar_dolg_novice_start_31",
      "occurrence": 1,
      "EN": "We've been here since the beginning. The first group was made up of the surviving members of special units sent into the Zone to find out what caused it to appear. We found ourselves in pretty dire circumstances. After half of the unit died horribly, those who survived swore that they wouldn't leave here until they understood what is going on in the Zone..  Until they defeat it.",
      "JA_current": "俺たちは、ずっと前からここにいる。発生原因を探るべくゾーンに送られた、特殊部隊の生き残りたち。最初のグループは彼らで構成されていたんだ。気付けば、俺たちの状況はかなりひどいことになっていた。部隊の半分が壮絶な死をとげた。生き残った者たちは、ここを去らないと誓ったんだ。何がゾーンに起こっているかを理解するまで… ゾーンを打破するまで。",
      "JA_new": "俺たちは最初からここにいる。最初の部隊は、ゾーンが現れた原因を探るために送り込まれた特殊部隊の生き残りでできていた。かなりひどい状況だったよ。半数が無残に死に、生き残った者たちはゾーンの真相を突き止めるまでここを離れないと誓った……ゾーンを倒すまでな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_novice_start",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_novice_start_41#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1418,
      "string_id": "bar_dolg_novice_start_41",
      "occurrence": 1,
      "EN": "They're thugs who don't understand that the Zone is an ulcer on Earth's body. They want to spread it all over the world, a piece in every household. They'll do anything to achieve that goal and I can't wait to put an end to it.",
      "JA_current": "ヤツらは残忍だ。ゾーンが大地の源の病根であることを理解してない。ヤツらは世界中にゾーンを拡大させようとしている、どの家庭にも1つずつな。その目標を達成するためには何でもする。俺はこいつに、終止符を打ちたくてたまらないんだ。",
      "JA_new": "あいつらは、ゾーンが地球にできた潰瘍だと分かってないチンピラだ。世界中にゾーンを広げて、どの家庭にも一つずつ置きたいんだとさ。そのためなら何でもする。俺が終わらせてやる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_novice_start",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_novice_start_51#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1424,
      "string_id": "bar_dolg_novice_start_51",
      "occurrence": 1,
      "EN": "Yes, and we manage to do so to a large degree. During the cleaning operations, whole swarms of mutants on the way to the Zone's center are destroyed.",
      "JA_current": "そうだ、俺たちはかなり成し遂げている。掃討作戦によって、ゾーン中心部への道程上のミュータントの大群は、全て壊滅済みだ。",
      "JA_new": "ああ、そしてかなりの成果を上げてる。浄化作戦で、ゾーンの中心へ向かうミュータントの群れを丸ごと始末してるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_novice_start",
          "phrase_id": "51",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    }
