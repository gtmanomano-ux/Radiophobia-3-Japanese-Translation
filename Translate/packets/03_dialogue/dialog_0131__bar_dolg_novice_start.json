    {
      "key": "stable_dialogs_bar:bar_dolg_novice_start_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1421,
      "string_id": "bar_dolg_novice_start_5",
      "occurrence": 1,
      "EN": "You want to defeat the Zone?",
      "JA_current": "ゾーンを打ち破りたいのか？",
      "JA_new": "ゾーンを倒すつもりなのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_novice_start",
