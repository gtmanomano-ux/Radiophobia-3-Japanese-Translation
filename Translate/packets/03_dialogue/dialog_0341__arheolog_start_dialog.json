    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_4#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 268,
      "string_id": "arheolog_start_dialog_phrase_4",
      "occurrence": 1,
      "EN": "What do you mean?",
      "JA_current": "What do you mean?",
      "JA_new": "どういうことだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
