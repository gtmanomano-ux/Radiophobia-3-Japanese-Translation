    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_5#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 271,
      "string_id": "arheolog_start_dialog_phrase_5",
      "occurrence": 1,
      "EN": "If you don't hurt me, I'll pay you back. I'll give you the coordinates of my best cache of old military weapons: There are rifles of various calibers, pistols and ammunition there. You won't find this kind of stuff at the dealers.",
      "JA_current": "If you don't hurt me, I'll pay you back. I'll give you the coordinates of my best cache of old military weapons: There are rifles of various calibers, pistols and ammunition there. You won't find this kind of stuff at the dealers.",
      "JA_new": "俺を見逃してくれるなら、礼をする。最高の旧軍用武器を隠した場所を教えるよ。さまざまな口径のライフルに、拳銃、弾薬もある。こんな品は商人じゃ手に入らない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_6#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 274,
      "string_id": "arheolog_start_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Yeah, and there's a centimeter thick layer of rust all over it too, right?",
      "JA_current": "Yeah, and there's a centimeter thick layer of rust all over it too, right?",
      "JA_new": "どうせ、全部に1センチくらい錆が浮いてるんだろ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_7#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 277,
      "string_id": "arheolog_start_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Not at all, I personally restore, lubricate, and check every gun I find... Stalker, don't do anything stupid. Why do you need all this squabbling between factions? If you kill me, it won't change anything, believe me. And this way you'll also get a profit.",
      "JA_current": "Not at all, I personally restore, lubricate, and check every gun I find... Stalker, don't do anything stupid. Why do you need all this squabbling between factions? If you kill me, it won't change anything, believe me. And this way you'll also get a profit.",
      "JA_new": "そんなことはない。見つけた銃は全部、俺が修復して油を差し、動作を確かめてる。ストーカー、馬鹿な真似はするな。派閥同士の争いに、そこまで首を突っ込む必要があるか？俺を殺しても何も変わらない。信じてくれ。見逃せば、あんたにも得がある。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_8#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 280,
      "string_id": "arheolog_start_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Stop trying to talk me out of it. Die, you bastard!",
      "JA_current": "Stop trying to talk me out of it. Die, you bastard!",
      "JA_new": "口を挟むな。死ね、この野郎！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_9#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 283,
      "string_id": "arheolog_start_dialog_phrase_9",
      "occurrence": 1,
      "EN": "Fuck it, tell me where your hiding place is.",
      "JA_current": "Fuck it, tell me where your hiding place is.",
      "JA_new": "くそっ、隠し場所を教えろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:arheolog_start_dialog_phrase_10#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 286,
      "string_id": "arheolog_start_dialog_phrase_10",
      "occurrence": 1,
      "EN": "I knew you were a decent stalker, and not some contract killer scumbag! Listen to me carefully: the cache is in that booth over there with the two tanks and the grid across from these ruins.",
      "JA_current": "I knew you were a decent stalker, and not some contract killer scumbag! Listen to me carefully: the cache is in that booth over there with the two tanks and the grid across from these ruins.",
      "JA_new": "まともなストーカーでよかったよ。雇われの殺し屋みたいなクズじゃなくてな！よく聞け。隠し場所は、廃墟の向かいにある、タンクが2つと格子の付いた小屋だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "arheolog_start_dialog",
