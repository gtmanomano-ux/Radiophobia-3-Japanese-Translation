  "entries": [
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_1#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 702,
      "string_id": "trofim_start_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Ermm, hey there buddy.. Are you Trofim, by any chance?",
      "JA_current": "Ermm, hey there buddy.. Are you Trofim, by any chance?",
      "JA_new": "ええと、よう……あんたがトロフィムか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_2#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 705,
      "string_id": "trofim_start_dialog_phrase_2",
      "occurrence": 1,
      "EN": "It's hard to see... Who's standing there... Hard to see.. Who is this... I can't see... Very dark....",
      "JA_current": "It's hard to see... Who's standing there... Hard to see.. Who is this... I can't see... Very dark....",
      "JA_new": "よく見えない……そこにいるのは誰だ……よく見えない……誰だ……見えない……真っ暗だ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_3#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 708,
      "string_id": "trofim_start_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Listen, your boss Yuri sent me to find you. What happened to the Seekers? Why did the expedition fail?",
      "JA_current": "Listen, your boss Yuri sent me to find you. What happened to the Seekers? Why did the expedition fail?",
      "JA_new": "なあ、あんたの上司のユーリに頼まれて捜しに来た。探索隊はどうなった？ 遠征はなぜ失敗した？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_4#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 711,
      "string_id": "trofim_start_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Where?",
      "JA_current": "Where?",
      "JA_new": "どこだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_5#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 714,
      "string_id": "trofim_start_dialog_phrase_5",
      "occurrence": 1,
      "EN": "The Seekers you worked with, they all ended up dead. Why did they split up?",
      "JA_current": "The Seekers you worked with, they all ended up dead. Why did they split up?",
      "JA_new": "一緒に行動してた探索隊のことだ。みんな死んだ。どうしてバラバラになった？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_6#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 717,
      "string_id": "trofim_start_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Spinning... Everyone spinning... Everyone spinning all around the circle...",
      "JA_current": "Spinning... Everyone spinning... Everyone spinning all around the circle...",
      "JA_new": "回ってる……みんな回ってる……輪になって、みんな回ってる……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_7#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 720,
      "string_id": "trofim_start_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Do you remember anything at all?",
      "JA_current": "Do you remember anything at all?",
      "JA_new": "何か覚えてないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_8#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 723,
      "string_id": "trofim_start_dialog_phrase_8",
      "occurrence": 1,
      "EN": "It's dark... Very dark...",
      "JA_current": "It's dark... Very dark...",
      "JA_new": "暗い……すごく暗い……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_9#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 726,
      "string_id": "trofim_start_dialog_phrase_9",
      "occurrence": 1,
      "EN": "Why is it dark? Was it at night? Were you ambushed? Or what?",
      "JA_current": "Why is it dark? Was it at night? Were you ambushed? Or what?",
      "JA_new": "どうして暗い？ 夜だったのか？ 待ち伏せされた？ それとも何があった？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "8",
