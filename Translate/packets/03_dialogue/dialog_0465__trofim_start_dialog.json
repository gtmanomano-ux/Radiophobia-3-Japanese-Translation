      "string_id": "trofim_start_dialog_phrase_10",
      "occurrence": 1,
      "EN": "Why is it so dark...?",
      "JA_current": "Why is it so dark...?",
      "JA_new": "どうしてこんなに暗い……？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
