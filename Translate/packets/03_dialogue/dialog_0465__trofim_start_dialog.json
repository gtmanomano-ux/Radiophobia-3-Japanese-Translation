    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_11#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 732,
      "string_id": "trofim_start_dialog_phrase_11",
      "occurrence": 1,
      "EN": "Do you understand anything I'm saying?",
      "JA_current": "Do you understand anything I'm saying?",
      "JA_new": "俺の言ってること、分かるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_12#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 735,
      "string_id": "trofim_start_dialog_phrase_12",
      "occurrence": 1,
      "EN": "I don't understand... I don't understand nothing... Nothing... Nothing... Can't understand...",
      "JA_current": "I don't understand... I don't understand nothing... Nothing... Nothing... Can't understand...",
      "JA_new": "分からない……何も分からない……何も……何も……分からない……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:trofim_start_dialog_phrase_13#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 738,
      "string_id": "trofim_start_dialog_phrase_13",
      "occurrence": 1,
      "EN": "Is there nothing you can give me?? Actually, forget it, this is going nowhere... You poor bastard...",
      "JA_current": "Is there nothing you can give me?? Actually, forget it, this is going nowhere... You poor bastard...",
      "JA_new": "何か教えてくれないか？……いや、もういい。これじゃ話にならないな……気の毒に。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "trofim_start_dialog",
