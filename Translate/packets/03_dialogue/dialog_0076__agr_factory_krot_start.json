    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_3001#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 30,
      "string_id": "agr_factory_krot_start_3001",
      "occurrence": 1,
      "EN": "Yeah, we looked for it too but couldn't find it. I'll send you some info about it. That's everything we have on the stash.",
      "JA_current": "ああ、俺たちも探したが見つけられなかった。せっかくだから俺が知ってることは全部教えてやるよ。",
      "JA_new": "ああ、俺たちも探したが見つからなかった。隠し場所の情報を送るよ。知ってるのはそれで全部だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
