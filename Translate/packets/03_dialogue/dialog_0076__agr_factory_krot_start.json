  "entries": [
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_0#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 3,
      "string_id": "agr_factory_krot_start_0",
      "occurrence": 1,
      "EN": "Thanks for your help, stalker! If you hadn't shown up, I'd be a dead man by now.",
      "JA_current": "助かったよ。お前さんが助けてくれなかったら、今頃あの世に行ってるところだったぜ。",
      "JA_new": "助けてくれてありがとう、ストーカー！ あんたが来なかったら、今ごろ死んでたよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_2#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 24,
      "string_id": "agr_factory_krot_start_2",
      "occurrence": 1,
      "EN": "I'm looking for info on Strelok. Seriy told me you know something about him.",
      "JA_current": "俺は Strelok の情報を探してるんだ。Seriy からアンタが奴のことを何か知ってると聞いて来たんだが。",
      "JA_new": "ストレロクの情報を探してる。セリーから、あんたが何か知ってると聞いた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_10001#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 6,
      "string_id": "agr_factory_krot_start_10001",
      "occurrence": 1,
      "EN": "I am looking for information about Strelok, maybe you know something?",
      "JA_current": "Strelok の情報を探してるんだが、あんた何か知らないか？",
      "JA_new": "ストレロクの情報を探してる。あんた、何か知らないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "10001",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_10002#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 9,
      "string_id": "agr_factory_krot_start_10002",
      "occurrence": 1,
      "EN": "How do I get into the basement?",
      "JA_current": "地下にはどうやって潜り込めばいい？",
      "JA_new": "地下室にはどうやって入る？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "10002",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_1501#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 18,
      "string_id": "agr_factory_krot_start_1501",
      "occurrence": 1,
      "EN": "Yes, I heard about that. They even say he used to \"work\" in these parts and Strelok's stash is in the local basements. Rumor has it that his group's base was here too.",
      "JA_current": "ああ、こんなことを聞いたことがある。この地下でヤツが何か「やっていた」とか。Strelok の隠し場所があるとか… やつのグループのアジトがここにあったって噂も聞いたな。",
      "JA_new": "ああ、その話なら聞いたことがある。あいつは昔この辺で「仕事」をしてたらしい。それに、ストレロクの隠し物資が地下室にあるって噂だ。仲間の拠点もここにあったらしい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "1501",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_factory_krot_start_1502#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 21,
      "string_id": "agr_factory_krot_start_1502",
      "occurrence": 1,
      "EN": "This is one of the many exits which will lead you into the interconnected basements. Once you're in there, you're on your own - I don't have a map and the basement network is huge and confusing.",
      "JA_current": "ここがゴチャゴチャした地下に繋がってる入り口の1つだ。一旦中に入っちまえば、後はお前さん次第だぜ。俺は地図を持ってないし、地下通路は広大で入り組んでる。",
      "JA_new": "ここも、地下室同士をつなぐ出口のひとつだ。中に入ったら自分で何とかしてくれ。地図はないし、地下道は広くて入り組んでる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_factory_krot_start",
          "phrase_id": "1502",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
