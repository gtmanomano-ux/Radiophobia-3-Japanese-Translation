      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 15,
      "string_id": "agr_factory_krot_start_15002",
      "occurrence": 1,
      "EN": "Thanks for the information.",
      "JA_current": "ありがとう。タメになった。",
      "JA_new": "情報ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
