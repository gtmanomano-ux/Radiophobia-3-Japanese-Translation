      "occurrence": 1,
      "EN": "Strelok's secret stash?",
      "JA_current": "Strelok の秘密の隠し場所？",
      "JA_new": "ストレロクの隠し場所？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
