      "source_xml_line": 263,
      "string_id": "paladin_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Well, take it easy, or Monolith will be offended. I need to pass, make way.",
      "JA_current": "Well, take it easy, or Monolith will be offended. I need to pass, make way.",
      "JA_new": "まあ落ち着けよ。モノリスが怒るぞ。通りたいんだ、道を開けてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
