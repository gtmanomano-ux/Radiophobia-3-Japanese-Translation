      "source_xml_line": 257,
      "string_id": "paladin_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Hello... What's your name? Abbot? Pilgrim? I don't know much about your ranks.",
      "JA_current": "Hello... What's your name? Abbot? Pilgrim? I don't know much about your ranks.",
      "JA_new": "こんにちは……あんたのこと、何と呼べばいい？ 修道院長？ 巡礼者？ そっちの階級には疎くてさ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "paladin_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:paladin_dialog_phrase_2#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 260,
      "string_id": "paladin_dialog_phrase_2",
      "occurrence": 1,
      "EN": "If it weren't for that shard of the sacred Solar Sphere, I'd blow your stupid savage brains out with one blow! Celebrate your second birth, O infidel...",
      "JA_current": "If it weren't for that shard of the sacred Solar Sphere, I'd blow your stupid savage brains out with one blow! Celebrate your second birth, O infidel...",
      "JA_new": "あの聖なる太陽の球の欠片がなければ、貴様の野蛮な頭など一撃で吹き飛ばしてやる！ 二度目の生を祝うがいい、異教徒……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "paladin_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
