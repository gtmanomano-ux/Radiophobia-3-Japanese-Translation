      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3038,
      "string_id": "barman_teror_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Can you remember any loners at the bar recently that kept to themselves, were anti-social, maybe had a set of unusual skills or knowledge?",
      "JA_current": "Can you remember any loners at the bar recently that kept to themselves, were anti-social, maybe had a set of unusual skills or knowledge?",
      "JA_new": "最近ロストクに来たローナーで、周りと距離を置いてた奴は覚えてないか？人付き合いが苦手で、妙な技や知識を持ってそうな奴だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_teror_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:barman_teror_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 3041,
      "string_id": "barman_teror_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Heh, you just described the vast majority of stalkers that come to this bar. I get maybe fifty anti social bastards like that each day, and they all have a unique set of skills, how else are you going to survive out here?? Ask Snitch, maybe he knows something.",
      "JA_current": "Heh, you just described the vast majority of stalkers that come to this bar. I get maybe fifty anti social bastards like that each day, and they all have a unique set of skills, how else are you going to survive out here?? Ask Snitch, maybe he knows something.",
      "JA_new": "はは、ここに来るストーカーの大半がそれに当てはまるぞ。毎日50人くらい、愛想のない連中が来る。生き残るにはみんな何かしら腕が要るんだ。スニッチに聞いてみな。何か知ってるかもしれん。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "barman_teror_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
