      "string_id": "barman_teror_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Aren't there enough crazies wandering around the Zone? Especially with the scorcher so close by.",
      "JA_current": "Aren't there enough crazies wandering around the Zone? Especially with the scorcher so close by.",
      "JA_new": "ゾーンには変人がうろついてるだろ。ブレイン・スコーチャーもすぐそこにあるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
