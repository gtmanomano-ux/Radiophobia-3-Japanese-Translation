  "entries": [
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_1#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 586,
      "string_id": "grigor_first_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Hey you, we're here to collect! How about you hand over the money you owe and put this behind you.",
      "JA_current": "Hey you, we're here to collect! How about you hand over the money you owe and put this behind you.",
      "JA_new": "おい、取り立てに来たぞ！　借りた金を返して、これで終わりにしないか。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_2#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 589,
      "string_id": "grigor_first_dialog_phrase_2",
      "occurrence": 1,
      "EN": "I don't recognize you, did those retards over there bring you along as backup? You're not really a part of their group, are you? You look like a normal person, why would you get mixed up with these scumbags.",
      "JA_current": "I don't recognize you, did those retards over there bring you along as backup? You're not really a part of their group, are you? You look like a normal person, why would you get mixed up with these scumbags.",
      "JA_new": "見覚えのない顔だな。あそこにいる間抜けどもが、用心棒に連れてきたのか？　お前もあいつらの仲間ってわけじゃないだろ？　まともそうなのに、どうしてあんなクズとつるんでる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_3#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 592,
      "string_id": "grigor_first_dialog_phrase_3",
      "occurrence": 1,
      "EN": "None of your fucking business! Give me the money or I'll blow your head off!",
      "JA_current": "None of your fucking business! Give me the money or I'll blow your head off!",
      "JA_new": "てめえに関係ねえだろ！　金を出せ。さもないと頭を吹っ飛ばすぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_4#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 598,
      "string_id": "grigor_first_dialog_phrase_4",
      "occurrence": 1,
      "EN": "You wouldn't understand.",
      "JA_current": "You wouldn't understand.",
      "JA_new": "お前には分からないさ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_3_1#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 595,
      "string_id": "grigor_first_dialog_phrase_3_1",
      "occurrence": 1,
      "EN": "No.",
      "JA_current": "No.",
      "JA_new": "いいえ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "3_1",
