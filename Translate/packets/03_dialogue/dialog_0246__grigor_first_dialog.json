    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_5#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 601,
      "string_id": "grigor_first_dialog_phrase_5",
      "occurrence": 1,
      "EN": "What's not to understand? Oh, man, why are so many decent people like you turning to banditry lately? We could all get along and live peacefully, the Zone is a big place and there are plenty of artifacts for us all. So tell me: what makes someone like you decide that it's better to make money by shaking down hard working stalkers? Why don't you join up with us. Together we'll collect plenty of artifacts and will not be left without money, none of us go hungry and there's plenty left over for a vodka or two. Think about it, if we all showed a little bit more solidarity and united together for survival, there would be no one out there willing to resort to crime and robbery, bandits would cease to exist.",
      "JA_current": "What's not to understand? Oh, man, why are so many decent people like you turning to banditry lately? We could all get along and live peacefully, the Zone is a big place and there are plenty of artifacts for us all. So tell me: what makes someone like you decide that it's better to make money by shaking down hard working stalkers? Why don't you join up with us. Together we'll collect plenty of artifacts and will not be left without money, none of us go hungry and there's plenty left over for a vodka or two. Think about it, if we all showed a little bit more solidarity and united together for survival, there would be no one out there willing to resort to crime and robbery, bandits would cease to exist.",
      "JA_new": "何が分からないんだ？　まったく、まともな人間がどうして最近バンディットになるんだろうな。みんなで仲良くやればいい。ゾーンは広いし、アーティファクトだって全員分ある。教えてくれよ。真面目に働くストーカーから金を巻き上げる方がいいと思ったのは、なぜだ？　俺たちと組まないか。一緒にアーティファクトを集めれば、金に困らず、誰も飢えずに済む。ウォッカを二杯飲むくらいの余裕もある。みんなが少しずつ助け合って、生き残るために団結すれば、犯罪や強盗に走る奴もいなくなる。バンディットだっていなくなるはずだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_6#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 604,
      "string_id": "grigor_first_dialog_phrase_6",
      "occurrence": 1,
      "EN": "I don't have time for your fancy speeches. Give me the money! Now!",
      "JA_current": "I don't have time for your fancy speeches. Give me the money! Now!",
      "JA_new": "ご立派な話はいい。金を出せ！　今すぐだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_7#1",
