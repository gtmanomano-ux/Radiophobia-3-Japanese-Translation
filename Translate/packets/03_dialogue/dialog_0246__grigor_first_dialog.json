    {
      "key": "stable_dialogs_darkvalley:grigor_first_dialog_phrase_8#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 613,
      "string_id": "grigor_first_dialog_phrase_8",
      "occurrence": 1,
      "EN": "We'll get rid of them. Don't worry, you made a good decision friend: there are some pals of mine hidden around, waiting for the signal to attack. So, you joining us? Grigorovich's company won't tolerate getting shaken down anymore, believe me.",
      "JA_current": "We'll get rid of them. Don't worry, you made a good decision friend: there are some pals of mine hidden around, waiting for the signal to attack. So, you joining us? Grigorovich's company won't tolerate getting shaken down anymore, believe me.",
      "JA_new": "俺たちで片づける。心配するな、いい判断をしたな。仲間が近くに隠れて、襲撃の合図を待ってる。俺たちに加わるんだな？　グリゴロヴィッチの仲間は、もう金を巻き上げられるままじゃない。信じてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "grigor_first_dialog",
