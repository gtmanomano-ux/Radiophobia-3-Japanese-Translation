      "string_id": "ahill_start_dialog_phrase_1",
      "occurrence": 1,
      "EN": "What brings you here, infidel?",
      "JA_current": "What brings you here, infidel?",
      "JA_new": "何用だ、異教徒？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
