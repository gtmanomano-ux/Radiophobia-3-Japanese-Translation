        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_start_dialog_phrase_2#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 153,
      "string_id": "ahill_start_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Good afternoon, Warden. How's it going? How long have you been sitting here with your boys?",
      "JA_current": "Good afternoon, Warden. How's it going? How long have you been sitting here with your boys?",
      "JA_new": "こんにちは、ウォーデン。調子はどうだ？ 仲間とここに座り込んで、どれくらいになる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_start_dialog_phrase_3#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 156,
      "string_id": "ahill_start_dialog_phrase_3",
      "occurrence": 1,
      "EN": "I have no intention of answering your questions, infidel. But something tells me you're here for a reason... Prove that you came to us with good intentions!",
      "JA_current": "I have no intention of answering your questions, infidel. But something tells me you're here for a reason... Prove that you came to us with good intentions!",
      "JA_new": "質問に答えるつもりはない、異教徒。だが、何か訳があって来たのだろう……善意で来たと証明してみせろ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_start_dialog_phrase_4#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 159,
      "string_id": "ahill_start_dialog_phrase_4",
      "occurrence": 1,
      "EN": "How can I prove it?",
      "JA_current": "How can I prove it?",
      "JA_new": "どう証明すればいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_start_dialog_phrase_5#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 162,
      "string_id": "ahill_start_dialog_phrase_5",
      "occurrence": 1,
      "EN": "There, in the booth near the gate, sits the infidel who wanted to steal the second part of the Sun Sphere from us. Go and execute him, for neither I nor my paladins want to dirty our hands with this wretch. If you do as I command, I will speak to you as an equal.",
      "JA_current": "There, in the booth near the gate, sits the infidel who wanted to steal the second part of the Sun Sphere from us. Go and execute him, for neither I nor my paladins want to dirty our hands with this wretch. If you do as I command, I will speak to you as an equal.",
      "JA_new": "門のそばの詰め所にいるのが、我らから太陽の球の二つ目の欠片を盗もうとした異教徒だ。あの卑劣漢を始末してこい。我らもパラディンも、手を汚す気はない。命令どおりにすれば、対等な者として話をしてやろう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_start_dialog_phrase_6#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 165,
      "string_id": "ahill_start_dialog_phrase_6",
      "occurrence": 1,
      "EN": "I will go now and destroy the infidel.",
      "JA_current": "I will go now and destroy the infidel.",
      "JA_new": "今すぐ異教徒を始末しに行く。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_start_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
