    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_4#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1173,
      "string_id": "mil_screw_dialog_4",
      "occurrence": 1,
      "EN": "No way, did you really bring vodka?",
      "JA_current": "やだなあ、本当にウォッカを持って来たのか？",
      "JA_new": "まさか、本当にウォッカを持ってきたのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
