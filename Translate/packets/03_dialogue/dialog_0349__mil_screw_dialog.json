      "source_xml_line": 1131,
      "string_id": "mil_screw_dialog_1000",
      "occurrence": 1,
      "EN": "You got something that's broken, man?",
      "JA_current": "よお、何か壊れたもん持ってんのかい？",
      "JA_new": "何か壊れたのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1000",
