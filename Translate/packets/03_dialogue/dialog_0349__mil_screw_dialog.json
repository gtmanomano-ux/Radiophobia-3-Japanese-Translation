    {
      "key": "stable_dialogs_military:mil_screw_dialog_1100#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1152,
      "string_id": "mil_screw_dialog_1100",
      "occurrence": 1,
      "EN": "No.",
      "JA_current": "いいや。",
      "JA_new": "いや。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1100",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1200#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1161,
      "string_id": "mil_screw_dialog_1200",
      "occurrence": 1,
      "EN": "Here, take it.",
      "JA_current": "ほら、これを受け取れ。",
      "JA_new": "ほら、持ってけ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1200",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1002#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1137,
      "string_id": "mil_screw_dialog_1002",
      "occurrence": 1,
      "EN": "Ahhh, you're not here to ask for my help? Whew! I'm getting sick and tired of that. As soon as something breaks, they run to me and start whining about it.",
      "JA_current": "あああ、俺に助けを求めて ここに居るんじゃないのか？ ひゅう！ うんざりするよ。何か壊れるとすぐ、みんな俺に助けを求め、愚痴を言い出す。",
      "JA_new": "ああ、俺に修理を頼みに来たんじゃないのか？よかった！もううんざりなんだ。何か壊れると、みんな俺のところに来て文句を言う。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1002",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1101#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1155,
      "string_id": "mil_screw_dialog_1101",
      "occurrence": 1,
      "EN": "It's your loss. If you have some - come in, don't be a stranger.",
      "JA_current": "もったいない。何か持って ― 来いよ、知らんぷりすんなよ。",
      "JA_new": "残念だったな。ウォッカがあるなら、遠慮せず持ってきてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1101",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1201#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1164,
      "string_id": "mil_screw_dialog_1201",
      "occurrence": 1,
      "EN": "Well, thanks! How nice of you. Now I'll have something to help me relax later on.",
      "JA_current": "ああ、ありがとう！ お前は何ていいヤツなんだ。後でくつろぎのひと時を過ごせるよ。",
      "JA_new": "ありがとな！助かるよ。これであとで一息つける。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1201",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1003#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1140,
      "string_id": "mil_screw_dialog_1003",
      "occurrence": 1,
      "EN": "And who are you?",
      "JA_current": "それでアンタは誰なんだ？",
      "JA_new": "あんたは誰だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1003",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1102#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1158,
      "string_id": "mil_screw_dialog_1102",
      "occurrence": 1,
      "EN": "OK.",
      "JA_current": "オーケー。",
      "JA_new": "分かった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1102",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1202#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1167,
      "string_id": "mil_screw_dialog_1202",
      "occurrence": 1,
      "EN": "Good luck.",
      "JA_current": "幸運を。",
      "JA_new": "じゃあな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1202",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1004#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1143,
      "string_id": "mil_screw_dialog_1004",
      "occurrence": 1,
      "EN": "I'm a mechanic. A Mr-Fix-It of sorts... I repair guns and whatever else you bring me. Right now, I'm working on these cars.",
      "JA_current": "俺はメカニックだ。おそまつな Mr-Fix-It… 銃やお前が持ち込んだ他の何でも修理する。ちょうど今、そこらの車を直してる。",
      "JA_new": "整備士だ。まあ、何でも直す係ってとこかな……銃でも、持ち込まれた物は何でも修理する。今はこの車を直してるところだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1004",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1005#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1146,
      "string_id": "mil_screw_dialog_1005",
      "occurrence": 1,
      "EN": "How's it going?",
      "JA_current": "どうやって？",
      "JA_new": "調子はどうだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1005",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_1006#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1149,
      "string_id": "mil_screw_dialog_1006",
      "occurrence": 1,
      "EN": "Pfft! Nothing but rubbish. I'm totally beat. Listen, you got any vodka on you? I'd, umm... you... want a nice scope? The best optics there is!",
      "JA_current": "プスッ！ ゴミしかない。まったく疲れるよ。なあ、ウォッカ持ってるかい？俺は飲みた、うーん… お前… ナイスなスコープが欲しいか？ 最高の性能のがある！",
      "JA_new": "はあ！ガラクタばっかりだ。もうくたくただよ。なあ、ウォッカを持ってないか？その……あんたに……いいスコープをやるよ。最高級の光学照準器だ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
          "phrase_id": "1006",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    }
  ],
