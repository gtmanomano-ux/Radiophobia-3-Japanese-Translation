        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_screw_dialog_2000#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1170,
      "string_id": "mil_screw_dialog_2000",
      "occurrence": 1,
      "EN": "Don't distract me, I'm thinking...",
      "JA_current": "邪魔するな、今考えてるんだ…。",
      "JA_new": "邪魔するな。考え事をしてる……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_screw_dialog",
