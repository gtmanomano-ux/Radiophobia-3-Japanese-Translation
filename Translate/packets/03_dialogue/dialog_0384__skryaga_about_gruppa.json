                        "source_xml_line":  1659,
                        "string_id":  "skryaga_about_gruppa_phrase_1",
                        "occurrence":  1,
                        "EN":  "I have a question. Have any strangers appeared in your ranks lately?",
                        "JA_current":  "I have a question. Have any strangers appeared in your ranks lately?",
                        "JA_new":  "ひとつ聞きたい。最近、仲間に見慣れない奴が来なかったか？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
