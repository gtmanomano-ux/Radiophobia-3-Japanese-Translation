      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 335,
      "string_id": "ahill_second_dialog_phrase_9",
      "occurrence": 1,
      "EN": "I have it.",
      "JA_current": "I have it.",
      "JA_new": "持ってる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
