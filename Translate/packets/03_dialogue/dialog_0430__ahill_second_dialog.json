      "EN": "The prisoner of war was executed.",
      "JA_current": "The prisoner of war was executed.",
      "JA_new": "捕虜を始末した。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
