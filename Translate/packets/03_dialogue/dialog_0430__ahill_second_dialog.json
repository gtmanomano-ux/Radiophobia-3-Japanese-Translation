    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_16#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 356,
      "string_id": "ahill_second_dialog_phrase_16",
      "occurrence": 1,
      "EN": "It's at our base.",
      "JA_current": "It's at our base.",
      "JA_new": "我らの拠点にある。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
