    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_2#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 314,
      "string_id": "ahill_second_dialog_phrase_2",
      "occurrence": 1,
      "EN": "That's great! Now you have earned the right to ask me questions. I am listening to you, warrior.",
      "JA_current": "That's great! Now you have earned the right to ask me questions. I am listening to you, warrior.",
      "JA_new": "よくやった！ これで質問する資格を得たな。話せ、戦士よ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_3#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 317,
      "string_id": "ahill_second_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Who are you and what are you doing here?",
      "JA_current": "Who are you and what are you doing here?",
      "JA_new": "あんたは何者で、ここで何をしてる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_4#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 320,
      "string_id": "ahill_second_dialog_phrase_4",
      "occurrence": 1,
      "EN": "We are the advance party of the Monolith faction called \"The Power of the Great Monolith\". I am the guardian of the elements of the sacred Sphere of the Sun, the right hand of Charon himself. We bring death to the infidels and extend the power of the Monolith to the south, standing guard over the tranquility of the Eternal City of Pripyat. Here we carry out the last will of Charon, destroying the infidels.",
      "JA_current": "We are the advance party of the Monolith faction called \"The Power of the Great Monolith\". I am the guardian of the elements of the sacred Sphere of the Sun, the right hand of Charon himself. We bring death to the infidels and extend the power of the Monolith to the south, standing guard over the tranquility of the Eternal City of Pripyat. Here we carry out the last will of Charon, destroying the infidels.",
      "JA_new": "我らはモノリス勢力の先遣隊、「偉大なるモノリスの力」だ。俺は聖なる太陽の球の欠片を守る者、カロンの右腕だ。異教徒どもに死をもたらし、モノリスの力を南へ広げる。永遠の都プリピャチの安寧を守り、ここでカロンの最後の遺志を果たす。異教徒どもを滅ぼすためにな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_5#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 323,
      "string_id": "ahill_second_dialog_phrase_5",
      "occurrence": 1,
      "EN": "What is the Golden Sphere?",
      "JA_current": "What is the Golden Sphere?",
      "JA_new": "黄金の球とは何だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_6#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 326,
      "string_id": "ahill_second_dialog_phrase_6",
      "occurrence": 1,
      "EN": "It is a great creation of the Zone, a creation that gives eternal life to its owner. Once upon a time, the Sphere was born by the Great Monolith. Soon after it appeared, it was broken into three pieces by Theseus and scattered across the Zone so as not to fall to the barbarians. Since then we, the keepers of the Sphere, have been unsuccessfully searching for one of its missing parts. When we have all three pieces, the Sphere will be restored, our race will gain immortality, and the barbarians will be destroyed.",
      "JA_current": "It is a great creation of the Zone, a creation that gives eternal life to its owner. Once upon a time, the Sphere was born by the Great Monolith. Soon after it appeared, it was broken into three pieces by Theseus and scattered across the Zone so as not to fall to the barbarians. Since then we, the keepers of the Sphere, have been unsuccessfully searching for one of its missing parts. When we have all three pieces, the Sphere will be restored, our race will gain immortality, and the barbarians will be destroyed.",
      "JA_new": "ゾーンが生み出した偉大な創造物で、持つ者に永遠の命をもたらす。かつて、球は大いなるモノリスから生まれた。現れてすぐ、蛮族の手に渡らぬよう、テセウスが三つに砕いてゾーン各地に散らした。それ以来、球の守り手である我らは失われた欠片の一つを探し続けてきたが、まだ見つかっていない。三つの欠片が揃えば球は元に戻り、我らの民は不死となる。そして蛮族どもは滅びるのだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_13#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 347,
      "string_id": "ahill_second_dialog_phrase_13",
      "occurrence": 1,
      "EN": "It's all clear now. I would like to help the Monolith, how can I do that?",
      "JA_current": "It's all clear now. I would like to help the Monolith, how can I do that?",
      "JA_new": "話は分かった。モノリスに協力したい。何をすればいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "12",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_7#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 329,
      "string_id": "ahill_second_dialog_phrase_7",
      "occurrence": 1,
      "EN": "What if I know where the missing part of the Golden Sphere is?",
      "JA_current": "What if I know where the missing part of the Golden Sphere is?",
      "JA_new": "欠けた黄金の球のありかを知っているとしたら？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_14#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 350,
      "string_id": "ahill_second_dialog_phrase_14",
      "occurrence": 1,
      "EN": "Oh, I see that you are getting on the path of Truth! This is good. Listen to me carefully, warrior: we have long lost contact with Charon and his paladins. We are low on ammunition and the barbarians will attack any day now, so I have a mission for you. You will have to go to the Eternal City of Pripyat, go to our base, take five Sacred Weapons with ammunition from our arsenal and bring them to us. Do you understand me?",
      "JA_current": "Oh, I see that you are getting on the path of Truth! This is good. Listen to me carefully, warrior: we have long lost contact with Charon and his paladins. We are low on ammunition and the barbarians will attack any day now, so I have a mission for you. You will have to go to the Eternal City of Pripyat, go to our base, take five Sacred Weapons with ammunition from our arsenal and bring them to us. Do you understand me?",
      "JA_new": "ああ、真理の道を歩み始めたか！ それは喜ばしい。よく聞け、戦士よ。我らは長い間、カロンとパラディンたちとの連絡が途絶えている。弾薬は残り少なく、蛮族どもはいつ襲ってきてもおかしくない。そこで任務を頼みたい。永遠の都プリピャチへ向かい、我らの拠点に行け。武器庫から弾薬つきの聖なる武器を五丁持ち出し、ここへ届けろ。分かったか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "13",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_8#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 332,
      "string_id": "ahill_second_dialog_phrase_8",
      "occurrence": 1,
      "EN": "And where is it?",
      "JA_current": "And where is it?",
      "JA_new": "それはどこにある？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:ahill_second_dialog_phrase_15#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 353,
      "string_id": "ahill_second_dialog_phrase_15",
      "occurrence": 1,
      "EN": "Well, where exactly in Pripyat is your arsenal?",
      "JA_current": "Well, where exactly in Pripyat is your arsenal?",
      "JA_new": "プリピャチのどこに武器庫がある？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
          "phrase_id": "14",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
