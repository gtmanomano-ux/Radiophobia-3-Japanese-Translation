      ],
      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "It is a great creation of the Zone, a creation that gives eternal life to its owner. Once upon a time, the Sphere was born by the Great Monolith. Soon after it appeared, it was broken into three pieces by Theseus and scattered across the Zone so as not to fall to the barbarians. Since then we, the keepers of the Sphere, have been unsuccessfully searching for one of its missing parts. When we have all three pieces, the Sphere will be restored, our race will gain immortality, and the barbarians will be destroyed.",
      "JA_current": "It is a great creation of the Zone, a creation that gives eternal life to its owner. Once upon a time, the Sphere was born by the Great Monolith. Soon after it appeared, it was broken into three pieces by Theseus and scattered across the Zone so as not to fall to the barbarians. Since then we, the keepers of the Sphere, have been unsuccessfully searching for one of its missing parts. When we have all three pieces, the Sphere will be restored, our race will gain immortality, and the barbarians will be destroyed.",
      "string_entry_candidates": [
        "stable_dialogs_radar:ahill_second_dialog_phrase_6#1"
