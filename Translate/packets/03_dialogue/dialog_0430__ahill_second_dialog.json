      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 338,
      "string_id": "ahill_second_dialog_phrase_10",
      "occurrence": 1,
      "EN": "O warrior, don't be a fool! Give her to me now! Or you will anger the Monolith!",
      "JA_current": "O warrior, don't be a fool! Give her to me now! Or you will anger the Monolith!",
      "JA_new": "戦士よ、愚かな真似はやめろ！ 今すぐそれを渡せ！ さもないとモノリスの怒りを買うぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "ahill_second_dialog",
