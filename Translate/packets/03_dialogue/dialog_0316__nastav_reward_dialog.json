      "string_id": "nastav_reward_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Here, I found the Musician's guitar.",
      "JA_current": "Here, I found the Musician's guitar.",
      "JA_new": "ほら、ミュージシャンのギターを見つけた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "nastav_reward_dialog",
          "phrase_id": "0",
