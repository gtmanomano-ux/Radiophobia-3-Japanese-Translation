    {
      "key": "stable_dialogs_escape:nastav_reward_dialog_phrase_6#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2377,
      "string_id": "nastav_reward_dialog_phrase_6",
      "occurrence": 1,
      "EN": "It's a disc. Some kind of \"Anomalous Album\". Do you know what it could be?",
      "JA_current": "It's a disc. Some kind of \"Anomalous Album\". Do you know what it could be?",
      "JA_new": "ディスクだ。「アノマラス・アルバム」とかいうものらしい。何か分かるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "nastav_reward_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:nastav_reward_dialog_phrase_7#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2380,
      "string_id": "nastav_reward_dialog_phrase_7",
      "occurrence": 1,
      "EN": "No, I don't. But I know the Barkeep over at the Duty base collects things like that. He'll know what to do with it.",
      "JA_current": "No, I don't. But I know the Barkeep over at the Duty base collects things like that. He'll know what to do with it.",
      "JA_new": "分からない。だがデューティー基地のバーキープが、そういうものを集めてる。あいつなら、どうすればいいか分かるだろう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "nastav_reward_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
