        }
      ]
    },
    {
      "key": "stable_dialogs_escape:nastav_reward_dialog_phrase_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2365,
      "string_id": "nastav_reward_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Oh, well done... God rest his soul. Right, as I promised, let me give you something. I'd give you a weapon, but I've only got an old sub-machine gun myself, and it's damaged... How about these binoculars? They're a useful piece of equipment, and they've got an IFF heads up display too, will automatically display who is and isn't friendly based on a wireless PDA signal. Take this dosimeter, too. You'll really need it out here, detects radiation and anomalous energy too, essential in the zone, always carry it on your belt.",
      "JA_current": "Oh, well done... God rest his soul. Right, as I promised, let me give you something. I'd give you a weapon, but I've only got an old sub-machine gun myself, and it's damaged... How about these binoculars? They're a useful piece of equipment, and they've got an IFF heads up display too, will automatically display who is and isn't friendly based on a wireless PDA signal. Take this dosimeter, too. You'll really need it out here, detects radiation and anomalous energy too, essential in the zone, always carry it on your belt.",
      "JA_new": "よくやった……安らかに眠ってくれ。約束どおり、礼をさせてくれ。武器を渡したいが、俺が持ってるのは古い短機関銃だけだ。しかも壊れてる……この双眼鏡はどうだ？ 役に立つ装備だし、敵味方識別のヘッドアップディスプレイも付いてる。無線PDAの信号を読み取って、味方か敵かを自動で表示するんだ。線量計も持っていけ。ここじゃ本当に必要になる。放射線だけでなく、アノマリーエネルギーも検知できる。ゾーンでは必需品だ。いつもベルトに付けておけ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "nastav_reward_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
