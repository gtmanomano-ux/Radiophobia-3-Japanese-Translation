    "entries":  [
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_1#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  67,
                        "string_id":  "bar_informator_enter_bandit_1",
                        "occurrence":  1,
                        "EN":  "Hey, I don\u0027t suppose you could try and put in a good word with the bandits for me??",
                        "JA_current":  "Hey, I don\u0027t suppose you could try and put in a good word with the bandits for me??",
                        "JA_new":  "なあ、バンディットに口を利いてくれないか？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "bar_informator_enter_bandit",
                                               "phrase_id":  "0",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_bar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_2#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  70,
                        "string_id":  "bar_informator_enter_bandit_2",
                        "occurrence":  1,
                        "EN":  "The bandits? What do you want with them guys?? Look, I can make a few moves for you if you have the cash. First, I need to know which gang you want to make nice with, because there\u0027s plenty of different groups out there and they\u0027re not exactly organized, get what I\u0027m saying?? ",
                        "JA_current":  "The bandits? What do you want with them guys?? Look, I can make a few moves for you if you have the cash. First, I need to know which gang you want to make nice with, because there\u0027s plenty of different groups out there and they\u0027re not exactly organized, get what I\u0027m saying?? ",
                        "JA_new":  "バンディット？ あいつらに何の用だ？ 金があれば、手を回してやってもいいが。まずはどの一団と話をつけたいのか教えてくれ。連中はいくつもの集団に分かれてるし、まとまりもない。言ってる意味は分かるな？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "bar_informator_enter_bandit",
                                               "phrase_id":  "1",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_bar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_3#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  73,
                        "string_id":  "bar_informator_enter_bandit_3",
                        "occurrence":  1,
                        "EN":  "I have some business to discuss with Borov, out in Dark Valley, you know him? Don\u0027t bother yourself about the money - I\u0027ve got enough.",
                        "JA_current":  "I have some business to discuss with Borov, out in Dark Valley, you know him? Don\u0027t bother yourself about the money - I\u0027ve got enough.",
                        "JA_new":  "ダークバレーにいるボロフと話をしたい。あいつを知ってるか？ 金の心配はいらない。十分持ってる。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "bar_informator_enter_bandit",
                                               "phrase_id":  "2",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_bar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_4#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  76,
                        "string_id":  "bar_informator_enter_bandit_4",
                        "occurrence":  1,
                        "EN":  "All right, Borov\u0027s boys, huh? Pay me, ermm, 30 grand and I will let Borov know that there\u0027s a stalker inbound with an important deal for him. His boys will stand down when they see you and you\u0027ll get a few minutes one of one with Borov. But beware: don\u0027t take too long to go see him, they won\u0027t wait around forever, maybe I can get you a couple of days, tops. My advice is to go haul ass over there at once as soon as I send the message out. If you miss your window, Borov will get suspicious and will probably cease contact with me for good. I don\u0027t want you to go burning my contacts, so this is my reputation at stake here too, you understand?\n\t\tBy the way, if you fuck up over there and piss him off, I\u0027m not liable for anything they do to you, so don\u0027t go thinking you\u0027re under any protection! You wanna mess with bandits and scumbags, that\u0027s entirely on you!",
                        "JA_current":  "All right, Borov\u0027s boys, huh? Pay me, ermm, 30 grand and I will let Borov know that there\u0027s a stalker inbound with an important deal for him. His boys will stand down when they see you and you\u0027ll get a few minutes one of one with Borov. But beware: don\u0027t take too long to go see him, they won\u0027t wait around forever, maybe I can get you a couple of days, tops. My advice is to go haul ass over there at once as soon as I send the message out. If you miss your window, Borov will get suspicious and will probably cease contact with me for good. I don\u0027t want you to go burning my contacts, so this is my reputation at stake here too, you understand?\n\t\tBy the way, if you fuck up over there and piss him off, I\u0027m not liable for anything they do to you, so don\u0027t go thinking you\u0027re under any protection! You wanna mess with bandits and scumbags, that\u0027s entirely on you!",
                        "JA_new":  "じゃあ、ボロフの一味だな。3万ルーブルでどうだ。ボロフに、重要な取引を持ちかけるストーカーが向かってると知らせてやる。あいつの部下はあんたを見ても手を出さない。その間にボロフと二人きりで話せる。ただし、連中はいつまでも待たない。会いに行くのに使えるのは、せいぜい2日ってところだろう。俺が連絡したら、すぐに向かうんだ。機会を逃せば、ボロフは怪しんで、二度と俺に連絡してこなくなるかもしれない。俺のつてを潰されちゃ困る。俺の評判も懸かってるんだ、分かるな？\n\t\tそれと、向こうでヘマしてボロフを怒らせても、あんたの身は保証しない。守られてるなんて思うなよ！ バンディットやクズどもに手を出すなら、あんたの責任だ！",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "bar_informator_enter_bandit",
                                               "phrase_id":  "3",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_bar.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_5#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  80,
                        "string_id":  "bar_informator_enter_bandit_5",
                        "occurrence":  1,
                        "EN":  "Fine, perfect, I\u0027m in. Take the money and send the message.",
                        "JA_current":  "Fine, perfect, I\u0027m in. Take the money and send the message.",
                        "JA_new":  "よし、分かった。金を渡すから、連絡してくれ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "bar_informator_enter_bandit",
                                               "phrase_id":  "4",
