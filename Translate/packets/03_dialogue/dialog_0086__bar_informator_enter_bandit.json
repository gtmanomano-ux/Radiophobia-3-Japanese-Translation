                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_bar:bar_informator_enter_bandit_6#1",
                        "source_table":  "stable_dialogs_bar",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
                        "source_xml_line":  83,
                        "string_id":  "bar_informator_enter_bandit_6",
                        "occurrence":  1,
                        "EN":  "On second thought, I think I\u0027ve changed my mind... Maybe later, though!",
                        "JA_current":  "On second thought, I think I\u0027ve changed my mind... Maybe later, though!",
                        "JA_new":  "やっぱり考え直した。今回はやめておく……また今度な。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
