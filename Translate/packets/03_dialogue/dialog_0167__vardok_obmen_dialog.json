      "string_id": "vardok_obmen_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Can you help with any first-aid kits?",
      "JA_current": "Can you help with any first-aid kits?",
      "JA_new": "医療キットを分けてもらえないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "vardok_obmen_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:vardok_obmen_dialog_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1991,
      "string_id": "vardok_obmen_dialog_phrase_2",
      "occurrence": 1,
      "EN": "I have them, but I don't sell them. It is my principle not to charge money for my help. However, if you bring me any artifact spawned from the whirligig anomaly, for example a Stone Blood, a Chunk of Meat or a Soul, I'll give you some medical supplies in return. Not to cut a profit, you see, it's just so that I can give them to the scientists to trade for any supplies I need.",
      "JA_current": "I have them, but I don't sell them. It is my principle not to charge money for my help. However, if you bring me any artifact spawned from the whirligig anomaly, for example a Stone Blood, a Chunk of Meat or a Soul, I'll give you some medical supplies in return. Not to cut a profit, you see, it's just so that I can give them to the scientists to trade for any supplies I need.",
      "JA_new": "あるが、売り物じゃない。人助けで金を取らないのが俺の主義だ。ただ、ウィリギグから生まれたアーティファクト――たとえばストーンブラッドやミートチャンク、ソウルを持ってきてくれれば、医療用品と交換する。儲けるためじゃない。必要な物資と交換できるよう、科学者に渡すんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "vardok_obmen_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:vardok_obmen_dialog_phrase_3#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1994,
      "string_id": "vardok_obmen_dialog_phrase_3",
      "occurrence": 1,
      "EN": "I see. If I find anything, I'll bring it to you.",
      "JA_current": "I see. If I find anything, I'll bring it to you.",
      "JA_new": "分かった。見つけたら持ってくる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
