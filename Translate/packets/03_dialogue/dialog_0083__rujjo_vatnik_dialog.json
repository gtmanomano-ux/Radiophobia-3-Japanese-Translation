      "source_xml_line": 453,
      "string_id": "rujjo_vatnik_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Hey, Zadov. I have a question for you.",
      "JA_current": "Hey, Zadov. I have a question for you.",
      "JA_new": "なあ、ザドフ。聞きたいことがある。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_2#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 456,
      "string_id": "rujjo_vatnik_dialog_phrase_2",
      "occurrence": 1,
      "EN": "What do you want?",
      "JA_current": "What do you want?",
      "JA_new": "何の用だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_3#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 459,
      "string_id": "rujjo_vatnik_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Some of your guys may have brought you a rifle and coat recently. If you have them, I want to take them from you.",
      "JA_current": "Some of your guys may have brought you a rifle and coat recently. If you have them, I want to take them from you.",
      "JA_new": "お前の部下が最近、ライフルと上着を持ち込まなかったか？ 持ってるなら、こっちに渡してほしい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_4#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 462,
      "string_id": "rujjo_vatnik_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Sharp as a fucking cue ball, aren't you?! What do you mean by \"take it\"? Think you'll get lucky with me? Try it!",
      "JA_current": "Sharp as a fucking cue ball, aren't you?! What do you mean by \"take it\"? Think you'll get lucky with me? Try it!",
      "JA_new": "お前、ビリヤードの球みたいに頭が回らないな？ 「渡せ」ってどういう意味だ？ 俺から奪えると思ってるのか？ やってみろ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_5#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 465,
      "string_id": "rujjo_vatnik_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Relax, soldier. It was a test to see if the things I needed were truly in your possession.",
      "JA_current": "Relax, soldier. It was a test to see if the things I needed were truly in your possession.",
      "JA_new": "落ち着け、兵士。必要な品を本当に持ってるか、確かめただけだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_6#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 468,
      "string_id": "rujjo_vatnik_dialog_phrase_6",
      "occurrence": 1,
      "EN": "What!?",
      "JA_current": "What!?",
      "JA_new": "何だと！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_7#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 471,
      "string_id": "rujjo_vatnik_dialog_phrase_7",
      "occurrence": 1,
      "EN": "If you didn't have them, the first thing you'd say is that you don't have them. And if you started arguing right away, that means you do have them. Name your price.",
      "JA_current": "If you didn't have them, the first thing you'd say is that you don't have them. And if you started arguing right away, that means you do have them. Name your price.",
      "JA_new": "持ってなかったなら、まず「持ってない」と答えてたはずだ。いきなり言い返してきたってことは、持ってるんだろ。いくらだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_8#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 474,
      "string_id": "rujjo_vatnik_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Huh, you're a sly one... All right, forget it. Pay the money for the stuff, it's worth it. Ten grand!",
      "JA_current": "Huh, you're a sly one... All right, forget it. Pay the money for the stuff, it's worth it. Ten grand!",
      "JA_new": "へえ、食えない奴だな……いいだろう。だったら買え。品物の値打ちはあるぞ。1万だ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_9#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 477,
      "string_id": "rujjo_vatnik_dialog_phrase_9",
      "occurrence": 1,
      "EN": "Come on, Zadov. They're worth a grand and a half, at best! An old, threadbare jacket and a rusty sawed-off shotgun? Who could possibly need them here? This is the best offer you're gonna get, take the grand and a half, hotshot.",
      "JA_current": "Come on, Zadov. They're worth a grand and a half, at best! An old, threadbare jacket and a rusty sawed-off shotgun? Who could possibly need them here? This is the best offer you're gonna get, take the grand and a half, hotshot.",
      "JA_new": "おい、ザドフ。せいぜい1500ルーブルってところだろ！ くたびれた古い上着と、錆びた短銃身の散弾銃だぞ？ こんな場所で誰が欲しがるんだ？ これ以上の条件は出ないぞ。1500受け取っておけ、偉そうな野郎。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:rujjo_vatnik_dialog_phrase_10#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 480,
      "string_id": "rujjo_vatnik_dialog_phrase_10",
      "occurrence": 1,
      "EN": "On second thought, I'm going to save the money.",
      "JA_current": "On second thought, I'm going to save the money.",
      "JA_new": "やっぱりやめた。金は取っておく。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rujjo_vatnik_dialog",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    }
