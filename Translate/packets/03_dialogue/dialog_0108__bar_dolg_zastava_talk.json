      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_zastava_talk_2121#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1478,
      "string_id": "bar_dolg_zastava_talk_2121",
      "occurrence": 1,
      "EN": "It's not far from the Arena. I've marked it on the map for you.",
      "JA_current": "アリーナの近くさ。アンタの地図に印をつけておいたぜ。",
      "JA_new": "アリーナからそう遠くない。地図に印をつけておいた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_zastava_talk",
