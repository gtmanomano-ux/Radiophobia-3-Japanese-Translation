    {
      "key": "stable_dialogs_bar:bar_dolg_zastava_talk_2111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1469,
      "string_id": "bar_dolg_zastava_talk_2111",
      "occurrence": 1,
      "EN": "In the basement behind the hangar...I'll mark it on your map.",
      "JA_current": "納屋の後ろ側の地下だ… アンタの地図に印をつけておいたぜ。",
      "JA_new": "格納庫の裏手にある地下だ……地図に印をつけてやる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_dolg_zastava_talk",
