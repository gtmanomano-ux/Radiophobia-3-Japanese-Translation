          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_dolg_zastava_talk_2131#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1487,
      "string_id": "bar_dolg_zastava_talk_2131",
      "occurrence": 1,
      "EN": "Go out of the hangar with the broken roof and you'll end up right in front of it. I'll mark it on your map.",
      "JA_current": "屋根の壊れた格納庫の外へ出るんだ。そうすりゃ、アリーナの真正面に着くはずだ。アンタの地図に印をつけといてやるよ。",
      "JA_new": "屋根が壊れた格納庫から出れば、目の前にある。地図に印をつけてやる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
