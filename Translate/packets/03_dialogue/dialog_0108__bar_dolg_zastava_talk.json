      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1484,
      "string_id": "bar_dolg_zastava_talk_213",
      "occurrence": 1,
      "EN": "You said there's an Arena here? Where exactly is it?",
      "JA_current": "アンタはこの辺りにアリーナがあると言っていたな。詳しい場所はどこだ？",
      "JA_new": "アリーナがあるのか？ どこだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
