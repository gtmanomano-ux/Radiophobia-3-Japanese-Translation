    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_21#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 135,
      "string_id": "agr_stalker_talk_about_ratcatcher_21",
      "occurrence": 1,
      "EN": "It used to be pretty quiet but now the army has got all excited and started wasting everyone. They smoked the bandits out recently and I hear some managed to escape into the catacombs.",
      "JA_current": "前は静かなもんだったが、最近 Army が来て、みんなを追い出したんだ。奴らは Bandit をあぶりだしたが、その生き残りが、命からがら地下に逃げ込んだらしい。",
      "JA_new": "前はかなり静かだったが、最近は軍が急に血気づいて、片っ端から人を殺し始めた。ついこの間もバンディットを追い払ったらしい。何人かは地下墓地に逃げ込んだって話だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_131#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 126,
      "string_id": "agr_stalker_talk_about_ratcatcher_131",
      "occurrence": 1,
      "EN": "Piss off!",
      "JA_current": "ふざけんな！",
      "JA_new": "失せろ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher",
