          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_140#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 129,
      "string_id": "agr_stalker_talk_about_ratcatcher_140",
      "occurrence": 1,
      "EN": "Thank you.",
      "JA_current": "ありがとう。",
      "JA_new": "ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher",
          "phrase_id": "140",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_40#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 141,
      "string_id": "agr_stalker_talk_about_ratcatcher_40",
      "occurrence": 1,
      "EN": "The exit from the railway tunnel is nearby. It's fairly safe in the dead end. At least nobody has been eaten while sleeping there... Yet.  Also, to the Northwest of the factory you'll find a marsh with a wagon in it.  But be careful, there's a shitload of radiation around there, so it's best to approach it from the western side, the water's just too contaminated. Oh, and one more thing: a soldier has been spotted around there. He's likely to be a deserter from the military base at the Institute. The poor bastard is probably crazy - he's been there for a couple of days and I doubt he'll survive much longer on his own.",
      "JA_current": "鉄道トンネルの出口が近くにあるぜ。行き止まりになってて、かなり安全だ。少なくとも、誰も眠ってる間に喰われちまったりはしてない… 今まではな。あと、工場の北西にある沼に貨車を見付けられると思うが、気を付けろよ。そこらじゅう放射能まみれのクソッたれた場所だ。西側から近付くのが1番だな。おっと、もうひとつ。軍の兵士が1人、そこで見かけられてる。そいつは研究所の方にある基地からやってきたらしいんだが、そのツイてないマヌケは、どうもイカレちまってるな ─ もう何日もそこに留まってるんだが、そんなに長くは1人で生き延びられないだろうよ。",
      "JA_new": "線路トンネルの出口はすぐ近くだ。行き止まりまで行けば、まあ安全だよ。少なくとも、寝てる間に誰かに食われた奴はいない……今のところはな。それから、工場の北西に、車両が放置された沼地がある。だが気をつけろ。辺り一帯がひどい放射能汚染だ。水も汚染されすぎてるから、西側から近づくのがいい。あともう一つ、あの辺で兵士が目撃されてる。研究所の軍基地から脱走した兵士だろう。何日もあそこにいるらしい。気の毒だが、頭もおかしくなってるだろうし、一人じゃ長くもたないだろうな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "agr_stalker_talk_about_ratcatcher",
          "phrase_id": "40",
          "graph_source": "gamedata/config/gameplay/dialogs_agroprom.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_130#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 123,
      "string_id": "agr_stalker_talk_about_ratcatcher_130",
      "occurrence": 1,
      "EN": "Here, take the money. Now tell me where it is.",
      "JA_current": "ほら、金だ。で、そいつはドコにあるんだ？",
      "JA_new": "ほら、金だ。場所を教えてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
