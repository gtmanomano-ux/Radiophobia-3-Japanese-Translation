    {
      "key": "stable_dialogs_agroprom:agr_stalker_talk_about_ratcatcher_20#1",
      "source_table": "stable_dialogs_agroprom",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_agroprom.xml",
      "source_xml_line": 132,
      "string_id": "agr_stalker_talk_about_ratcatcher_20",
      "occurrence": 1,
      "EN": "Yeah, there are a couple of places but you'll have to share some of your wealth, buddy.",
      "JA_current": "そうだな、いろんな場所があるぜ。だがまずは、あんたの金を少しわけてもらわんと。な、兄弟？",
      "JA_new": "ああ、いくつかある。ただし、少しは金を払ってもらうぜ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
