      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 2569,
      "string_id": "commander_second_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Wow, I didn't expect that, you're pretty wealthy for a stalker slime-ball! All right, this isn't enough for even half of the house, but since I'm a very kind and fair man, so be it - take your brother and get out of here with him, you have five minutes to get out of my sight! You got it?! Otherwise I'll drop the both of you!",
      "JA_current": "Wow, I didn't expect that, you're pretty wealthy for a stalker slime-ball! All right, this isn't enough for even half of the house, but since I'm a very kind and fair man, so be it - take your brother and get out of here with him, you have five minutes to get out of my sight! You got it?! Otherwise I'll drop the both of you!",
      "JA_new": "驚いたな。ストーカーのクズにしちゃ、ずいぶん金持ちじゃないか！ よし、これじゃ地中海の別荘の半分も建たないが、俺は寛大で公平な男だ。話はつけてやる。弟を連れて、ここから出ていけ。5分以内に俺の前から消えろ！ 分かったか！？ さもないと二人とも撃ち殺すぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "commander_second_dialog",
