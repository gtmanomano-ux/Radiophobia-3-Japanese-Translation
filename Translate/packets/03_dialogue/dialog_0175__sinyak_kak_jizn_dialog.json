      "string_id": "sinyak_kak_jizn_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Man, you're a good man, Marked One! Do you want me to tell you where the loot is?",
      "JA_current": "Man, you're a good man, Marked One! Do you want me to tell you where the loot is?",
      "JA_new": "お前、いい奴だな、マークド・ワン！ いい話を教えてやろうか？ お宝の場所だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
