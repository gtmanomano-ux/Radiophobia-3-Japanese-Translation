    {
      "key": "stable_dialogs_bar:sinyak_kak_jizn_dialog_phrase_10#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2474,
      "string_id": "sinyak_kak_jizn_dialog_phrase_10",
      "occurrence": 1,
      "EN": "When you get past the southern roadblock, immediately turn left around the corner. There's a hobo there that's been dead for a long time and is still lying there behind the pipes, no one can see him. I had stashed some trinkets in the hiding place out there before, so I went to get it and ran into him. I didn't have time to search him - I was on a real bender. So check it out, maybe you'll get something.",
      "JA_current": "When you get past the southern roadblock, immediately turn left around the corner. There's a hobo there that's been dead for a long time and is still lying there behind the pipes, no one can see him. I had stashed some trinkets in the hiding place out there before, so I went to get it and ran into him. I didn't have time to search him - I was on a real bender. So check it out, maybe you'll get something.",
      "JA_new": "南の検問所を越えたら、角をすぐ左に曲がれ。パイプの裏に、ずっと前に死んだ浮浪者が転がってる。誰も気づかない場所だ。前にそこの隠し場所へ小物を隠してて、取りに来た時にそいつを見つけた。だが、酔い潰れてたから調べる暇がなかった。何か見つかるかもしれないぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sinyak_kak_jizn_dialog",
