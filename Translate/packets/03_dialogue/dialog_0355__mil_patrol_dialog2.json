  "entries": [
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_0#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1092,
      "string_id": "mil_patrol_dialog2_0",
      "occurrence": 1,
      "EN": "Ah, a rookie... Come over a sec.",
      "JA_current": "お、ルーキー… ちょっと後で来てくれ。",
      "JA_new": "おい、新米か……ちょっと来い。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_1#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1095,
      "string_id": "mil_patrol_dialog2_1",
      "occurrence": 1,
      "EN": "What is it?",
      "JA_current": "いやだ。",
      "JA_new": "何だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_2#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1107,
      "string_id": "mil_patrol_dialog2_2",
      "occurrence": 1,
      "EN": "What, you don't know? Oh, you haven't heard the story about what happens to the \"slow-witted ones\" yet, huh?",
      "JA_current": "分かってないのか？ ああ、頭の鈍いヤツの話を聞いてなかったか、んん？",
      "JA_new": "知らないのか？「頭の鈍い奴」がどうなったか、まだ聞いてないのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_3#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1110,
      "string_id": "mil_patrol_dialog2_3",
      "occurrence": 1,
      "EN": "No, I haven't.",
      "JA_current": "いや、聞いてない。",
      "JA_new": "いや、聞いてない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_4#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1113,
      "string_id": "mil_patrol_dialog2_4",
      "occurrence": 1,
      "EN": "Alright, look. Think about it: these are lean times...",
      "JA_current": "いいだろ、聞け。想像しろ： 栄養の足りないご時世だ…。",
      "JA_new": "じゃあ、よく聞け。今は食糧難だ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_5#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1116,
      "string_id": "mil_patrol_dialog2_5",
      "occurrence": 1,
      "EN": "Meaning?",
      "JA_current": "どういう意味？",
      "JA_new": "つまり？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_6#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1119,
      "string_id": "mil_patrol_dialog2_6",
      "occurrence": 1,
      "EN": "Well, it's simple! A hungry soldier is a bad soldier. And there are so many of us...",
      "JA_current": "なに、簡単だ！ 空腹な兵士は悪い兵士だ。そして俺たちはとても大所帯だ…。",
      "JA_new": "簡単な話だ。腹を空かせた兵士は役に立たない。しかも俺たちは大勢いる……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_7#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1122,
      "string_id": "mil_patrol_dialog2_7",
      "occurrence": 1,
      "EN": "And?",
      "JA_current": "それで？",
      "JA_new": "それで？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_8#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1125,
      "string_id": "mil_patrol_dialog2_8",
      "occurrence": 1,
      "EN": "Where could we possibly get enough meat for everyone? We have to do what we can to survive, so it's convenient that you happened by! You look well fed... Plenty of fat around the flanks...",
      "JA_current": "その多くの肉が、どこで手に入る？ で、見ろ、ここにお前がいる！",
      "JA_new": "みんなに食わせる肉をどこから調達する？生き残るには、できることをするしかない。ちょうどいいところに来たな！あんた、ずいぶん肉付きがいい……腰回りに脂もたっぷりだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_9#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1128,
      "string_id": "mil_patrol_dialog2_9",
      "occurrence": 1,
      "EN": "Got it.",
      "JA_current": "分かった。",
      "JA_new": "なるほどな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_10#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1098,
      "string_id": "mil_patrol_dialog2_10",
      "occurrence": 1,
      "EN": "Where are you going? Stay! It's nice here... and we'd love to have you for dinner tonight.",
      "JA_current": "どこに行こうってんだい？ ここに居なよ！ いい場所さ… で、今夜、食事でもどうだい？",
      "JA_new": "どこへ行く？待てよ！ここはいいところだ……今夜の夕食にお前を招待したいんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_11#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1101,
      "string_id": "mil_patrol_dialog2_11",
      "occurrence": 1,
      "EN": "Nah, I'm not that appetizing.",
      "JA_current": "いやぁ、それほどそそられない。",
      "JA_new": "いや、俺はそんなにうまくないぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_patrol_dialog2_12#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 1104,
      "string_id": "mil_patrol_dialog2_12",
      "occurrence": 1,
      "EN": "What?! Shit, why didn't you tell me that before? You've just been wasting my time. Get lost, ass-face. And this time I'm dead serious...",
      "JA_current": "何？！ 糞っ、何でそれを先に言わなかった！ 時間の無駄だった。失せろ、ケツ面。今度は真剣だ…。",
      "JA_new": "何だと！？なら先に言えよ！時間を無駄にしちまった。失せろ、ケツ面。今度は本気だぞ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_patrol_dialog2",
          "phrase_id": "12",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    }
  ],
