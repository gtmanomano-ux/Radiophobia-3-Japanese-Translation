      "source_xml_line": 882,
      "string_id": "sahar_scientists_reward_phrase_3",
      "occurrence": 1,
      "EN": "There was a problem. Only two survivors. They were attacked by a controller, but together we managed to fight it off. Petrov and the officer are alive, but the soldiers from the guard and his assistant are dead.",
      "JA_current": "There was a problem. Only two survivors. They were attacked by a controller, but together we managed to fight it off. Petrov and the officer are alive, but the soldiers from the guard and his assistant are dead.",
      "JA_new": "問題があった。生き残ったのは二人だけだ。コントローラーに襲われたが、何とか撃退した。ペトロフ博士と少佐は無事だが、護衛の兵士と助手は亡くなった。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sahar_scientists_reward",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_yantar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_yantar:sahar_scientists_reward_phrase_4#1",
      "source_table": "stable_dialogs_yantar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_yantar.xml",
      "source_xml_line": 885,
      "string_id": "sahar_scientists_reward_phrase_4",
      "occurrence": 1,
      "EN": "I thank you from the bottom of my heart, Marked One! On behalf of all the science staff at our base, I want to give you this piece of kit, an experimental device of my own creation. May it protect you in the Zone! Good luck to you!",
      "JA_current": "I thank you from the bottom of my heart, Marked One! On behalf of all the science staff at our base, I want to give you this piece of kit, an experimental device of my own creation. May it protect you in the Zone! Good luck to you!",
      "JA_new": "本当にありがとう、マークド・ワン！ 研究基地のみんなを代表して、私が作った実験装置を贈ろう。ゾーンで君の身を守ってくれるはずだ。幸運を！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
