  "entry_count": 23,
  "entries": [
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 242,
      "string_id": "val_escort_nap1_dialog_21",
      "occurrence": 1,
      "EN": "Thanks! You got my partner out of there! Here, take this - it's from the bottom of my heart.",
      "JA_current": "有り難う！ あんたは相棒を救出してくれた！ ほら、これを持って行け。これは心底感謝の印だ。",
      "JA_new": "相棒を助け出してくれたんだな！ありがとう。ほら、受け取ってくれ。心からの礼だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_31#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 299,
      "string_id": "val_escort_nap1_dialog_31",
      "occurrence": 1,
      "EN": "So, friend... What's going to happen with me now?.. Thanks. At least you tried to help. And I do keep my word.",
      "JA_current": "さて友人よ… 一体俺に何が起こってる…？ 有り難う、少なくともお前は助けようとしてくれた。俺も約束は守るよ。",
      "JA_new": "さて、友よ……これから俺はどうなるんだろうな……助けようとしてくれたことには感謝してる。それに、俺は約束を守る男だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_41#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 302,
      "string_id": "val_escort_nap1_dialog_41",
      "occurrence": 1,
      "EN": "Thanks for your help! What else did you want to know about?",
      "JA_current": "助力に感謝する！ 何について知りたいんだ？",
      "JA_new": "助けてくれてありがとう！ほかに何を聞きたい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_61#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 305,
      "string_id": "val_escort_nap1_dialog_61",
      "occurrence": 1,
      "EN": "You refused to help when I asked you. We have nothing to discuss. Get lost.",
      "JA_current": "俺が頼んだとき、あんたは断ったじゃないか。話し合いの余地はねぇ、失せな。",
      "JA_new": "頼んだ時に助けてくれなかったよな。もう話すことはない。消えろ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "61",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_611#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 308,
      "string_id": "val_escort_nap1_dialog_611",
      "occurrence": 1,
      "EN": "Bye.",
      "JA_current": "じゃあな。",
      "JA_new": "じゃあな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "611",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 248,
      "string_id": "val_escort_nap1_dialog_212",
      "occurrence": 1,
      "EN": "I guess you must know this area well. What's interesting here?",
      "JA_current": "この辺あんたは詳しいだろ、何か興味深いことはないか？",
      "JA_new": "この辺りには詳しいんだろ？何か面白い場所はあるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "212",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_213#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 290,
      "string_id": "val_escort_nap1_dialog_213",
      "occurrence": 1,
      "EN": "Just the two of you went on a scouting raid?",
      "JA_current": "たった2人で偵察に来たのか？",
      "JA_new": "偵察に出たのは二人だけだったのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "213",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_214#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 296,
      "string_id": "val_escort_nap1_dialog_214",
      "occurrence": 1,
      "EN": "Take care.",
      "JA_current": "用心しろよ。",
      "JA_new": "気をつけてな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "214",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_2121#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 251,
      "string_id": "val_escort_nap1_dialog_2121",
      "occurrence": 1,
      "EN": "To the North there's a bandit camp. To the East - an old factory. To the Southwest - a deserted pig farm, and some kind of gate beyond it... I can't say what's there, never been that far.",
      "JA_current": "北の方に Bandit のキャンプがある。東には、古い工場が。南西には捨てられた養豚場と、その向こうに何かゲートが… 何があるかは分からない、そんなに遠くには行ったことがないからな。",
      "JA_new": "北にバンディットのキャンプがある。東には古い工場。南西には廃れた養豚場があって、その先に何かの門が見える……そこまでは行ったことがないから、何があるか分からない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "2121",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_2131#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 293,
      "string_id": "val_escort_nap1_dialog_2131",
      "occurrence": 1,
      "EN": "There was another guy, Serega. Went missing, probably got himself captured by Borov's gang... He's probably still held there, dead or alive.",
      "JA_current": "Serega と言う別の男が同行していたんだが、わかんねぇ。奴は消えちまって連絡もねぇ… 結局ギャング共が奴を始末したに違いない。",
      "JA_new": "もう一人、セレガがいた。行方が分からなくなってる。たぶんボロフの一味に捕まったんだ……生きてるか死んでるかは知らないが、まだ捕らわれてるかもしれない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "2131",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21211#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 254,
      "string_id": "val_escort_nap1_dialog_21211",
      "occurrence": 1,
      "EN": "Would you tell me more about the bandit camp?",
      "JA_current": "Banditのキャンプについてもっと教えてくれ。",
      "JA_new": "バンディットのキャンプについて、もう少し教えてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21211",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21212#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 260,
      "string_id": "val_escort_nap1_dialog_21212",
      "occurrence": 1,
      "EN": "What's happening at the factory?",
      "JA_current": "工場で何があったんだ？",
      "JA_new": "工場では何が起きてる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21212",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21213#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 272,
      "string_id": "val_escort_nap1_dialog_21213",
      "occurrence": 1,
      "EN": "A real pig farm? With actual pigs?",
      "JA_current": "本物の養豚場か？ 実際に豚が居るのか？",
      "JA_new": "本物の養豚場か？豚がいるのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21213",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21214#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 278,
      "string_id": "val_escort_nap1_dialog_21214",
      "occurrence": 1,
      "EN": "What's this gate you were talking about?",
      "JA_current": "あんたの話した、ゲートって？",
      "JA_new": "さっきの門って何なんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21214",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_21215#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 284,
      "string_id": "val_escort_nap1_dialog_21215",
      "occurrence": 1,
      "EN": "I see, thanks.",
      "JA_current": "わかった、ありがとうよ。",
      "JA_new": "なるほど、ありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "21215",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212111#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 257,
      "string_id": "val_escort_nap1_dialog_212111",
      "occurrence": 1,
      "EN": "Hmm, what about it... They settled in an unfinished building straight North of here. Their leader is Borov - a real animal, that bastard. That's why they sent us here, to finish him off.",
      "JA_current": "うむ、それは… 連中はここをまっすぐ北に行った所にある、建築途中のビルをアジトにしている。連中の親玉は Borov だ。本物のケダモノ、クソッタレさ。こいつの息の根を止めるために、俺たちは送り込まれたんだ。",
      "JA_new": "あいつらはここから真北の未完成の建物にいる。リーダーはボロフだ。あの野郎、本当に獣みたいな奴でな。俺たちがここへ送られたのも、そいつを始末するためだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "212111",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212121#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 263,
      "string_id": "val_escort_nap1_dialog_212121",
      "occurrence": 1,
      "EN": "We managed to find out that there is some kind of vault there. Only it's guarded like Fort Knox.",
      "JA_current": "俺たちは、何とか地下貯蔵庫のようなものがあるのを見つけることが出来た。そこだけが要塞のように警備されてるんだ。",
      "JA_new": "あそこに何かの貯蔵庫があるらしい。だが、まるで金庫みたいに厳重に守られてる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "212121",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212131#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 275,
      "string_id": "val_escort_nap1_dialog_212131",
      "occurrence": 1,
      "EN": "Drooling for some pork chops already, huh? Heck, the Zone is full of boars! Take a bite of one of those and you won't be needing a flashlight anymore - that's how bad you'll be glowing in the dark! OK, OK, just kidding... The farm has long been abandoned and is now home to some stalkers. They didn't make a good impression on me, though, and I usually trust my gut feeling.",
      "JA_current": "もうブツ切り豚肉によだれを垂らしてんのか？ へっ！ とんでもない、ゾーンに Boars はいっぱい居るじゃないか！ どれか1口食ってみろよ、もう2度と懐中電灯の必要が無くなるぜ？ 悪いことに暗闇の中であんたはボーッと光るんだ。いやいや、冗談だ… 農場は長い間捨てられていて、今は何人かのストーカーのヤサになってる。だが、あいつら良い感じはしなかったな。…俺の勘は良く当たるぜ？",
      "JA_new": "もう豚肉が食べたくてたまらないのか？ゾーンはイノシシだらけだろ。かじってみな。放射線を浴びて、暗闇で光るようになるぞ！……冗談だよ。農場はずっと前に捨てられて、今はストーカーたちが住み着いてる。だが、連中の印象はよくなかった。俺は直感を信じるたちでね。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "212131",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212141#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 281,
      "string_id": "val_escort_nap1_dialog_212141",
      "occurrence": 1,
      "EN": "I can't figure it out. Just an old gate, except it's locked and well guarded. We haven't set foot in there.",
      "JA_current": "想像もつかない。ただの古いゲートなんだが、ロックされていてキッチリ警備されている。俺たちはそこから入らなかった。",
      "JA_new": "よく分からない。ただの古い門みたいだが、鍵がかかっていて、警備も厳しい。中には入ってない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_escort_nap1_dialog",
          "phrase_id": "212141",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_escort_nap1_dialog_212151#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 287,
      "string_id": "val_escort_nap1_dialog_212151",
      "occurrence": 1,
      "EN": "You're welcome! Come back any time.",
      "JA_current": "かまわんよ！ いつでも戻ってこい。",
      "JA_new": "どういたしまして！またいつでも来てくれ。",
      "review_notes": null,
