      "string_entry_candidates": [
        "stable_dialogs_darkvalley:val_escort_nap1_dialog_21212#1"
      ]
    },
    {
      "phrase_id": "21213",
      "text_id": "val_escort_nap1_dialog_21213",
      "next": [
        "212131"
      ],
