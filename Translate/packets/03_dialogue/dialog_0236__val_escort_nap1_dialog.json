        "212191"
      ],
      "speaker_hint": null,
      "speaker_hint_basis": "unresolved",
      "EN": "A real pig farm? With actual pigs?",
      "JA_current": "本物の養豚場か？ 実際に豚が居るのか？",
      "string_entry_candidates": [
        "stable_dialogs_darkvalley:val_escort_nap1_dialog_21213#1"
      ]
    },
    {
      "phrase_id": "21214",
      "text_id": "val_escort_nap1_dialog_21214",
