      "speaker_hint": null,
      "speaker_hint_basis": "unresolved",
      "EN": "Would you tell me more about the bandit camp?",
      "JA_current": "Banditのキャンプについてもっと教えてくれ。",
      "string_entry_candidates": [
        "stable_dialogs_darkvalley:val_escort_nap1_dialog_21211#1"
