                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_3#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1973,
                        "string_id":  "kosyak_start_dialog_phrase_3",
                        "occurrence":  1,
                        "EN":  "Quiet, man, don\u0027t yell... I\u0027m doing business. \"Business,\" you know?",
                        "JA_current":  "Quiet, man, don\u0027t yell... I\u0027m doing business. \"Business,\" you know?",
                        "JA_new":  "静かにしろよ、怒鳴るな……商売中なんだ。「商売」ってやつさ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "2",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_4#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1976,
                        "string_id":  "kosyak_start_dialog_phrase_4",
                        "occurrence":  1,
                        "EN":  "With cannabis or something? I don\u0027t give a shit about that.",
                        "JA_current":  "With cannabis or something? I don\u0027t give a shit about that.",
                        "JA_new":  "大麻か何かか？ そんなのに興味はない。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "3",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_5#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1979,
                        "string_id":  "kosyak_start_dialog_phrase_5",
                        "occurrence":  1,
                        "EN":  "Come on, what cannabis? Although I do also deal in cannabis, but that\u0027s just in my spare time... And you, I see, are a serious man, so for you I have exclusive goods.",
                        "JA_current":  "Come on, what cannabis? Although I do also deal in cannabis, but that\u0027s just in my spare time... And you, I see, are a serious man, so for you I have exclusive goods.",
                        "JA_new":  "大麻って、何の話だよ？ まあ、暇な時に売ってはいるけどな……。あんたは真面目そうだ。特別な品を用意してるぜ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "4",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_6#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1982,
                        "string_id":  "kosyak_start_dialog_phrase_6",
                        "occurrence":  1,
                        "EN":  "What goods?",
                        "JA_current":  "What goods?",
                        "JA_new":  "何を売ってる？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "5",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_7#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1985,
                        "string_id":  "kosyak_start_dialog_phrase_7",
                        "occurrence":  1,
                        "EN":  "Morphine. It\u0027s useful, especially here in the Zone. You take a few cc\u0027s and you can go on a bayonet charge against a regiment of enemies - they won\u0027t do shit to you. Plus you get to enjoy a nice relaxation and a good high, of course. It doesn\u0027t last long, but you can do a lot in that time. Take it, you won\u0027t regret it!",
                        "JA_current":  "Morphine. It\u0027s useful, especially here in the Zone. You take a few cc\u0027s and you can go on a bayonet charge against a regiment of enemies - they won\u0027t do shit to you. Plus you get to enjoy a nice relaxation and a good high, of course. It doesn\u0027t last long, but you can do a lot in that time. Take it, you won\u0027t regret it!",
                        "JA_new":  "モルヒネだ。特にゾーンじゃ役に立つ。少し注射すれば、敵の連隊に銃剣突撃を仕掛けても平気だ。奴らなんて相手にならない。気持ちよくリラックスできて、いい具合にハイにもなれる。長くは続かないが、その間にいろいろできるぞ。持っていけ、後悔はさせない！",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "6",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_8#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1988,
                        "string_id":  "kosyak_start_dialog_phrase_8",
                        "occurrence":  1,
                        "EN":  "What do you want for it?",
                        "JA_current":  "What do you want for it?",
                        "JA_new":  "いくらだ？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "7",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
