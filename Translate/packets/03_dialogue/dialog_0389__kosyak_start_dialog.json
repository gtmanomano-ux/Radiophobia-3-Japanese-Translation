                        "source_xml_line":  1970,
                        "string_id":  "kosyak_start_dialog_phrase_2",
                        "occurrence":  1,
                        "EN":  "What are you selling and why are you sitting in this barn?",
                        "JA_current":  "What are you selling and why are you sitting in this barn?",
                        "JA_new":  "何を売ってる？ それに、なんでこんな納屋に座ってるんだ？",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
