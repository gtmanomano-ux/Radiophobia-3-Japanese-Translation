                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  2000,
                        "string_id":  "kosyak_start_dialog_phrase_12",
                        "occurrence":  1,
                        "EN":  "Here, take it, but remember: under no circumstances should you try to take several doses at once, or you\u0027ll OD in no time! Good luck, sportsman.",
                        "JA_current":  "Here, take it, but remember: under no circumstances should you try to take several doses at once, or you\u0027ll OD in no time! Good luck, sportsman.",
                        "JA_new":  "ほら、持っていけ。ただし、一度に何回分も使うなよ。すぐにオーバードーズするぞ！ 幸運を祈るぜ、アスリート。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
