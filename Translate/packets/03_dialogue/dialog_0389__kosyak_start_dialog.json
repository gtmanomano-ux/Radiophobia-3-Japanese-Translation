                        "source_xml_line":  1997,
                        "string_id":  "kosyak_start_dialog_phrase_11",
                        "occurrence":  1,
                        "EN":  "Not right now.",
                        "JA_current":  "Not right now.",
                        "JA_new":  "今はやめておく。",
