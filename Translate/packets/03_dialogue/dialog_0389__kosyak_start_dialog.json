                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_9#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1991,
                        "string_id":  "kosyak_start_dialog_phrase_9",
                        "occurrence":  1,
                        "EN":  "One Goldfish artifact for a couple of cubes, basically for one dose. The price is more than symbolic for such an effect.",
                        "JA_current":  "One Goldfish artifact for a couple of cubes, basically for one dose. The price is more than symbolic for such an effect.",
                        "JA_new":  "数回分、つまり一服につき«ゴールドフィッシュ»のアーティファクトをひとつだ。この効き目を考えれば、ほとんどタダみたいなもんさ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
                                           {
                                               "dialog_id":  "kosyak_start_dialog",
                                               "phrase_id":  "8",
                                               "graph_source":  "gamedata/config/gameplay/dialogs_military.xml"
                                           }
                                       ]
                    },
                    {
                        "key":  "stable_dialogs_military:kosyak_start_dialog_phrase_10#1",
                        "source_table":  "stable_dialogs_military",
                        "source_file":  "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
                        "source_xml_line":  1994,
                        "string_id":  "kosyak_start_dialog_phrase_10",
                        "occurrence":  1,
                        "EN":  "Okay, here\u0027s the artifact.",
                        "JA_current":  "Okay, here\u0027s the artifact.",
                        "JA_new":  "分かった。ほら、アーティファクトだ。",
                        "review_notes":  null,
                        "english_reference_status":  "same_table_and_id_occurrence",
                        "review_flags":  [

                                         ],
                        "graph_uses":  [
