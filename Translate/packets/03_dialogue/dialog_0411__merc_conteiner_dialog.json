      "source_xml_line": 137,
      "string_id": "merc_conteiner_dialog_phrase_1",
      "occurrence": 1,
      "EN": "Is there something you wanted to ask me?",
      "JA_current": "Is there something you wanted to ask me?",
      "JA_new": "何か聞きたいことがあるのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_2#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 140,
      "string_id": "merc_conteiner_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Yes. I'm interested in this container. Where did you find it?",
      "JA_current": "Yes. I'm interested in this container. Where did you find it?",
      "JA_new": "ああ。このコンテナに興味がある。どこで見つけた？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_3#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 143,
      "string_id": "merc_conteiner_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Well, I'm... I'm a messenger from Ara, I have an errand to give it to you!",
      "JA_current": "Well, I'm... I'm a messenger from Ara, I have an errand to give it to you!",
      "JA_new": "その……俺はアラからの使いだ。これをあんたに届けるよう頼まれた！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_4#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 146,
      "string_id": "merc_conteiner_dialog_phrase_4",
      "occurrence": 1,
      "EN": "I found it at the Army Depot, in the mercenary parking lot.",
      "JA_current": "I found it at the Army Depot, in the mercenary parking lot.",
      "JA_new": "軍事倉庫にあるマーセナリーズの駐車場で見つけた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_5#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 149,
      "string_id": "merc_conteiner_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Don't lie, tramp, I know the messenger personally. You'd better give me the container and we'll part as friends.",
      "JA_current": "Don't lie, tramp, I know the messenger personally. You'd better give me the container and we'll part as friends.",
      "JA_new": "うそをつくな、流れ者。使いの顔は知っている。コンテナを渡せば、互いに気持ちよく別れられるぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_6#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 152,
      "string_id": "merc_conteiner_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Give the container to me.",
      "JA_current": "Give the container to me.",
      "JA_new": "そのコンテナを渡せ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_7#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 155,
      "string_id": "merc_conteiner_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Wait, not so fast. What will you give me for it?",
      "JA_current": "Wait, not so fast. What will you give me for it?",
      "JA_new": "待てよ、そう急かすな。見返りは何だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_8#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 158,
      "string_id": "merc_conteiner_dialog_phrase_8",
      "occurrence": 1,
      "EN": "Except for a bullet in the heart, nothing. Just kidding. You're lucky I'm in a good mood, or I wouldn't have bargained with you. If you're so keen on getting rich, I can pay you.",
      "JA_current": "Except for a bullet in the heart, nothing. Just kidding. You're lucky I'm in a good mood, or I wouldn't have bargained with you. If you're so keen on getting rich, I can pay you.",
      "JA_new": "心臓に弾を一発……と言いたいところだが、冗談だ。機嫌がいいから交渉してやってる。金が欲しいなら、買い取ってやってもいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_9#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 161,
      "string_id": "merc_conteiner_dialog_phrase_9",
      "occurrence": 1,
      "EN": "Deal. How much for the container?",
      "JA_current": "Deal. How much for the container?",
      "JA_new": "いいだろう。いくら出す？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_10#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 164,
      "string_id": "merc_conteiner_dialog_phrase_10",
      "occurrence": 1,
      "EN": "Would 100,000 suit you?",
      "JA_current": "Would 100,000 suit you?",
      "JA_new": "10万でどうだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_11#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 167,
      "string_id": "merc_conteiner_dialog_phrase_11",
      "occurrence": 1,
      "EN": "Of-course.",
      "JA_current": "Of-course.",
      "JA_new": "もちろんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "10",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_12#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 170,
      "string_id": "merc_conteiner_dialog_phrase_12",
      "occurrence": 1,
      "EN": "Not enough.",
      "JA_current": "Not enough.",
      "JA_new": "それじゃ足りない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_13#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 173,
      "string_id": "merc_conteiner_dialog_phrase_13",
      "occurrence": 1,
      "EN": "Tramp, don't test my patience! For the last time, take the 100,000 or you'll regret it!",
      "JA_current": "Tramp, don't test my patience! For the last time, take the 100,000 or you'll regret it!",
      "JA_new": "流れ者、俺の我慢を試すな！ これで最後だ。10万を受け取れ。さもないと後悔するぞ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "12",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_pripyat:merc_conteiner_dialog_phrase_14#1",
      "source_table": "stable_dialogs_pripyat",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_pripyat.xml",
      "source_xml_line": 176,
      "string_id": "merc_conteiner_dialog_phrase_14",
      "occurrence": 1,
      "EN": "Okay, fine.",
      "JA_current": "Okay, fine.",
      "JA_new": "分かった。それでいい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "merc_conteiner_dialog",
          "phrase_id": "13",
          "graph_source": "gamedata/config/gameplay/dialogs_pripyat.xml"
        }
      ]
    },
