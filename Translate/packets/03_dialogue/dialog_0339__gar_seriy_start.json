  "entries": [
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_11#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 201,
      "string_id": "gar_seriy_start_11",
      "occurrence": 1,
      "EN": "Dammit it man, this ain't no time for talking! In a few seconds the only things talking will be guns. Help me fight them off and we can talk after.",
      "JA_current": "何だよ！ 油売ってる暇は無いって言ってるだろ！ もうすぐ銃で話をつける事になるんだ。このケンカを手伝ってくれれば後で幾らでも話してやるさ！",
      "JA_new": "くそっ、話してる場合じゃない！あと数秒もすれば、口を利くのは銃だけだ。奴らを追い払うのを手伝ってくれ。話はそれからだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_22#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 204,
      "string_id": "gar_seriy_start_22",
      "occurrence": 1,
      "EN": "Thanks for the help, things got pretty hairy. What are you doing here anyway?",
      "JA_current": "助かったよ。だけどややこしい事になっちまったな。ところでお前さんここで何をしているんだ？",
      "JA_new": "助かったよ、さっきは危なかった。ところで、ここで何を？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "22",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_33#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 225,
      "string_id": "gar_seriy_start_33",
      "occurrence": 1,
      "EN": "Hey man! Things got pretty hairy here a minute ago, I have to say. What are you doing here anyway?",
      "JA_current": "ヨォ！ ついさっきの件でちょっとややこしい事になっちまったな。一応聞いとくが、お前さんここで何やってんだい？",
      "JA_new": "やあ。さっきはかなり危なかったな。あんたはここで何を？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "33",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_44#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 228,
      "string_id": "gar_seriy_start_44",
      "occurrence": 1,
      "EN": "A safe path, stalker. A safe path past the anomalies and straight to the artifacts.",
      "JA_current": "「安全な道」だよストーカー。アノーマリーの間を抜けてアーティファクトのありかへ続く「安全な道」さ。",
      "JA_new": "安全な道だ、ストーカー。アノマリーを避けて、そのままアーティファクトまで行ける。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "44",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_221#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 207,
      "string_id": "gar_seriy_start_221",
      "occurrence": 1,
      "EN": "I am looking for information about Strelok. Fox told me about you, so I came for a chat.",
      "JA_current": "Strelok の情報を探している。Fox に言われてアンタに話をしにきたんだが。",
      "JA_new": "ストレロクの情報を探してる。フォックスからあんたのことを聞いて、話をしに来た。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "221",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_222#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 216,
      "string_id": "gar_seriy_start_222",
      "occurrence": 1,
      "EN": "I am looking for information about Strelok, maybe you know something?",
      "JA_current": "Strelok についての情報を探してるんだが、何か知らないか？",
      "JA_new": "ストレロクの情報を探してる。何か知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "222",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_441#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 231,
      "string_id": "gar_seriy_start_441",
      "occurrence": 1,
      "EN": "What can one find at the Garbage?",
      "JA_current": "Garbage では 何が見つけられる？",
      "JA_new": "このガーベジでは何が見つかる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "441",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_2211#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 210,
      "string_id": "gar_seriy_start_2211",
      "occurrence": 1,
      "EN": "OK, you helped me out for free so I'll tell you. One of the guys, a former \"digger\" called Mole is waiting for me. He dug up Strelok's stash but I don't know if he found anything there. Here are the coordinates of our meeting place. Tell him I sent you. They'll be looking for me now, so I am going to disappear for a while. Here's some cash for your help too.",
      "JA_current": "オーケー、教えてやるよ。お前は通りがかりなのに助けてくれたからな。かつて「発掘者」と呼ばれていた Mole ってやつが俺を待ってる。奴は Strelok の隠したものを掘り出したらしい。だがあいつがそこで何を見つけたにしろ、俺には分からない。ここが俺たちの待ち合わせ場所だ。奴には俺がお前を行かせたことを伝えてくれ。俺は今、お尋ね者なんだ。だからしばらく姿を消す。それと、助けてくれた礼だ。受け取ってくれ。",
      "JA_new": "いいとも、ただで手を貸してくれたんだ。こっちも教えてやる。モグラって男が俺を待ってる。前は「ディガー」と呼ばれてた奴だ。ストレロクの隠し場所を掘り当てたらしいが、何か見つけたのかは分からない。待ち合わせ場所の座標を渡す。俺の紹介だと言ってくれ。今ごろ連中が俺を探してるから、しばらく姿を消す。助けてくれた礼の金も受け取ってくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "2211",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_2221#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 219,
      "string_id": "gar_seriy_start_2221",
      "occurrence": 1,
      "EN": "OK, you helped me out for free, so I'll tell you. One of the guys, a former \"digger\" called Mole, is waiting for me. He dug up Strelok's stash and found documents that explain a few things. He had some bandits on his tail so he had to leave the documents but he remembered the place. They'll be looking for me now so I am gonna disappear for a while. Here are the coordinates of the meeting place with Mole. Tell him I sent you. I'll upload some info to your PDA. Here's some cash for your help too.",
      "JA_current": "オーケー、教えてやるよ。お前は通りがかりなのに助けてくれたからな。かつて「発掘者」と呼ばれていた Mole ってやつが俺を待ってる。奴は Strelok の隠したものを掘り出したらしい。だがあいつがそこで何を見つけたにしろ、俺には分からない。ここが俺たちの待ち合わせ場所だ。お前の PDA に場所を入力しておこう。奴には俺がお前を行かせたことを伝えてくれ。俺は今、お尋ね者なんだ。だからしばらく姿を消す。それと、助けてくれた礼だ。受け取ってくれ。",
      "JA_new": "助けてもらった礼に教えてやるよ。モグラって男が俺を待ってる。前は「ディガー」だった奴だ。ストレロクの隠し場所を掘り当てて、いくつかの謎を解く書類を見つけた。だがバンディットに追われて、書類は置いてくるしかなかった。場所は覚えてるそうだ。今ごろ連中が俺を探してるから、しばらく姿を消す。モグラとの待ち合わせ場所の座標だ。俺の紹介だと言ってくれ。情報はPDAにも送っておく。助けてくれた礼の金も受け取ってくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "2221",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_4411#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 234,
      "string_id": "gar_seriy_start_4411",
      "occurrence": 1,
      "EN": "You can find a lot of trouble real quick, that's for sure. But since you're such an explorer I'll tell you what I know. To the East there is a little forest. Nothing interesting there and it's full of dogs, so be careful. This railway track will lead you to a tunnel. There are lots of anomalies there, maybe something else too but I don't know - never really looked very hard. You probably know about the Duty checkpoint in the North. That's basically all I know about this place.",
      "JA_current": "大量のトラブルならすぐ見つかるさ。保証するぜ。…冗談だ。マジメに教えてやるよ。東には小さい森がある。ここには大した物は無いが、犬なら腐るほど居るから気をつけろ。この線路はトンネルに続いてる。そこには大量のアノーマリーで満ちてて多分何かあるだろうが、詳しくは知らん。恐らく入り込むのは滅茶苦茶難しいぞ。後はお前もご存知の Duty の検問所だな。これは北にある。この辺の紹介としてはこんなところかな。",
      "JA_new": "面倒に巻き込まれるのは間違いないがな。まあ、探検好きみたいだし、知ってることを教えてやる。東に小さな森がある。特に見るものはないが、犬だらけだ。気をつけろ。この線路を行けばトンネルに出る。アノマリーがいくつもある。ほかにも何かあるかもしれないが、俺はろくに調べてない。北のデューティー検問所は知ってるだろ。俺が知ってるのはそれくらいだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "gar_seriy_start",
          "phrase_id": "4411",
          "graph_source": "gamedata/config/gameplay/dialogs_garbage.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_garbage:gar_seriy_start_2212#1",
      "source_table": "stable_dialogs_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_garbage.xml",
      "source_xml_line": 213,
      "string_id": "gar_seriy_start_2212",
      "occurrence": 1,
      "EN": "Thanks for the information.",
      "JA_current": "情報をありがとう。",
