      ]
    },
    {
      "phrase_id": "2211",
      "text_id": "gar_seriy_start_2211",
      "next": [
        "2212"
      ],
      "conditions": [],
      "effects": [
        {
          "type": "action",
          "value": "garbage_dialogs.seryi_payment"
        },
        {
          "type": "give_info",
          "value": "agr_can_ask_krot_about_gunslinger"
        },
        {
          "type": "give_info",
          "value": "agr_krot_band_start"
        }
      ],
      "other_control": [],
      "incoming": [
        "221"
      ],
      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "OK, you helped me out for free so I'll tell you. One of the guys, a former \"digger\" called Mole is waiting for me. He dug up Strelok's stash but I don't know if he found anything there. Here are the coordinates of our meeting place. Tell him I sent you. They'll be looking for me now, so I am going to disappear for a while. Here's some cash for your help too.",
      "JA_current": "オーケー、教えてやるよ。お前は通りがかりなのに助けてくれたからな。かつて「発掘者」と呼ばれていた Mole ってやつが俺を待ってる。奴は Strelok の隠したものを掘り出したらしい。だがあいつがそこで何を見つけたにしろ、俺には分からない。ここが俺たちの待ち合わせ場所だ。奴には俺がお前を行かせたことを伝えてくれ。俺は今、お尋ね者なんだ。だからしばらく姿を消す。それと、助けてくれた礼だ。受け取ってくれ。",
      "string_entry_candidates": [
        "stable_dialogs_garbage:gar_seriy_start_2211#1"
      ]
    },
    {
      "phrase_id": "2221",
      "text_id": "gar_seriy_start_2221",
      "next": [
        "2222"
      ],
      "conditions": [],
      "effects": [
        {
          "type": "action",
          "value": "garbage_dialogs.seryi_payment"
        },
        {
          "type": "give_info",
          "value": "agr_krot_band_start"
        },
        {
          "type": "give_info",
          "value": "agr_can_ask_krot_about_gunslinger"
        }
      ],
      "other_control": [],
      "incoming": [
        "222"
      ],
      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "OK, you helped me out for free, so I'll tell you. One of the guys, a former \"digger\" called Mole, is waiting for me. He dug up Strelok's stash and found documents that explain a few things. He had some bandits on his tail so he had to leave the documents but he remembered the place. They'll be looking for me now so I am gonna disappear for a while. Here are the coordinates of the meeting place with Mole. Tell him I sent you. I'll upload some info to your PDA. Here's some cash for your help too.",
      "JA_current": "オーケー、教えてやるよ。お前は通りがかりなのに助けてくれたからな。かつて「発掘者」と呼ばれていた Mole ってやつが俺を待ってる。奴は Strelok の隠したものを掘り出したらしい。だがあいつがそこで何を見つけたにしろ、俺には分からない。ここが俺たちの待ち合わせ場所だ。お前の PDA に場所を入力しておこう。奴には俺がお前を行かせたことを伝えてくれ。俺は今、お尋ね者なんだ。だからしばらく姿を消す。それと、助けてくれた礼だ。受け取ってくれ。",
      "string_entry_candidates": [
        "stable_dialogs_garbage:gar_seriy_start_2221#1"
      ]
    },
    {
      "phrase_id": "4411",
      "text_id": "gar_seriy_start_4411",
      "next": [
        "44112"
      ],
      "conditions": [],
      "effects": [],
      "other_control": [],
      "incoming": [
        "441"
      ],
      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "You can find a lot of trouble real quick, that's for sure. But since you're such an explorer I'll tell you what I know. To the East there is a little forest. Nothing interesting there and it's full of dogs, so be careful. This railway track will lead you to a tunnel. There are lots of anomalies there, maybe something else too but I don't know - never really looked very hard. You probably know about the Duty checkpoint in the North. That's basically all I know about this place.",
      "JA_current": "大量のトラブルならすぐ見つかるさ。保証するぜ。…冗談だ。マジメに教えてやるよ。東には小さい森がある。ここには大した物は無いが、犬なら腐るほど居るから気をつけろ。この線路はトンネルに続いてる。そこには大量のアノーマリーで満ちてて多分何かあるだろうが、詳しくは知らん。恐らく入り込むのは滅茶苦茶難しいぞ。後はお前もご存知の Duty の検問所だな。これは北にある。この辺の紹介としてはこんなところかな。",
      "string_entry_candidates": [
        "stable_dialogs_garbage:gar_seriy_start_4411#1"
      ]
    },
