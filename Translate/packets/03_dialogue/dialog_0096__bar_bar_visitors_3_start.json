      "incoming": [
        "21"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Yeah, I wish I knew...",
      "JA_current": "ああ、知りたいな…。",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_211#1"
      ]
    },
    {
      "phrase_id": "311",
      "text_id": "bar_bar_visitors_1_start_311",
