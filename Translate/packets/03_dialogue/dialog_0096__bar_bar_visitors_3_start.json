      ],
      "speaker_hint": "npc",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "What do you want?",
      "JA_current": "何がお望みだい？",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_3_start_71#1"
      ]
    },
    {
      "phrase_id": "111",
      "text_id": "bar_bar_visitors_1_start_111",
      "next": [],
      "conditions": [],
      "effects": [
        {
