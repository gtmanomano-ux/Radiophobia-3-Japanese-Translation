    },
    {
      "key": "stable_dialogs_bar:bar_bar_visitors_3_start_7111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 1127,
      "string_id": "bar_bar_visitors_3_start_7111",
      "occurrence": 1,
      "EN": "The Wild Territory is infested with bloodsuckers now! They come out at night. I heard there's something really important at the factory that's nearby, something essential to someone. Duty sent some guys in there recently but they all died and their screams were heard from kilometers away.",
      "JA_current": "今 Wild Territory には、Bloodsuckers がはびこっている！ ヤツらは夜になると現れる。その近くの工場に、ある者にとっては必須な、本当に重要なある物が存在するらしい。最近 Duty が、何人かの兵をそこへ送った。だが皆、殺られた。その悲鳴は何キロも離れた所までも響き渡ったそうだ。",
      "JA_new": "今じゃ荒廃領域はブラッドサッカーだらけだ！ 夜になると出てくる。近くの工場に、誰かにとって大事な物があるらしい。デューティーが最近何人か送り込んだが、全員やられた。何キロも先まで悲鳴が聞こえたそうだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_3_start",
          "phrase_id": "7111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
