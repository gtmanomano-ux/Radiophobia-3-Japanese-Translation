      "other_control": [],
      "incoming": [
        "11"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Yeah, it was about time.",
      "JA_current": "ああ、そろそろだったな。",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_111#1"
      ]
    },
    {
      "phrase_id": "211",
      "text_id": "bar_bar_visitors_1_start_211",
      "next": [],
      "conditions": [],
      "effects": [
        {
          "type": "action",
