      "occurrence": 1,
      "EN": "What's new?",
      "JA_current": "何かニュースはないか？",
      "JA_new": "最近、何かあったか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_visitors_3_start",
