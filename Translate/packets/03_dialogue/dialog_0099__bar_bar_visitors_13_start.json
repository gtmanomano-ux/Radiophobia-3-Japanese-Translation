      ],
      "other_control": [],
      "incoming": [
        "11"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Yeah, it was about time.",
      "JA_current": "ああ、そろそろだったな。",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_111#1"
      ]
    },
    {
      "phrase_id": "211",
      "text_id": "bar_bar_visitors_1_start_211",
      "next": [],
      "conditions": [],
      "effects": [
        {
          "type": "action",
          "value": "dialogs.break_dialog"
        }
      ],
      "other_control": [],
      "incoming": [
        "21"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "Yeah, I wish I knew...",
      "JA_current": "ああ、知りたいな…。",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_211#1"
      ]
    },
    {
      "phrase_id": "311",
      "text_id": "bar_bar_visitors_1_start_311",
      "next": [],
      "conditions": [],
      "effects": [
        {
          "type": "action",
          "value": "dialogs.break_dialog"
        }
      ],
      "other_control": [],
      "incoming": [
        "31"
      ],
      "speaker_hint": "player",
      "speaker_hint_basis": "character_binding_and_link_parity",
      "EN": "What was Duty doing? They were doing Freedom, what else?",
      "JA_current": "Duty は何してたんだ？ ヤツらは Freedom にかかりっきりで、他には何も？",
      "string_entry_candidates": [
        "stable_dialogs_bar:bar_bar_visitors_1_start_311#1"
      ]
    },
    {
