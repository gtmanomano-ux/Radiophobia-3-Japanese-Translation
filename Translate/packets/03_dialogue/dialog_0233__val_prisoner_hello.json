  "entries": [
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_11#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 311,
      "string_id": "val_prisoner_hello_11",
      "occurrence": 1,
      "EN": "Hey, buddy! Help me! I'm a Duty scout. Help me get out!",
      "JA_current": "なあ兄弟！ 助けてくれ！ 俺は Duty の斥候だ。外に出してくれ！",
      "JA_new": "なあ、助けてくれ！俺はデューティーの偵察兵だ。ここから逃がしてくれ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_21#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 320,
      "string_id": "val_prisoner_hello_21",
      "occurrence": 1,
      "EN": "Thanks, brother! I owe you one. Look what I was able to find out - it might prove useful to you, who knows... Borov - the one who calls the shots - has collected quite a lot of goodies. He's got a piece of the key to the lower level at the old factory. I heard the guards yapping, they said there used to be some kind of lab there. Thing is, getting close to Borov isn't so simple.",
      "JA_current": "有り難う兄弟！ 借りが一つ出来たな。聞いてくれ、俺が見つけたことは ― これは役に立つと思うが、Borov として知られる男… ― The Shots と呼ばれる1人 ― は、かなり多くのお宝を集めたようだ。奴は古い工場の、地下の鍵の断片を持っている。警備の独り言を聞いたが、とある研究室がそこにあると言ってた。だが実際にゃ、Borov に近づくのはそう容易じゃないぞ。",
      "JA_new": "兄弟、助かったよ。借りができたな。役立つかもしれないから、分かったことを教えてやる……仕切ってるボロフは、お宝をかなり集めてる。旧工場の下層へ続く鍵の一部を持ってるらしい。看守たちが話してたんだ。昔、あそこには何か研究所があったらしい。だが、ボロフに近づくのは簡単じゃない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_31#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 332,
      "string_id": "val_prisoner_hello_31",
      "occurrence": 1,
      "EN": "We gotta get outta here before these bastards decide to check this place out! Need something? Get it quick!",
      "JA_current": "クソッタレ共がここを調べる前に外に出なきゃなんねぇ、何が必要だ？急げ！",
      "JA_new": "このクソどもが様子を見に来る前に、ここを出ないと！何か要るか？欲しい物があるなら急げ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_41#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 338,
      "string_id": "val_prisoner_hello_41",
      "occurrence": 1,
      "EN": "Hey! There's a switch over there on the wall - it opens the cell door.",
      "JA_current": "おおい、そこの壁にスイッチがあるぞ！ この監房の扉を開けられる。",
      "JA_new": "おい、壁のスイッチを見ろ。あれを押せば牢の扉が開く。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_111#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 314,
      "string_id": "val_prisoner_hello_111",
      "occurrence": 1,
      "EN": "I'll try.",
      "JA_current": "やってみよう。",
      "JA_new": "やってみる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
