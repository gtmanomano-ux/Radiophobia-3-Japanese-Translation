    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_2111#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 326,
      "string_id": "val_prisoner_hello_2111",
      "occurrence": 1,
      "EN": "It's time for me to get back to our guys. Something tells me we'll be lucky to get out of here alive...",
      "JA_current": "そろそろ奴らが戻ってくる時間だ。ここから生きて出るため、誰か幸運を分けてくれ…。",
      "JA_new": "そろそろ仲間のところへ戻る。ここから生きて出られたら運がいい、そんな気がする……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_prisoner_hello",
