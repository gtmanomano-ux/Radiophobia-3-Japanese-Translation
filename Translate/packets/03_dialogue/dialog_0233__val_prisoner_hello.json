      "string_id": "val_prisoner_hello_411",
      "occurrence": 1,
      "EN": "OK, I'll look.",
      "JA_current": "オーケー、見てみる。",
      "JA_new": "分かった。見てみる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
