        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_prisoner_hello_112#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 317,
      "string_id": "val_prisoner_hello_112",
      "occurrence": 1,
      "EN": "There's nothing I can do for you.",
      "JA_current": "アンタのためにしてやれることは無いよ。",
      "JA_new": "悪いが、力になれそうにない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
