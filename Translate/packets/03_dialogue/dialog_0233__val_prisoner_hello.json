      "string_id": "val_prisoner_hello_211",
      "occurrence": 1,
      "EN": "Thanks for the information.",
      "JA_current": "情報をありがとう。",
      "JA_new": "情報をありがとう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
