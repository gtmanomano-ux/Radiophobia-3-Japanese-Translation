      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 118,
      "string_id": "borov_ask_document_3",
      "occurrence": 1,
      "EN": "That sucks! I ain't gonna wait for ages! Get it?",
      "JA_current": "That sucks! I ain't gonna wait for ages! Get it?",
      "JA_new": "ふざけんな！いつまでも待ってられるか！分かったな？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_enter_bandit_2",
