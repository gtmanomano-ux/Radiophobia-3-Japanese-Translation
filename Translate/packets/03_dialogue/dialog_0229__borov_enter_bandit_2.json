    },
    {
      "key": "stable_dialogs_darkvalley:borov_ask_document_6#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 127,
      "string_id": "borov_ask_document_6",
      "occurrence": 1,
      "EN": "Not bad, Marked One. Well, I'm a man of my word. You've settled the matter alright - you get the key to the lab. You must be a real action man, if you've got the balls to go down into those catacombs. Wanna join us?",
      "JA_current": "Not bad, Marked One. Well, I'm a man of my word. You've settled the matter alright - you get the key to the lab. You must be a real action man, if you've got the balls to go down into those catacombs. Wanna join us?",
      "JA_new": "いい仕事だ、マークド・ワン。俺は約束を守る。これで話はついた。ラボの鍵を渡そう。地下墓地に入る度胸があるとは、大したタマだな。俺たちの仲間にならないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_enter_bandit_2",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_ask_document_11#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 142,
      "string_id": "borov_ask_document_11",
      "occurrence": 1,
      "EN": "Not bad, Marked One. Well, I'm a man of my word. You've settled the matter for us - you get the key to the lab.",
      "JA_current": "Not bad, Marked One. Well, I'm a man of my word. You've settled the matter for us - you get the key to the lab.",
      "JA_new": "いい仕事だ、マークド・ワン。俺は約束を守る。これでこっちの用も済んだ。ラボの鍵はあんたのものだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
