  "entries": [
    {
      "key": "stable_dialogs_bar:bar_bar_hunter_start_11#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 878,
      "string_id": "bar_bar_hunter_start_11",
      "occurrence": 1,
      "EN": "I've got a big problem man! I... I lost my family rifle in the Wild Territory. I wanted to shoot some bloodsuckers but I barely got away. Damn! Listen, bro... if you get it back I'll pay you. I've made a little cash here and I'll give you all of it, just get my rifle back. It's a family rifle, you know, passed down from father to son... And I lost it! I've grown attached to it, it's like an extension of my arm now...",
      "JA_current": "どうしたらいいんだ！ 一家に伝わるライフルを Wild Territory で失くしちまった。Bloodsucker を撃ちたかったんだが、殆ど逃げ出しちまった。くそ！ 聞いてくれ、兄弟… もし取り返してくれたなら報酬を渡そう。少しだが金も工面した… ライフルを取り戻してくれれば全部アンタにやるよ。父から子へ… 一家に伝わるライフルなんだぜ？ …なのに失くちまった！ ガキの頃から使ってきたんだ、もう身体の一部の様なものなんだよ…。",
      "JA_new": "大変なんだよ！ 俺……家宝のライフルを荒廃領域でなくしちまった。ブラッドサッカーを撃とうとしたんだが、逃げるのが精一杯だった。くそっ！ なあ、頼むよ……見つけてくれたら金を払う。少し貯めた金がある。全部やるから、あのライフルを取り戻してくれ。父から息子へ受け継がれてきた大切な銃なんだ……それをなくしちまった！ もう体の一部みたいなもんでさ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_hunter_start",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_hunter_start_21#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 881,
      "string_id": "bar_bar_hunter_start_21",
      "occurrence": 1,
      "EN": "Hey! Any news? Did you find it?!",
      "JA_current": "おい！ 何かニュースがあるのか？ あれを見つけたのか？",
      "JA_new": "おい！ 何か分かったか？ 見つかったのか！？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
