      "source_xml_line": 472,
      "string_id": "hitruga_reward_2_dialog_phrase_3",
      "occurrence": 1,
      "EN": "I don't understand, don't you believe me?",
      "JA_current": "I don't understand, don't you believe me?",
      "JA_new": "何が言いたい？　信じてないのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
