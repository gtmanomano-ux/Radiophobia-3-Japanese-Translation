    },
    {
      "key": "stable_dialogs_darkvalley:hitruga_reward_2_dialog_phrase_4#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 474,
      "string_id": "hitruga_reward_2_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Don't take me for an idiot! I followed you to the roadblock and watched your approach with binoculars. You didn't waste the Archaeologist, instead you came back here and tried to trick me. Well, that didn't work out the way you planned, did it? Now, I've got to waste you to ensure you don't blab!",
      "JA_current": "Don't take me for an idiot! I followed you to the roadblock and watched your approach with binoculars. You didn't waste the Archaeologist, instead you came back here and tried to trick me. Well, that didn't work out the way you planned, did it? Now, I've got to waste you to ensure you don't blab!",
      "JA_new": "馬鹿にするな！　検問所までつけて、双眼鏡で様子を見てたんだ。考古学者を殺さず、ここに戻って俺をだまそうとしたな。思いどおりにはいかなかったようだが？　口封じに、お前も始末するしかないな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "hitruga_reward_2_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
