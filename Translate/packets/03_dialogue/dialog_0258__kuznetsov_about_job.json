        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_phr_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1969,
      "string_id": "ogse_kuznetsov_phr_3",
      "occurrence": 1,
      "EN": "Damn right! You come and try to make it on that small change for yourself. I bet you wouldn't last a year.",
      "JA_current": "Damn right! You come and try to make it on that small change for yourself. I bet you wouldn't last a year.",
      "JA_new": "そのとおりだ！　あのはした金で暮らしてみろよ。一年もたねえだろうな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_rep_3#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1972,
      "string_id": "ogse_kuznetsov_rep_3",
      "occurrence": 1,
      "EN": "It's really hard to make it, indeed.",
      "JA_current": "It's really hard to make it, indeed.",
      "JA_new": "確かに、やっていくのは大変だな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_phr_4#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1975,
      "string_id": "ogse_kuznetsov_phr_4",
      "occurrence": 1,
      "EN": "Just imagine it. For that pittance of a salary, I am expected to display enormous pride in my service, my State and my government! What a fucking joke...",
      "JA_current": "Just imagine it. For that pittance of a salary, I am expected to display enormous pride in my service, my State and my government! What a fucking joke...",
      "JA_new": "想像してみろよ。こんなはした金で、軍務や国家や政府に誇りを持てって言われるんだぜ！　笑わせるな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_rep_4#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1978,
      "string_id": "ogse_kuznetsov_rep_4",
      "occurrence": 1,
      "EN": "So you've lost all pride in your service?",
      "JA_current": "So you've lost all pride in your service?",
      "JA_new": "軍務に誇りを持てなくなったのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_phr_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1981,
      "string_id": "ogse_kuznetsov_phr_5",
      "occurrence": 1,
      "EN": "The big wigs, every single one, are up to their necks in wealth thanks to the shit they smuggle from the Zone! All this while we're stuck here, getting shot up, torn up by anomalies, irradiated to shit and eaten alive by freaks crawling out of every shrub and not seeing a single dime of those profits that the higher-ups are swimming in. You tell me, what is there to be proud of!? Why should I keep away from this kind'a business?!",
      "JA_current": "The big wigs, every single one, are up to their necks in wealth thanks to the shit they smuggle from the Zone! All this while we're stuck here, getting shot up, torn up by anomalies, irradiated to shit and eaten alive by freaks crawling out of every shrub and not seeing a single dime of those profits that the higher-ups are swimming in. You tell me, what is there to be proud of!? Why should I keep away from this kind'a business?!",
      "JA_new": "お偉方は全員、ゾーンから密輸した物で大金持ちだ！　その間、俺たちはここで撃たれ、アノマリーに引き裂かれ、放射能まみれになり、藪から出てくる化け物に食われかけてる。上の連中が儲けた金は、俺たちには一銭も回ってこない。何を誇れっていうんだ？　俺がこんな稼ぎ方をするなと？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_rep_5#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1984,
      "string_id": "ogse_kuznetsov_rep_5",
      "occurrence": 1,
      "EN": "Good question.",
      "JA_current": "Good question.",
      "JA_new": "もっともな話だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "10",
