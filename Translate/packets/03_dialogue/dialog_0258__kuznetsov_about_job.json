      "string_id": "ogse_kuznetsov_rep_0",
      "occurrence": 1,
      "EN": "You let people through for money, don't you?",
      "JA_current": "You let people through for money, don't you?",
      "JA_new": "金をもらって、人を通してるんだろ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
