    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_phr_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1963,
      "string_id": "ogse_kuznetsov_phr_2",
      "occurrence": 1,
      "EN": "Hey, wise guy, do you happen to know how much my official salary is?",
      "JA_current": "Hey, wise guy, do you happen to know how much my official salary is?",
      "JA_new": "なあ、物知りさんよ。俺の正規の給料がいくらか知ってるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_escape.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_escape:ogse_kuznetsov_rep_2#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 1966,
      "string_id": "ogse_kuznetsov_rep_2",
      "occurrence": 1,
      "EN": "Not much, I guess.",
      "JA_current": "Not much, I guess.",
      "JA_new": "たいした額じゃないんだろうな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "kuznetsov_about_job",
          "phrase_id": "4",
