      "occurrence": 1,
      "EN": "Go on.",
      "JA_current": "それから？",
      "JA_new": "それで？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
