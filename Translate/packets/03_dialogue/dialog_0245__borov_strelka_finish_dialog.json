      "string_id": "borov_strelka_finish_dialog_phrase_2",
      "occurrence": 1,
      "EN": "So what's up?",
      "JA_current": "So what's up?",
      "JA_new": "それで、どうなった？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_strelka_finish_dialog",
