          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_strelka_finish_dialog_phrase_3#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 647,
      "string_id": "borov_strelka_finish_dialog_phrase_3",
      "occurrence": 1,
      "EN": "You were right, the stalker ambushed us with his pals, we took them out.",
      "JA_current": "You were right, the stalker ambushed us with his pals, we took them out.",
      "JA_new": "あんたの言ったとおりだった。ストーカーが仲間を連れて待ち伏せしてたが、全員片づけた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_strelka_finish_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_strelka_finish_dialog_phrase_4#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 650,
      "string_id": "borov_strelka_finish_dialog_phrase_4",
      "occurrence": 1,
      "EN": "That takes some skill, proves to me you're a real man! Stories are gonna spread, now no one around here has any right to give you shit without good reason, and you will answer only to one guy, me! Understand?",
      "JA_current": "That takes some skill, proves to me you're a real man! Stories are gonna spread, now no one around here has any right to give you shit without good reason, and you will answer only to one guy, me! Understand?",
      "JA_new": "なかなかやるじゃねえか。お前が本物だって分かったぜ！　噂も広まるだろう。これからは、よほどの理由がない限り誰もお前に文句は言えねえ。お前が従う相手は一人だけ、俺だ。分かったな？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_strelka_finish_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_strelka_finish_dialog_phrase_5#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 653,
      "string_id": "borov_strelka_finish_dialog_phrase_5",
      "occurrence": 1,
      "EN": "I got it, boss. So have I earned those stripes now? Do I get a suit?",
      "JA_current": "I got it, boss. So have I earned those stripes now? Do I get a suit?",
      "JA_new": "分かったよ、ボス。それで、もう一人前ってことでいいのか？　スーツももらえる？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_strelka_finish_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_strelka_finish_dialog_phrase_6#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 656,
      "string_id": "borov_strelka_finish_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Don't be stupid, you've got your stripes, you're a part of the group. The part about the suit was just a metaphor, a suit in the Zone would be about as useful as an ashtray on a motorbike!",
      "JA_current": "Don't be stupid, you've got your stripes, you're a part of the group. The part about the suit was just a metaphor, a suit in the Zone would be about as useful as an ashtray on a motorbike!",
      "JA_new": "馬鹿言うな。お前はもう仲間だ。「スーツ」ってのはたとえ話だよ。ゾーンで着るスーツなんざ、バイクの灰皿みたいなもんだ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "borov_strelka_finish_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:borov_strelka_finish_dialog_phrase_7#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 659,
      "string_id": "borov_strelka_finish_dialog_phrase_7",
      "occurrence": 1,
      "EN": "Great.",
      "JA_current": "Great.",
      "JA_new": "そいつはよかった。",
