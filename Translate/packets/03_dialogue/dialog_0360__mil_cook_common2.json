      "string_id": "mil_cook_common2_0",
      "occurrence": 1,
      "EN": "What is this place, anyway?",
      "JA_current": "一体ここは何なんだ？",
      "JA_new": "ここは何なんだ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
