        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common2_201#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 149,
      "string_id": "mil_cook_common2_201",
      "occurrence": 1,
      "EN": "This place... a nice little place... It's just a normal place, you know... just some people making a living, hehe...",
      "JA_current": "ここは小さな良い場所さ… 知っての通り、ただ単に人が暮らしてる何の変哲もない場所だぜ。へへへ…。",
      "JA_new": "ここか……いい所だよ……普通の場所さ。人が暮らしてるだけ……へへ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
          "phrase_id": "201",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common2_202#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 152,
      "string_id": "mil_cook_common2_202",
      "occurrence": 1,
      "EN": "So what?",
      "JA_current": "それでここは？",
      "JA_new": "それで？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
          "phrase_id": "202",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common2_203#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 155,
      "string_id": "mil_cook_common2_203",
      "occurrence": 1,
      "EN": "Pfft... You're asking some tough questions, Mr. Stranger!",
      "JA_current": "ププッ… すげぇことを聞いてくれるよな、よそ者さんよ！",
      "JA_new": "はあ……妙に鋭い質問をするな、あんた！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
          "phrase_id": "203",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common2_204#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 158,
      "string_id": "mil_cook_common2_204",
      "occurrence": 1,
      "EN": "And what if you cut to the chase?",
      "JA_current": "話を戻すと、ここは？",
      "JA_new": "要点だけ言ってくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
          "phrase_id": "204",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common2_205#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 161,
      "string_id": "mil_cook_common2_205",
      "occurrence": 1,
      "EN": "Hey, relax! Hold on... well... it's just a normal place! A quiet one. All good all around. Yeah...you relax, alright? Don't get all worked up...",
      "JA_current": "へい、リラックスしろ！ 待て… いいか… ここはおかしな場所じゃない！ ただ秘密の場所だ。どこも問題ない。そう… リラックスして、大丈夫か？ あんまり興奮するな…。",
      "JA_new": "おい、落ち着け！待て……つまり……普通の場所さ！静かで、何も問題ない。ああ……落ち着け、な？そんなにカッカするな……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common2",
          "phrase_id": "205",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    }
