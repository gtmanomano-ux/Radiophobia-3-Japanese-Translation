      "source_xml_line": 2199,
      "string_id": "yuriy_hello_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Mentor told me about you.",
      "JA_current": "Mentor told me about you.",
      "JA_new": "師匠からあんたのことを聞いた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_hello_dialog",
          "phrase_id": "3",
