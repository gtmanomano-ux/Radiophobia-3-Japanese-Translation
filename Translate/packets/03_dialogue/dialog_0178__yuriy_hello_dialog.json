      "string_id": "yuriy_hello_dialog_phrase_8",
      "occurrence": 1,
      "EN": "I'll keep my eyes peeled for your guys, I'll let you know if I find any.",
      "JA_current": "I'll keep my eyes peeled for your guys, I'll let you know if I find any.",
