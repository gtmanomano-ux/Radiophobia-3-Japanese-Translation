        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_hello_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2202,
      "string_id": "yuriy_hello_dialog_phrase_5",
      "occurrence": 1,
      "EN": "A mentor, huh? Well, I guess you're a decent person of sound mind and sharp wits.. Having a mentor is an indication of good character!",
      "JA_current": "A mentor, huh? Well, I guess you're a decent person of sound mind and sharp wits.. Having a mentor is an indication of good character!",
      "JA_new": "師匠がいるのか。なるほどな……あんたは分別もあるし、頭の回転も速そうだ。師匠がいるってことは、見込みがある証拠だな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_hello_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_hello_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2205,
      "string_id": "yuriy_hello_dialog_phrase_6",
      "occurrence": 1,
      "EN": "Ha-ha, funny.. He said you were in trouble?",
      "JA_current": "Ha-ha, funny.. He said you were in trouble?",
      "JA_new": "ははっ、面白いな……師匠から、あんたが困ってるって聞いたよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_hello_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:yuriy_hello_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2208,
      "string_id": "yuriy_hello_dialog_phrase_7",
      "occurrence": 1,
      "EN": "I guess you could say that. Most of our group has completely vanished, no trace... What to do, what to do... Where to start looking..",
      "JA_current": "I guess you could say that. Most of our group has completely vanished, no trace... What to do, what to do... Where to start looking..",
      "JA_new": "まあ、そう言えるな。仲間のほとんどが跡形もなく消えた……どうすればいい？ どこから探せば……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "yuriy_hello_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
