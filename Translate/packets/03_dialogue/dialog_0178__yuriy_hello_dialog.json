      "source_xml_line": 2196,
      "string_id": "yuriy_hello_dialog_phrase_3",
      "occurrence": 1,
      "EN": "Yes, what do you want?",
      "JA_current": "Yes, what do you want?",
      "JA_new": "そうだ。何の用だ？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
