    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_2111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 941,
      "string_id": "bar_bar_osvedomitel_trade_info_2111",
      "occurrence": 1,
      "EN": "It's located by the Agroprom Research Institute, there's a stash in the underground. It probably contains information about the group's plans and a list of group members. The coordinates of the stash are attached.",
      "JA_current": "Agroprom 研究所の近くで、その情報は見付かる。地下に隠し場所があるんだ。恐らく、グループの計画やメンバーのリストに関する情報があるはずだ。隠し場所の座標を添付しておいたぞ。",
      "JA_new": "アフロプロム研究所のそばに地下の隠し場所がある。たぶん、あの一団の計画やメンバー一覧が入ってる。座標を添付しておく。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "2111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_2121#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 947,
      "string_id": "bar_bar_osvedomitel_trade_info_2121",
      "occurrence": 1,
      "EN": "Up to you. Come to the bar when you decide otherwise - I'm always here.",
      "JA_current": "アンタ次第だ。気が変わったならバーに来な ― 俺はいつでもここにいる。",
      "JA_new": "好きにしな。考えが変わったらバーに来い。俺はいつもここにいる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "2121",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_3111#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 956,
      "string_id": "bar_bar_osvedomitel_trade_info_3111",
      "occurrence": 1,
      "EN": "Strelok, Ghost and Fang went to the center of the Zone. What they found there, no one knows, but Strelok went missing while Ghost and Fang came back distraught. The latest news on Ghost is that he went to the mobile lab by Lake Yantar. Coordinates of the scientists' camp are attached.",
      "JA_current": "Strelok、Ghost それに Fang が、ゾーンの中心へと向かった。彼らがそこで何を見つけたかは、誰も知らない。だが、Strelok は、Ghost と Fang が正気に返るまでに行方不明となった。Ghost の最近の消息は、彼が Yantar 湖の近くの移動研究所へ向かったというものだ。科学者のキャンプの座標を添付しておくよ。",
      "JA_new": "ストレロク、ゴースト、ファングはゾーンの中心へ向かった。そこで何を見つけたのかは誰も知らない。ストレロクは行方不明になり、ゴーストとファングは憔悴して戻ってきた。ゴーストの最新情報によれば、ヤンター湖の移動研究所へ向かったらしい。科学者のキャンプの座標を添付しておく。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "3111",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_3121#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 962,
      "string_id": "bar_bar_osvedomitel_trade_info_3121",
      "occurrence": 1,
      "EN": "Up to you. Come to the bar when you decide otherwise - I'm always here.",
      "JA_current": "アンタ次第だ。気が変わったならバーに来な ― 俺はいつでもここにいる。",
      "JA_new": "好きにしな。考えが変わったらバーに来い。俺はいつもここにいる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
