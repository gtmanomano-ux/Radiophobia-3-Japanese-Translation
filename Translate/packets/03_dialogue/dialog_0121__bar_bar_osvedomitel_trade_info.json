      "string_id": "bar_bar_osvedomitel_trade_info_999",
      "occurrence": 1,
      "EN": "I don't have any new information at the moment.",
      "JA_current": "今のところ、新しい情報は何もないな。",
      "JA_new": "今は新しい情報がない。",
      "review_notes": null,
