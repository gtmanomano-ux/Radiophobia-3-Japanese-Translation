    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_21#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 935,
      "string_id": "bar_bar_osvedomitel_trade_info_21",
      "occurrence": 1,
      "EN": "Right now, I can sell you information about Strelok's group virtually for nothing - 4000 rubles.",
      "JA_current": "今のところ、Strelok のグループに関する情報は、ほとんどタダと言っていい位の値段で売ってやることができるよ… 4000ルーブルだ。",
      "JA_new": "今ならストレロクの一団についての情報を、ほとんどタダで売ってやる。4,000ルーブルだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_31#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 950,
      "string_id": "bar_bar_osvedomitel_trade_info_31",
      "occurrence": 1,
      "EN": "Right now, I have some information about a group that made it to the center of the Zone. I'm practically giving it away - only 2000 rubles.",
      "JA_current": "今のところ、ゾーンの中心に到達したグループに関する情報が、いくつかある。実際、タダ同然でやることになるが… たったの2000ルーブルだ。",
      "JA_new": "ゾーンの中心までたどり着いた一団の情報がある。ほとんど無料でいい。たった2,000ルーブルだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "31",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:bar_bar_osvedomitel_trade_info_41#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 965,
      "string_id": "bar_bar_osvedomitel_trade_info_41",
      "occurrence": 1,
      "EN": "I've got some information about the secret of Lake Yantar. The price is just 3500 rubles - any less and I'd be paying you!",
      "JA_current": "Yantar 湖の秘密に関する情報が手に入った。値段は3500ルーブルきっかりだ… 安いが、アンタにゃ世話になってるからな。",
      "JA_new": "ヤンター湖の秘密について情報がある。たった3,500ルーブルだ。これ以上安くしたら、こっちが金を払うことになる！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "bar_bar_osvedomitel_trade_info",
          "phrase_id": "41",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
