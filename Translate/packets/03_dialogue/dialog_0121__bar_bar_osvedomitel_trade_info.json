      "occurrence": 1,
      "EN": "I want to buy some information.",
      "JA_current": "情報を買いたいんだが。",
      "JA_new": "情報を買いたい。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
