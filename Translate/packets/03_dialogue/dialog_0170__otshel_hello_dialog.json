      "source_xml_line": 2119,
      "string_id": "otshel_hello_dialog_phrase_4",
      "occurrence": 1,
      "EN": "Me? I'm just your average stalker.",
      "JA_current": "Me? I'm just your average stalker.",
      "JA_new": "俺か？ どこにでもいる普通のストーカーだよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
