      "string_id": "otshel_hello_dialog_phrase_8",
      "occurrence": 1,
      "EN": "You got beef with some group?",
      "JA_current": "You got beef with some group?",
      "JA_new": "どこかの集団と揉めてるのか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
