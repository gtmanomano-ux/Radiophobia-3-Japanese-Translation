    },
    {
      "key": "stable_dialogs_bar:otshel_hello_dialog_phrase_5#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2122,
      "string_id": "otshel_hello_dialog_phrase_5",
      "occurrence": 1,
      "EN": "Oh yeah?? They sent you after the money, didn't they? Well, make your move, fucker!!",
      "JA_current": "Oh yeah?? They sent you after the money, didn't they? Well, make your move, fucker!!",
      "JA_new": "そうか？ 金を取りに来たんだろ？ さあ、やってみろよ、クソ野郎！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "otshel_hello_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:otshel_hello_dialog_phrase_6#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2125,
      "string_id": "otshel_hello_dialog_phrase_6",
      "occurrence": 1,
      "EN": "I'm not after any money! Calm down, bro..",
      "JA_current": "I'm not after any money! Calm down, bro..",
      "JA_new": "金なんか狙ってない！ 落ち着けよ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "otshel_hello_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_bar:otshel_hello_dialog_phrase_7#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2128,
      "string_id": "otshel_hello_dialog_phrase_7",
      "occurrence": 1,
      "EN": "For fuck's sake, sorry.. I'm so sick of this, man... Those fucking racketeers... There's all kinds of scumbags around here eager to fleece the working man...",
      "JA_current": "For fuck's sake, sorry.. I'm so sick of this, man... Those fucking racketeers... There's all kinds of scumbags around here eager to fleece the working man...",
      "JA_new": "くそっ、悪かった……もううんざりなんだよ。あのクソみたいな取り立て屋ども……働く奴から金を巻き上げようとするクズばかりだ……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "otshel_hello_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs_bar.xml"
        }
      ]
    },
