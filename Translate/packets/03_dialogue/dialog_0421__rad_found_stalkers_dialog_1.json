  "entries": [
    {
      "key": "stable_dialogs_radar:rad_found_stalkers_dialog_1_0#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 129,
      "string_id": "rad_found_stalkers_dialog_1_0",
      "occurrence": 1,
      "EN": "I found your boys. They died but here are their weapons!",
      "JA_current": "あんたの手下を見つけたよ。…死んでたがな。これが奴らの武器だ。",
      "JA_new": "部下を見つけた。死んでたが、武器は持ってきた。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_found_stalkers_dialog_1",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_found_stalkers_dialog_1_100#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 132,
      "string_id": "rad_found_stalkers_dialog_1_100",
      "occurrence": 1,
      "EN": "Thanks, they're dead then. I don't think there's any point going to Pripyat now! There's a problem though - I don't have your money. My deputy disappeared and he had all the money!",
      "JA_current": "有難う。奴ら死んでたか… 結局 Pripyatに辿り着く方法は無いのかよ！ コイツは難題だな。ああそうだ。報酬は渡せない。金庫番が俺の金持ってトンズラしやがったんでな！",
      "JA_new": "そうか、死んじまったか……もうプリピャチへ行く意味もなさそうだな。だが困ったことに、報酬を払う金がない。金を全部持った副官が姿を消した！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_found_stalkers_dialog_1",
          "phrase_id": "100",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_found_stalkers_dialog_1_1001#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 135,
      "string_id": "rad_found_stalkers_dialog_1_1001",
      "occurrence": 1,
      "EN": "OK, I'll find him! Tell me where to look for him. And don't even think about trying to cheat me out of my cash this time!!!",
      "JA_current": "わかった。探してみよう。何処に行けばそいつを見つけられるか教えてくれ。ああ、今回は俺を騙そうなんて思うなよ？",
      "JA_new": "わかった、俺が見つけてやる。どこを探せばいい？ 今回は金を払わず逃げようなんて考えるなよ！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_found_stalkers_dialog_1",
          "phrase_id": "1001",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_found_stalkers_dialog_1_200#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 138,
      "string_id": "rad_found_stalkers_dialog_1_200",
      "occurrence": 1,
      "EN": "I don't think he got very far. He's probably nearby, I'll mark it on the map for you! When you find him, bring him or his PDA back here!",
      "JA_current": "まだそう遠くには行ってない。奴は多分ここかこの辺に居ると思う。地図に印を付けておくから、奴を見つけて連れ戻すか PDA を持って帰ってきてくれ。",
      "JA_new": "まだ遠くへは行ってないはずだ。近くにいるだろう。地図に印をつけておく。見つけたら本人かPDAをここへ連れてこい！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_found_stalkers_dialog_1",
          "phrase_id": "200",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_radar:rad_found_stalkers_dialog_1_2000#1",
      "source_table": "stable_dialogs_radar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_radar.xml",
      "source_xml_line": 141,
      "string_id": "rad_found_stalkers_dialog_1_2000",
      "occurrence": 1,
      "EN": "OK, wait for me!!!",
      "JA_current": "OK、待ってろ！",
      "JA_new": "わかった。行ってくる！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "rad_found_stalkers_dialog_1",
          "phrase_id": "2000",
          "graph_source": "gamedata/config/gameplay/dialogs_radar.xml"
        }
      ]
    }
  ],
