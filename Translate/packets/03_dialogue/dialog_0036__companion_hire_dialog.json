      "source_xml_line": 50,
      "string_id": "companion_hire_dialog_1",
      "occurrence": 1,
      "EN": "Why not. I agree.",
      "JA_current": "Why not. I agree.",
      "JA_new": "いいとも。行くよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
