        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_2#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 53,
      "string_id": "companion_hire_dialog_2",
      "occurrence": 1,
      "EN": "Sorry, I've got other plans.",
      "JA_current": "Sorry, I've got other plans.",
      "JA_new": "悪い、先約があるんだ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "2",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_3#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 57,
      "string_id": "companion_hire_dialog_3",
      "occurrence": 1,
      "EN": "No, I'm afraid to go with you.",
      "JA_current": "No, I'm afraid to go with you.",
      "JA_new": "いや、あんたと行くのは怖い。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "3",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_4#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 61,
      "string_id": "companion_hire_dialog_4",
      "occurrence": 1,
      "EN": "Go to hell, Marked One, no one ever returned from your journeys. Find a fool for yourself in some other places.",
      "JA_current": "Go to hell, Marked One, no one ever returned from your journeys. Find a fool for yourself in some other places.",
      "JA_new": "ふざけるな、マークド・ワン。あんたと出かけて帰ってきた奴はいない。よそで別の馬鹿を探しな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "4",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_5#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 65,
      "string_id": "companion_hire_dialog_5",
      "occurrence": 1,
      "EN": "Sorry, I can't. Just tired of wandering about the Zone, need to get some rest.",
      "JA_current": "Sorry, I can't. Just tired of wandering about the Zone, need to get some rest.",
      "JA_new": "悪いが無理だ。ゾーンを歩き回るのにも疲れた。少し休ませてくれ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "5",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_6#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 69,
      "string_id": "companion_hire_dialog_6",
      "occurrence": 1,
      "EN": "No, man, you're too green. Sorry, but you're not able to handle it.",
      "JA_current": "No, man, you're too green. Sorry, but you're not able to handle it.",
      "JA_new": "いや、あんたじゃまだ経験不足だ。悪いが、任せられない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "6",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_7#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 73,
      "string_id": "companion_hire_dialog_7",
      "occurrence": 1,
      "EN": "No, Marked One, I'm afraid to go with you. You're exploring such places, where I won't last even an hour. Don't want to die... I'd better just hang around here for a while, just to be safe.",
      "JA_current": "No, Marked One, I'm afraid to go with you. You're exploring such places, where I won't last even an hour. Don't want to die... I'd better just hang around here for a while, just to be safe.",
      "JA_new": "いや、マークド・ワン。あんたと行くのは怖い。あんな場所じゃ、一時間も持たないよ。死にたくない……しばらくここで大人しくしてる。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "7",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_8#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 76,
      "string_id": "companion_hire_dialog_8",
      "occurrence": 1,
      "EN": "You have big company already. It's no good to wander in the Zone in crowds.",
      "JA_current": "You have big company already. It's no good to wander in the Zone in crowds.",
      "JA_new": "もう仲間が大勢いるだろ。ゾーンをぞろぞろ歩くのは得策じゃない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "8",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_9#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 79,
      "string_id": "companion_hire_dialog_9",
      "occurrence": 1,
      "EN": "Marked One, I can't have business with you while you're not one of us. No offence.",
      "JA_current": "Marked One, I can't have business with you while you're not one of us. No offence.",
      "JA_new": "マークド・ワン、あんたが俺たちの仲間じゃない以上、仕事は一緒にできない。悪く思うな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog",
          "phrase_id": "9",
          "graph_source": "gamedata/config/gameplay/dialogs.xml"
        }
      ]
    }
