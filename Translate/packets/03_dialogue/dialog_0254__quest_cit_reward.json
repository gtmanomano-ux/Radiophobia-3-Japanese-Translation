  "entries": [
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_0#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 102,
      "string_id": "quest_cit_reward_0",
      "occurrence": 1,
      "EN": "By the way, I have information about the Mercs. Interested?",
      "JA_current": "ところで、Merc についての情報があるんだが、興味あるかい？",
      "JA_new": "そうだ、マーセナリーズについて情報がある。興味はあるか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_1#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 105,
      "string_id": "quest_cit_reward_1",
      "occurrence": 1,
      "EN": "Depends on the information.",
      "JA_current": "その情報次第だな。",
      "JA_new": "どんな情報かによるな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "1",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_11#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 108,
      "string_id": "quest_cit_reward_11",
      "occurrence": 1,
      "EN": "I have a map which details the location of their base, guard posts, the way to get in without being noticed and a lot more.",
      "JA_current": "私は彼らの基地の詳細な地図、見張り場所、気付かれずに入る方法などを知っている。",
      "JA_new": "奴らの拠点や見張り所、見つからずに入り込むルートまで書いた地図を持ってる。ほかにもいろいろな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_13#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 126,
      "string_id": "quest_cit_reward_13",
      "occurrence": 1,
      "EN": "Nothing worthwhile. Just the usual gossip. Sorry.",
      "JA_current": "価値があるものは何もない。ただいつもの人たちがうわさ話をする。すまないな。",
      "JA_new": "大した情報じゃない。いつもの噂話だ。悪かったな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "13",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_111#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 111,
      "string_id": "quest_cit_reward_111",
      "occurrence": 1,
      "EN": "Sounds valuable. I'll give you 3000 for it.",
      "JA_current": "価値がありそうだな。よし、3000出そう。",
      "JA_new": "使えそうだな。3,000ルーブルで買おう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "111",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_131#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 129,
      "string_id": "quest_cit_reward_131",
      "occurrence": 1,
      "EN": "If you find out something more specific come back. I'll pay you.",
      "JA_current": "何か変わった物を発見して、持ち帰ったら、それに対価を支払おう。",
      "JA_new": "もっと具体的な情報が手に入ったら来てくれ。金は払う。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "131",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_1111#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 114,
      "string_id": "quest_cit_reward_1111",
      "occurrence": 1,
      "EN": "Deal. Here.",
      "JA_current": "取引成立。ほらよ。",
      "JA_new": "取引成立だ。ほら。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "1111",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_1112#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 120,
      "string_id": "quest_cit_reward_1112",
      "occurrence": 1,
      "EN": "Not, that's not enough.",
      "JA_current": "ダメだ、それじゃあ不十分だ。",
      "JA_new": "いや、それじゃ足りない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "1112",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_11111#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 117,
      "string_id": "quest_cit_reward_11111",
      "occurrence": 1,
      "EN": "Great! Here's your reward. Soon stalkers will argue about whether the Mercs even existed at all!",
      "JA_current": "素晴らしい！ あなたの報酬だ。まもなくストーカーが Mercs が存在したか否かに関して議論するだろう！",
      "JA_new": "よし！　約束の報酬だ。これでストーカーたちも、マーセナリーズが本当にいたのかどうか議論するだろうな！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "11111",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_deadcity:quest_cit_reward_11121#1",
      "source_table": "stable_dialogs_deadcity",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_deadcity.xml",
      "source_xml_line": 123,
      "string_id": "quest_cit_reward_11121",
      "occurrence": 1,
      "EN": "As you wish, I'm not giving you any more.",
      "JA_current": "あなたが望むようには、私はもうあなたを歓迎できない。",
      "JA_new": "好きにしろ。これ以上は払わない。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "quest_cit_reward",
          "phrase_id": "11121",
          "graph_source": "gamedata/config/gameplay/dialogs_deadcity.xml"
        }
      ]
    }
