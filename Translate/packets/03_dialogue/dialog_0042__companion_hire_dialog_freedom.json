      "source_xml_line": 282,
      "string_id": "companion_hire_dialog_freedom_7",
      "occurrence": 1,
      "EN": "No, Marked One - you're roaming such places! Don't know how you're staying alive yet.",
      "JA_current": "No, Marked One - you're roaming such places! Don't know how you're staying alive yet.",
      "JA_new": "いや、マークド・ワン。あんなところを歩き回ってるなんて、よく生きてるな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
