        }
      ]
    },
    {
      "key": "stable_dialogs:companion_hire_dialog_freedom_5#1",
      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 276,
      "string_id": "companion_hire_dialog_freedom_5",
      "occurrence": 1,
      "EN": "Sorry, I can't. Tired to wander around, need to rest, smoke some weed and relax. Got any weed? No? Pity...",
      "JA_current": "Sorry, I can't. Tired to wander around, need to rest, smoke some weed and relax. Got any weed? No? Pity...",
      "JA_new": "悪い、無理だ。歩き回るのにも疲れたよ。ちょっと休んで、草でも吸ってのんびりしたい。草ある？ ないのか……残念。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_freedom",
          "phrase_id": "5",
