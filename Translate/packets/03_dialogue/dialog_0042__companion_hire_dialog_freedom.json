      "source_table": "stable_dialogs",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs.xml",
      "source_xml_line": 273,
      "string_id": "companion_hire_dialog_freedom_4",
      "occurrence": 1,
      "EN": "Get lost, man, there were plenty of dudes with you. I didn't see a one since then.",
      "JA_current": "Get lost, man, there were plenty of dudes with you. I didn't see a one since then.",
      "JA_new": "あっち行けよ。大勢連れてったくせに、そのあと誰も見かけなかったぞ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_freedom",
