      "string_id": "companion_hire_dialog_freedom_3",
      "occurrence": 1,
      "EN": "Ya kidding?! You're no good, Marked One.",
      "JA_current": "Ya kidding?! You're no good, Marked One.",
      "JA_new": "冗談だろ？ あんたとじゃ無理だよ、マークド・ワン。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_freedom",
