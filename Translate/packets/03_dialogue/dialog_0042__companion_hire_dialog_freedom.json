      "source_xml_line": 279,
      "string_id": "companion_hire_dialog_freedom_6",
      "occurrence": 1,
      "EN": "No, man, you're like a kid. Grow bigger.",
      "JA_current": "No, man, you're like a kid. Grow bigger.",
      "JA_new": "いや、あんたはまだガキみたいなもんだ。もっと腕を上げな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "companion_hire_dialog_freedom",
