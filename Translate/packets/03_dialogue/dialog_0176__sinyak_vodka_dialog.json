    },
    {
      "key": "stable_dialogs_bar:sinyak_vodka_dialog_phrase_2#1",
      "source_table": "stable_dialogs_bar",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_bar.xml",
      "source_xml_line": 2501,
      "string_id": "sinyak_vodka_dialog_phrase_2",
      "occurrence": 1,
      "EN": "Man, help me out, I'm on the wane! They kicked me out of the bar, but I'm gettin' real thirsty. I can feel the mother of all hangovers coming, and I need the hair of the dog, fast... I don't know when they'll let me back in, so get me some vodka and I can wait out the storm in peace. I'll give you my gun, stole it from some mercenaries when I wasn't drinking... So, will you help a brother out?",
      "JA_current": "Man, help me out, I'm on the wane! They kicked me out of the bar, but I'm gettin' real thirsty. I can feel the mother of all hangovers coming, and I need the hair of the dog, fast... I don't know when they'll let me back in, so get me some vodka and I can wait out the storm in peace. I'll give you my gun, stole it from some mercenaries when I wasn't drinking... So, will you help a brother out?",
      "JA_new": "なあ、助けてくれよ。もう限界だ！ バーから追い出されたが、喉が渇いてたまらない。とんでもない二日酔いが来そうなんだ。すぐ迎え酒が要る……いつ戻れるか分からないから、ウォッカを持ってきてくれれば、嵐が過ぎるまで静かに待てる。代わりに銃をやるよ。飲んでない時にマーセナリーズから盗んだんだ……頼む、助けてくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "sinyak_vodka_dialog",
