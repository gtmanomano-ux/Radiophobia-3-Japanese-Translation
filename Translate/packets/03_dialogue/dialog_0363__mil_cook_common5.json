  "entries": [
    {
      "key": "stable_dialogs_military:mil_cook_common5_0#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 230,
      "string_id": "mil_cook_common5_0",
      "occurrence": 1,
      "EN": "Listen, would you know where I can get some equipment?",
      "JA_current": "聞きな。どこで装備を手に入れられるか知ってるかい？",
      "JA_new": "装備を手に入れたいんだが、どこに行けばいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "0",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common5_501#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 233,
      "string_id": "mil_cook_common5_501",
      "occurrence": 1,
      "EN": "Equipment? That's some code-speak to me, bro!",
      "JA_current": "装備だと？ 何かの暗号かい？ 兄弟！",
      "JA_new": "装備？俺には暗号みたいに聞こえるな、兄弟！",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "501",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common5_502#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 236,
      "string_id": "mil_cook_common5_502",
      "occurrence": 1,
      "EN": "Equipment. Weapons. Artifacts.",
      "JA_current": "装備だよ。武器やアーティファクトだ。",
      "JA_new": "装備だよ。武器とか、アーティファクトとか。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "502",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common5_503#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 239,
      "string_id": "mil_cook_common5_503",
      "occurrence": 1,
      "EN": "Weapons... no... my knife... Want my knife? No? Yeah... Artifacts. What the hell for? Take it easy. C'mon, sit. Light one up with me. Let's talk... about artifacts...",
      "JA_current": "武器か… ナイフ… 俺のナイフが欲しいのか？ 何だ違うのか？ あぁ… アーティファクトか。一体何のためにだ？ まぁ気楽に行こうぜ。座りなよ。アーティファクトについて話そうじゃないか。",
      "JA_new": "武器か……いや、俺のナイフなら……欲しいのか？違う？そうか……アーティファクトね。何のために？まあ、落ち着け。座って一服しようぜ。アーティファクトの話でもしよう……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "503",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common5_504#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 242,
      "string_id": "mil_cook_common5_504",
      "occurrence": 1,
      "EN": "Where can I find artifacts in this area?",
      "JA_current": "このエリアのどこでアーティファクトは入手できるんだ？",
      "JA_new": "この辺りでアーティファクトを見つけるには、どこへ行けばいい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "504",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_military:mil_cook_common5_505#1",
      "source_table": "stable_dialogs_military",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_military.xml",
      "source_xml_line": 245,
      "string_id": "mil_cook_common5_505",
      "occurrence": 1,
      "EN": "That's easy! Artifacts... We got artifacts up to our ears! You know the radioactive swamp? No? Doesn’t matter. It's there. I mean, the artifacts. Are there. You just stop flapping about. Take it easy. Eh? Artifacts... he-he-he... artifacts-shmartifacts...",
      "JA_current": "簡単さ！ アーティファクト… 俺たちゃ夢中になってアーティファクトを採った！ 放射能を帯びた、あの沼地を知ってるか？ 知らない？ どっちでもいい。そこにある。つまり、アーティファクトがさ。そこに、ある。お前は無駄話を、止める。無理すんな。あ？ アーティファクト… へ、へ、へ… アーティファクト、来る日も来る日アーティファクト…。",
      "JA_new": "簡単さ！アーティファクトなら……ここには山ほどある！放射能の沼地を知ってるか？知らない？まあいい。そこにあるんだ。アーティファクトがな。そこにある。そんなにうろうろするなよ。落ち着け。な？アーティファクト……へへ……アーティファクト、アーティファクト……",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "mil_cook_common5",
          "phrase_id": "505",
          "graph_source": "gamedata/config/gameplay/dialogs_military.xml"
        }
      ]
    }
  ],
