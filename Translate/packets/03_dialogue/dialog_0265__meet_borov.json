      "occurrence": 1,
      "EN": "Can you help me get in touch with the Dark Valley crew?",
      "JA_current": "Can you help me get in touch with the Dark Valley crew?",
      "JA_new": "ダークバレーの連中と連絡を取りたい。手を貸してくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
