    {
      "key": "stable_dialogs_escape:meet_borov_1#1",
      "source_table": "stable_dialogs_escape",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_escape.xml",
      "source_xml_line": 597,
      "string_id": "meet_borov_1",
      "occurrence": 1,
      "EN": "No problem. You helped me out - So I'll help you. I'm gonna need one grand to grease some palms. I'll make a deal with the family so that they know to let you through, don't take too long though or they'll just forget about it.",
      "JA_current": "No problem. You helped me out - So I'll help you. I'm gonna need one grand to grease some palms. I'll make a deal with the family so that they know to let you through, don't take too long though or they'll just forget about it.",
      "JA_new": "いいとも。助けてもらった礼だ。仲介に1,000ルーブル要る。ファミリーに話をつけて、あんたを通すよう伝えておく。あまり時間をかけるなよ。すぐに忘れられるからな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "meet_borov",
