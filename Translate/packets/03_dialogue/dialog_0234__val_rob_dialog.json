  "entries": [
    {
      "key": "stable_dialogs_darkvalley:val_rob_dialog_11#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 344,
      "string_id": "val_rob_dialog_11",
      "occurrence": 1,
      "EN": "Hey, want an awesome gun? I found a little something near Yantar... a stash, I guess. There was this Gauss rifle among other things. I tell you, this thing rocks - anyone within a hundred meters of it is as good as dead... You can have it for just 800.",
      "JA_current": "なあ、スゲェ銃が欲しくないか？ 俺は Yantar のそばでちょっとした物を見つけたんだが… お宝さ。俺はこう思うんだ、そこにその Gauss rifle があるってな。教えてやるぜ、ガチだ。こいつなら数100メートル以内の奴は死人も同然さ… たった800で手に入るぜ？",
      "JA_new": "いい銃が欲しくないか？ヤンターの近くでちょっといい物を見つけてね……隠し場所かな。そこにGauss rifleが入ってた。こいつはすごいぞ。100メートル以内にいる奴は、誰だろうと一巻の終わりだ。たった800で譲るよ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_rob_dialog",
          "phrase_id": "11",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_rob_dialog_21#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 356,
      "string_id": "val_rob_dialog_21",
      "occurrence": 1,
      "EN": "Got the money? Hurry up. I've had a lot of customers... They'll be coming back soon.",
      "JA_current": "金は手に入れたか？ 急げ、俺は沢山の客を抱えている… 奴らはすぐ戻ってくるぞ。",
      "JA_new": "金はあるか？急いでくれ。客が何人も来てるんだ……じきに戻ってくるだろう。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_rob_dialog",
          "phrase_id": "21",
          "graph_source": "gamedata/config/gameplay/dialogs_darkvalley.xml"
        }
      ]
    },
    {
      "key": "stable_dialogs_darkvalley:val_rob_dialog_111#1",
      "source_table": "stable_dialogs_darkvalley",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 347,
      "string_id": "val_rob_dialog_111",
      "occurrence": 1,
      "EN": "Here's the money.",
      "JA_current": "ほら金だ。",
      "JA_new": "ほら、金だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": [
        {
          "dialog_id": "val_rob_dialog",
          "phrase_id": "111",
