      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\stable_dialogs_darkvalley.xml",
      "source_xml_line": 353,
      "string_id": "val_rob_dialog_113",
      "occurrence": 1,
      "EN": "Nah, keep it. Money is hard to come by.",
      "JA_current": "いや、それは大事にしときな。金は手に入りにくい。",
      "JA_new": "いや、やっぱりいい。金を稼ぐのも大変だからな。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
