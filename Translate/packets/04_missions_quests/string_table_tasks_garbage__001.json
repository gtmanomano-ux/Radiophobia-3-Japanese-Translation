    {
      "key": "string_table_tasks_garbage:graveyard_raid_text#1",
      "source_table": "string_table_tasks_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_tasks_garbage.xml",
      "source_xml_line": null,
      "string_id": "graveyard_raid_text",
      "occurrence": 1,
      "EN": "Bes: \"The bandit scum is trying to gain control over the Garbage. There was a brawl here half an hour ago. We killed three of the freaks. The rest of the fellows retreated, but I have a feeling they'll be back any minute now with reinforcements. There are few of us and an extra barrel wouldn't hurt. If you help us destroy their reinforcements, then I'll return the favor.\"",
      "JA_current": "ベス「バンディットのクズどもがガーベジを乗っ取ろうとしている。30分ほど前にも戦闘になって、3人仕留めた。残りは逃げたが、すぐに増援を連れて戻ってきそうだ。こっちは人数が少ない。銃を持った助っ人が1人でもいればありがたい。奴らの増援を倒すのを手伝ってくれたら、必ず礼はする」",
      "JA_new": "ベス「バンディットのクズどもがガーベジを乗っ取ろうとしている。30分ほど前にも戦闘になって、3人仕留めた。残りは逃げたが、すぐに増援を連れて戻ってきそうだ。こっちは人数が少ない。銃を持った助っ人が1人でもいればありがたい。奴らの増援を倒すのを手伝ってくれたら、必ず礼はする」",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "string_table_tasks_garbage:help_for_neitrals_text#1",
      "source_table": "string_table_tasks_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_tasks_garbage.xml",
      "source_xml_line": null,
      "string_id": "help_for_neitrals_text",
      "occurrence": 1,
      "EN": "There's been a shootout at the abandoned vehicle graveyard between neutral forces and bandits. The neutrals managed to fight the bandits off but are calling for help.",
      "JA_current": "廃車置き場でローナーとバンディットの銃撃戦が起きた。ローナーはバンディットを撃退したものの、援軍を求めている。",
      "JA_new": "廃車置き場でローナーとバンディットの銃撃戦が起きた。ローナーはバンディットを撃退したものの、援軍を求めている。",
