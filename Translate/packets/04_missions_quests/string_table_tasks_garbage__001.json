    {
      "key": "string_table_tasks_garbage:gar_kill_boars_descr#1",
      "source_table": "string_table_tasks_garbage",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_tasks_garbage.xml",
      "source_xml_line": null,
      "string_id": "gar_kill_boars_descr",
      "occurrence": 1,
      "EN": "Duty: \"Hello, the Duty faction is speaking from the Garbage. There's a wave of mutants going from the Dark Valley towards the bar. We guarantee our gratitude to all who will help kill off the scum. On the word of the Duty.\"",
      "JA_current": "デューティー「こちらガーベジのデューティーだ。ダークバレーからロストクへ向かうミュータントの群れを確認した。駆除に協力してくれる者には、相応の礼を約束する。デューティーの名にかけて」",
      "JA_new": "デューティー「こちらガーベジのデューティーだ。ダークバレーからロストクへ向かうミュータントの群れを確認した。駆除に協力してくれる者には、相応の礼を約束する。デューティーの名にかけて」",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
