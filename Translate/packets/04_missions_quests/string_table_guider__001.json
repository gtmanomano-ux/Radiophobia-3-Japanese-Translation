    {
      "key": "string_table_guider:guider_dialog_phr_pilot_0#1",
      "source_table": "string_table_guider",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_guider.xml",
      "source_xml_line": 20,
      "string_id": "guider_dialog_phr_pilot_0",
      "occurrence": 1,
      "EN": "Listen, you're a pilot, right? Can you drop me somewhere with your chopper?",
      "JA_current": "Listen, you're a pilot, right? Can you drop me somewhere with your chopper?",
      "JA_new": "なあ、あんたパイロットだよな？ ヘリでどこかまで送ってくれないか？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "string_table_guider:guider_dialog_phr_1#1",
      "source_table": "string_table_guider",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_guider.xml",
      "source_xml_line": 23,
      "string_id": "guider_dialog_phr_1",
      "occurrence": 1,
      "EN": "Nope.",
      "JA_current": "Nope.",
      "JA_new": "無理だ。",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "string_table_guider:guider_dialog_phr_2#1",
      "source_table": "string_table_guider",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_guider.xml",
      "source_xml_line": 26,
      "string_id": "guider_dialog_phr_2",
      "occurrence": 1,
      "EN": "Yes, I can. But keep in mind that I guide only if I know a safe path. And it isn't free for strangers. Where do you want to go?",
      "JA_current": "Yes, I can. But keep in mind that I guide only if I know a safe path. And it isn't free for strangers. Where do you want to go?",
      "JA_new": "できる。だが、安全な道を知っている場所にしか案内しない。それに、よそ者はタダじゃ乗せられない。どこへ行きたい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
    {
      "key": "string_table_guider:guider_dialog_phr_pilot_2#1",
      "source_table": "string_table_guider",
      "source_file": "F:\\Games\\Radiophobia 3\\gamedata\\config\\text\\jpn\\string_table_guider.xml",
      "source_xml_line": 29,
      "string_id": "guider_dialog_phr_pilot_2",
      "occurrence": 1,
      "EN": "Generally, yes. You helped us a lot, so I have a clearance to help you back. I can drop you in many places that are more or less safe. And it isn't free of course. Where you want to go?",
      "JA_current": "Generally, yes. You helped us a lot, so I have a clearance to help you back. I can drop you in many places that are more or less safe. And it isn't free of course. Where you want to go?",
      "JA_new": "まあな。あんたにはいろいろ助けてもらった。今度は俺が力になれる。比較的安全な場所なら、いくつか送ってやれるぞ。もちろんタダじゃない。どこへ行きたい？",
      "review_notes": null,
      "english_reference_status": "same_table_and_id_occurrence",
      "review_flags": [],
      "graph_uses": []
    },
